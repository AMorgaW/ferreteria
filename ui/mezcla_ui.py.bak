# -*- coding: utf-8 -*-
"""
Ventana Modal de Mezcla de Pinturas
Permite crear mezclas personalizadas seleccionando pinturas base y proporciones
"""
import tkinter as tk
from tkinter import ttk, messagebox
from ui_config_modern import COLORS_MODERN as COLORS, FONTS_MODERN as FONTS


class VentanaMezclaPintura(tk.Toplevel):
    """Modal para crear una mezcla de pintura personalizada"""

    def __init__(self, parent, mezclas_service, productos_repo, db_manager):
        super().__init__(parent)
        self.mezclas_service = mezclas_service
        self.productos_repo = productos_repo
        self.db_manager = db_manager

        # Resultado: se llena al confirmar
        self.resultado = None  # {'nombre': str, 'precio': float, 'componentes': [...], 'formula_id': int|None}

        # Componentes de la mezcla actual
        self.componentes = []  # [{'producto': dict, 'cantidad': float, 'unidad': str}]

        # Configurar ventana
        self.title("Nueva Mezcla de Pintura")
        self.geometry("950x700")
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()
        self.configure(bg=COLORS['bg_main'])

        # Centrar
        self.update_idletasks()
        x = (self.winfo_screenwidth() // 2) - 475
        y = (self.winfo_screenheight() // 2) - 350
        self.geometry(f"+{x}+{y}")

        self.crear_ui()
        self.cargar_pinturas()

    def crear_ui(self):
        """Crea la interfaz completa del modal"""
        # === HEADER ===
        header = tk.Frame(self, bg=COLORS['primary'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)

        tk.Label(header, text="Mezcla de Pintura Personalizada",
                font=('Segoe UI', 18, 'bold'),
                bg=COLORS['primary'], fg='white').pack(side='left', padx=20, pady=10)

        tk.Button(header, text="X", font=('Segoe UI', 12, 'bold'),
                 bg=COLORS['danger'], fg='white', relief='flat',
                 cursor='hand2', width=3,
                 command=self.destroy).pack(side='right', padx=10, pady=10)

        # === CUERPO PRINCIPAL (2 columnas) ===
        body = tk.Frame(self, bg=COLORS['bg_main'])
        body.pack(fill='both', expand=True, padx=15, pady=10)

        # COLUMNA IZQUIERDA - Buscador de pinturas
        left = tk.Frame(body, bg=COLORS['bg_card'], width=440, relief='flat')
        left.pack(side='left', fill='both', padx=(0, 8))
        left.pack_propagate(False)

        self._crear_panel_busqueda(left)

        # COLUMNA DERECHA - Mezcla actual
        right = tk.Frame(body, bg=COLORS['bg_card'], width=460, relief='flat')
        right.pack(side='right', fill='both', padx=(8, 0))
        right.pack_propagate(False)

        self._crear_panel_mezcla(right)

        # === FOOTER - Botones de accion ===
        footer = tk.Frame(self, bg=COLORS['bg_main'], height=60)
        footer.pack(fill='x', padx=15, pady=(0, 10))
        footer.pack_propagate(False)

        self._crear_footer(footer)

    def _crear_panel_busqueda(self, parent):
        """Panel izquierdo: buscador de pinturas base"""
        # Titulo
        tk.Label(parent, text="Seleccionar Pinturas Base",
                font=('Segoe UI', 14, 'bold'),
                bg=COLORS['bg_card'], fg=COLORS['text_primary']
                ).pack(anchor='w', padx=15, pady=(15, 5))

        # Busqueda
        search_frame = tk.Frame(parent, bg=COLORS['bg_card'])
        search_frame.pack(fill='x', padx=15, pady=5)

        self.search_var = tk.StringVar()
        self.search_var.trace('w', lambda *a: self._filtrar_pinturas())

        tk.Entry(search_frame, textvariable=self.search_var,
                font=FONTS['body'], relief='solid', borderwidth=1
                ).pack(fill='x', ipady=6)

        tk.Label(search_frame, text="Buscar por nombre o marca...",
                font=FONTS['small'], bg=COLORS['bg_card'],
                fg=COLORS['text_light']).pack(anchor='w', pady=(2, 0))

        # Tabla de pinturas disponibles
        table_frame = tk.Frame(parent, bg=COLORS['bg_card'])
        table_frame.pack(fill='both', expand=True, padx=15, pady=5)

        scroll_y = ttk.Scrollbar(table_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')

        cols = ('Nombre', 'Marca', 'Precio', 'Stock')
        self.tree_pinturas = ttk.Treeview(table_frame, columns=cols,
                                          show='headings', height=12,
                                          yscrollcommand=scroll_y.set)
        scroll_y.config(command=self.tree_pinturas.yview)

        self.tree_pinturas.heading('Nombre', text='Nombre')
        self.tree_pinturas.heading('Marca', text='Marca')
        self.tree_pinturas.heading('Precio', text='Precio')
        self.tree_pinturas.heading('Stock', text='Stock')

        self.tree_pinturas.column('Nombre', width=160)
        self.tree_pinturas.column('Marca', width=80)
        self.tree_pinturas.column('Precio', width=80)
        self.tree_pinturas.column('Stock', width=60)

        self.tree_pinturas.pack(fill='both', expand=True)

        # Botones + Cantidad
        add_frame = tk.Frame(parent, bg=COLORS['bg_card'])
        add_frame.pack(fill='x', padx=15, pady=(5, 10))

        tk.Label(add_frame, text="Cantidad:",
                font=FONTS['body'], bg=COLORS['bg_card']).pack(side='left')

        self.cantidad_var = tk.StringVar(value="1.000")
        tk.Entry(add_frame, textvariable=self.cantidad_var,
                font=FONTS['body'], width=10, relief='solid',
                borderwidth=1, justify='center').pack(side='left', padx=5, ipady=4)

        # Unidad
        self.unidad_var = tk.StringVar(value="L")
        combo_unidad = ttk.Combobox(add_frame, textvariable=self.unidad_var,
                                     values=['L', 'ml', 'Galon', '1/2 Galon', '1/4 Galon'],
                                     font=FONTS['small'], width=10, state='readonly')
        combo_unidad.pack(side='left', padx=5)

        tk.Button(add_frame, text="Agregar a Mezcla",
                 font=FONTS['body_bold'],
                 bg=COLORS['primary'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self._agregar_componente
                 ).pack(side='right', ipady=4, ipadx=10)

        # Cargar formulas guardadas
        formulas_frame = tk.Frame(parent, bg=COLORS['bg_card'])
        formulas_frame.pack(fill='x', padx=15, pady=(0, 10))

        tk.Button(formulas_frame, text="Cargar Formula Guardada",
                 font=FONTS['small'],
                 bg=COLORS['accent'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self._abrir_formulas_guardadas
                 ).pack(fill='x', ipady=4)

    def _crear_panel_mezcla(self, parent):
        """Panel derecho: composicion de la mezcla"""
        # Titulo
        tk.Label(parent, text="Composicion de la Mezcla",
                font=('Segoe UI', 14, 'bold'),
                bg=COLORS['bg_card'], fg=COLORS['text_primary']
                ).pack(anchor='w', padx=15, pady=(15, 5))

        # Nombre de la mezcla
        nombre_frame = tk.Frame(parent, bg=COLORS['bg_card'])
        nombre_frame.pack(fill='x', padx=15, pady=5)

        tk.Label(nombre_frame, text="Nombre de la mezcla:",
                font=FONTS['body'], bg=COLORS['bg_card']).pack(anchor='w')

        self.nombre_mezcla_var = tk.StringVar()
        tk.Entry(nombre_frame, textvariable=self.nombre_mezcla_var,
                font=FONTS['body'], relief='solid', borderwidth=1
                ).pack(fill='x', ipady=5)

        tk.Label(nombre_frame, text='Ej: "Verde Menta - Casa Sra. Maria"',
                font=FONTS['small'], bg=COLORS['bg_card'],
                fg=COLORS['text_light']).pack(anchor='w', pady=(2, 0))

        # Tabla de componentes
        comp_frame = tk.Frame(parent, bg=COLORS['bg_card'])
        comp_frame.pack(fill='both', expand=True, padx=15, pady=5)

        scroll_y = ttk.Scrollbar(comp_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')

        cols_comp = ('Pintura', 'Cantidad', 'Unidad', 'Costo')
        self.tree_componentes = ttk.Treeview(comp_frame, columns=cols_comp,
                                              show='headings', height=8,
                                              yscrollcommand=scroll_y.set)
        scroll_y.config(command=self.tree_componentes.yview)

        self.tree_componentes.heading('Pintura', text='Pintura')
        self.tree_componentes.heading('Cantidad', text='Cantidad')
        self.tree_componentes.heading('Unidad', text='Unidad')
        self.tree_componentes.heading('Costo', text='Costo')

        self.tree_componentes.column('Pintura', width=170)
        self.tree_componentes.column('Cantidad', width=80)
        self.tree_componentes.column('Unidad', width=70)
        self.tree_componentes.column('Costo', width=90)

        self.tree_componentes.pack(fill='both', expand=True)

        # Boton quitar
        tk.Button(comp_frame, text="Quitar Seleccionado",
                 font=FONTS['small'],
                 bg=COLORS['danger'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self._quitar_componente
                 ).pack(anchor='e', pady=(5, 0), ipady=3, ipadx=8)

        # Resumen de costos
        resumen_frame = tk.Frame(parent, bg=COLORS['bg_secondary'], relief='flat')
        resumen_frame.pack(fill='x', padx=15, pady=(5, 10))

        resumen_inner = tk.Frame(resumen_frame, bg=COLORS['bg_secondary'], padx=10, pady=8)
        resumen_inner.pack(fill='x')

        # Volumen total
        row_vol = tk.Frame(resumen_inner, bg=COLORS['bg_secondary'])
        row_vol.pack(fill='x', pady=2)

        tk.Label(row_vol, text="Volumen Total:",
                font=FONTS['body'], bg=COLORS['bg_secondary']).pack(side='left')
        self.lbl_volumen = tk.Label(row_vol, text="0.000 L",
                                     font=FONTS['body_bold'],
                                     bg=COLORS['bg_secondary'],
                                     fg=COLORS['info'])
        self.lbl_volumen.pack(side='right')

        # Costo calculado
        row_costo = tk.Frame(resumen_inner, bg=COLORS['bg_secondary'])
        row_costo.pack(fill='x', pady=2)

        tk.Label(row_costo, text="Costo Componentes:",
                font=FONTS['body'], bg=COLORS['bg_secondary']).pack(side='left')
        self.lbl_costo = tk.Label(row_costo, text="$0",
                                   font=FONTS['body_bold'],
                                   bg=COLORS['bg_secondary'],
                                   fg=COLORS['text_primary'])
        self.lbl_costo.pack(side='right')

        # Precio de venta editable
        row_precio = tk.Frame(resumen_inner, bg=COLORS['bg_secondary'])
        row_precio.pack(fill='x', pady=2)

        tk.Label(row_precio, text="Precio de Venta:",
                font=FONTS['body_bold'], bg=COLORS['bg_secondary'],
                fg=COLORS['primary']).pack(side='left')

        self.precio_venta_var = tk.StringVar(value="0")
        tk.Entry(row_precio, textvariable=self.precio_venta_var,
                font=FONTS['body_bold'], width=12, justify='right',
                relief='solid', borderwidth=1).pack(side='right', ipady=3)

    def _crear_footer(self, parent):
        """Footer con botones de accion"""
        # Checkbox guardar formula
        self.guardar_formula_var = tk.BooleanVar(value=False)
        tk.Checkbutton(parent, text="Guardar como formula reutilizable",
                       variable=self.guardar_formula_var,
                       font=FONTS['body'], bg=COLORS['bg_main'],
                       fg=COLORS['text_primary'],
                       activebackground=COLORS['bg_main']
                       ).pack(side='left', padx=10, pady=10)

        # Boton cancelar
        tk.Button(parent, text="Cancelar",
                 font=FONTS['body_bold'],
                 bg=COLORS['text_secondary'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.destroy
                 ).pack(side='right', padx=5, ipady=6, ipadx=20)

        # Boton confirmar
        tk.Button(parent, text="Agregar Mezcla al Carrito",
                 font=FONTS['body_bold'],
                 bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self._confirmar_mezcla
                 ).pack(side='right', padx=5, ipady=6, ipadx=20)

    # ====================================
    # LOGICA
    # ====================================

    def cargar_pinturas(self):
        """Carga solo los productos de la categoria Pinturas"""
        try:
            todos = self.productos_repo.listar_productos(solo_activos=True)
            # Filtrar solo productos con categoria "Pinturas"
            self.pinturas_data = [
                p for p in todos
                if (p.get('categoria') or '').lower() == 'pinturas'
            ]

            self._mostrar_pinturas(self.pinturas_data)
        except Exception as e:
            print(f"[ERROR] Error cargando pinturas: {e}")

    def _mostrar_pinturas(self, pinturas):
        """Muestra pinturas en la tabla"""
        for item in self.tree_pinturas.get_children():
            self.tree_pinturas.delete(item)

        for p in pinturas:
            stock = p.get('stock', 0)
            tag = 'sin_stock' if stock <= 0 else 'normal'
            self.tree_pinturas.insert('', 'end', values=(
                p.get('nombre', '')[:30],
                (p.get('marca') or '')[:15],
                f"${p.get('precio_venta', 0):,.0f}",
                f"{stock:.3f}" if isinstance(stock, float) else str(stock)
            ), tags=(str(p.get('id')), tag))

    def _filtrar_pinturas(self):
        """Filtra pinturas por texto de busqueda"""
        termino = self.search_var.get().lower()
        if not termino:
            self._mostrar_pinturas(self.pinturas_data)
            return

        filtradas = [p for p in self.pinturas_data
                     if termino in (p.get('nombre', '') or '').lower()
                     or termino in (p.get('marca', '') or '').lower()]
        self._mostrar_pinturas(filtradas)

    def _agregar_componente(self):
        """Agrega la pintura seleccionada como componente de la mezcla"""
        seleccion = self.tree_pinturas.selection()
        if not seleccion:
            messagebox.showwarning("Advertencia", "Seleccione una pintura de la lista",
                                   parent=self)
            return

        # Obtener producto
        item = self.tree_pinturas.item(seleccion[0])
        producto_id = int(item['tags'][0])
        producto = self.productos_repo.obtener_por_id(producto_id)

        if not producto:
            messagebox.showerror("Error", "Producto no encontrado", parent=self)
            return

        # Validar cantidad
        try:
            cantidad = float(self.cantidad_var.get().replace(',', '.'))
            if cantidad <= 0:
                raise ValueError
        except ValueError:
            messagebox.showwarning("Advertencia",
                                   "Ingrese una cantidad valida (mayor a 0)",
                                   parent=self)
            return

        # Convertir a litros (para mostrar en receta) y a galones (para stock y costo)
        unidad = self.unidad_var.get()
        cantidad_litros = self._convertir_a_litros(cantidad, unidad)
        cantidad_galones = self._convertir_a_galones(cantidad, unidad)

        # Verificar stock (stock esta en galones)
        stock_actual = producto.get('stock', 0)
        # Sumar lo que ya se tiene en la mezcla para este producto
        ya_agregado = sum(c['cantidad_galones'] for c in self.componentes
                         if c['producto']['id'] == producto_id)

        if stock_actual < (ya_agregado + cantidad_galones):
            messagebox.showwarning("Stock insuficiente",
                                   f"Stock disponible: {stock_actual:.3f} gal\n"
                                   f"Ya en mezcla: {ya_agregado:.3f} gal\n"
                                   f"Intentando agregar: {cantidad_galones:.3f} gal",
                                   parent=self)
            return

        # Agregar componente (costo proporcional al galon)
        self.componentes.append({
            'producto': producto,
            'cantidad': cantidad,
            'cantidad_litros': cantidad_litros,
            'cantidad_galones': cantidad_galones,
            'unidad': unidad,
            'costo': producto.get('precio_venta', 0) * cantidad_galones
        })

        self._actualizar_tabla_componentes()
        self._actualizar_resumen()

    def _convertir_a_litros(self, cantidad, unidad):
        """Convierte la cantidad a litros segun la unidad"""
        conversiones = {
            'L': 1.0,
            'ml': 0.001,
            'Galon': 3.785,
            '1/2 Galon': 1.8925,
            '1/4 Galon': 0.946
        }
        factor = conversiones.get(unidad, 1.0)
        return cantidad * factor

    def _convertir_a_galones(self, cantidad, unidad):
        """Convierte la cantidad a galones (unidad de stock del producto)"""
        # 1 galon = 3.785 litros
        conversiones_a_galon = {
            'Galon': 1.0,
            '1/2 Galon': 0.5,
            '1/4 Galon': 0.25,
            'L': 1.0 / 3.785,
            'ml': 1.0 / 3785.0,
        }
        factor = conversiones_a_galon.get(unidad, 1.0 / 3.785)
        return cantidad * factor

    def _quitar_componente(self):
        """Quita el componente seleccionado"""
        seleccion = self.tree_componentes.selection()
        if not seleccion:
            messagebox.showwarning("Advertencia",
                                   "Seleccione un componente para quitar",
                                   parent=self)
            return

        item = self.tree_componentes.item(seleccion[0])
        idx = int(item['tags'][0])

        if 0 <= idx < len(self.componentes):
            del self.componentes[idx]
            self._actualizar_tabla_componentes()
            self._actualizar_resumen()

    def _actualizar_tabla_componentes(self):
        """Actualiza la tabla de componentes de la mezcla"""
        for item in self.tree_componentes.get_children():
            self.tree_componentes.delete(item)

        for idx, comp in enumerate(self.componentes):
            nombre = comp['producto'].get('nombre', '')[:25]
            self.tree_componentes.insert('', 'end', values=(
                nombre,
                f"{comp['cantidad']:.3f}",
                comp['unidad'],
                f"${comp['costo']:,.0f}"
            ), tags=(str(idx),))

    def _actualizar_resumen(self):
        """Actualiza el resumen de volumen y costo"""
        volumen_total = sum(c['cantidad_litros'] for c in self.componentes)
        costo_total = sum(c['costo'] for c in self.componentes)

        self.lbl_volumen.config(text=f"{volumen_total:.3f} L")
        self.lbl_costo.config(text=f"${costo_total:,.0f}")

        # Sugerir precio de venta si esta en 0
        if self.precio_venta_var.get() == "0":
            self.precio_venta_var.set(f"{costo_total:.0f}")

    def _confirmar_mezcla(self):
        """Valida y confirma la mezcla para agregarla al carrito"""
        if not self.componentes:
            messagebox.showwarning("Advertencia",
                                   "Agregue al menos una pintura a la mezcla",
                                   parent=self)
            return

        # Validar precio
        try:
            precio_venta = float(self.precio_venta_var.get().replace(',', '.').replace('$', ''))
            if precio_venta <= 0:
                messagebox.showwarning("Advertencia",
                                       "Ingrese un precio de venta valido",
                                       parent=self)
                return
        except ValueError:
            messagebox.showwarning("Advertencia",
                                   "El precio de venta no es valido",
                                   parent=self)
            return

        nombre = self.nombre_mezcla_var.get().strip()
        if not nombre:
            nombre = "Mezcla Personalizada"

        # Validar stock de todos los componentes (en galones = unidad de stock)
        componentes_para_stock = []
        for comp in self.componentes:
            componentes_para_stock.append({
                'producto_id': comp['producto']['id'],
                'cantidad': comp['cantidad_galones']
            })

        valido, msg = self.mezclas_service.validar_stock_componentes(componentes_para_stock)
        if not valido:
            messagebox.showerror("Stock insuficiente", msg, parent=self)
            return

        # Guardar formula si se solicito
        formula_id = None
        if self.guardar_formula_var.get():
            comps_formula = [{'producto_id': c['producto']['id'],
                              'cantidad': c['cantidad_galones'],
                              'unidad': 'GAL'} for c in self.componentes]
            exito, msg_f, fid = self.mezclas_service.guardar_formula(
                nombre=nombre,
                componentes=comps_formula,
                precio_venta=precio_venta,
                cliente_referencia=nombre
            )
            if exito:
                formula_id = fid

        # Preparar resultado
        volumen_total = sum(c['cantidad_litros'] for c in self.componentes)

        self.resultado = {
            'nombre': f"Mezcla: {nombre} ({volumen_total:.2f}L)",
            'precio_venta': precio_venta,
            'volumen_total': volumen_total,
            'formula_id': formula_id,
            'componentes': [
                {
                    'producto_id': c['producto']['id'],
                    'producto_nombre': c['producto'].get('nombre', ''),
                    'cantidad': c['cantidad_galones'],  # En galones para descontar stock
                    'cantidad_litros': c['cantidad_litros'],  # En litros para mostrar
                    'unidad': 'GAL',
                    'costo': c['costo']
                } for c in self.componentes
            ]
        }

        self.destroy()

    def _abrir_formulas_guardadas(self):
        """Abre ventana de formulas guardadas"""
        formulas = self.mezclas_service.obtener_formulas()

        if not formulas:
            messagebox.showinfo("Sin formulas",
                                "No hay formulas guardadas aun.\n"
                                "Crea una mezcla y marca 'Guardar como formula'.",
                                parent=self)
            return

        # Ventana de seleccion de formula
        ventana = tk.Toplevel(self)
        ventana.title("Formulas Guardadas")
        ventana.geometry("600x400")
        ventana.resizable(False, False)
        ventana.transient(self)
        ventana.grab_set()
        ventana.configure(bg=COLORS['bg_main'])

        # Centrar
        ventana.update_idletasks()
        x = (ventana.winfo_screenwidth() // 2) - 300
        y = (ventana.winfo_screenheight() // 2) - 200
        ventana.geometry(f"+{x}+{y}")

        # Header
        tk.Label(ventana, text="Formulas de Mezcla Guardadas",
                font=('Segoe UI', 14, 'bold'),
                bg=COLORS['bg_main'], fg=COLORS['text_primary']
                ).pack(pady=15)

        # Tabla
        table_frame = tk.Frame(ventana, bg=COLORS['bg_main'])
        table_frame.pack(fill='both', expand=True, padx=20)

        scroll = ttk.Scrollbar(table_frame, orient='vertical')
        scroll.pack(side='right', fill='y')

        cols = ('Nombre', 'Volumen', 'Precio', 'Fecha')
        tree = ttk.Treeview(table_frame, columns=cols, show='headings',
                            height=10, yscrollcommand=scroll.set)
        scroll.config(command=tree.yview)

        tree.heading('Nombre', text='Nombre')
        tree.heading('Volumen', text='Volumen (L)')
        tree.heading('Precio', text='Precio')
        tree.heading('Fecha', text='Fecha')

        tree.column('Nombre', width=200)
        tree.column('Volumen', width=100)
        tree.column('Precio', width=100)
        tree.column('Fecha', width=150)

        for f in formulas:
            tree.insert('', 'end', values=(
                f.get('nombre', ''),
                f"{f.get('volumen_total', 0):.3f}",
                f"${f.get('precio_venta', 0):,.0f}",
                str(f.get('fecha_creacion', ''))[:16]
            ), tags=(str(f.get('id')),))

        tree.pack(fill='both', expand=True)

        # Botones
        btn_frame = tk.Frame(ventana, bg=COLORS['bg_main'])
        btn_frame.pack(fill='x', padx=20, pady=15)

        def cargar_seleccionada():
            sel = tree.selection()
            if not sel:
                messagebox.showwarning("Advertencia",
                                       "Seleccione una formula",
                                       parent=ventana)
                return

            formula_id = int(tree.item(sel[0])['tags'][0])
            self._cargar_formula(formula_id)
            ventana.destroy()

        def eliminar_seleccionada():
            sel = tree.selection()
            if not sel:
                return
            formula_id = int(tree.item(sel[0])['tags'][0])
            if messagebox.askyesno("Confirmar",
                                    "Eliminar esta formula?",
                                    parent=ventana):
                self.mezclas_service.eliminar_formula(formula_id)
                tree.delete(sel[0])

        tk.Button(btn_frame, text="Cargar Formula",
                 font=FONTS['body_bold'],
                 bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat',
                 command=cargar_seleccionada
                 ).pack(side='left', ipady=5, ipadx=15)

        tk.Button(btn_frame, text="Eliminar",
                 font=FONTS['body'],
                 bg=COLORS['danger'], fg='white',
                 cursor='hand2', relief='flat',
                 command=eliminar_seleccionada
                 ).pack(side='left', padx=10, ipady=5, ipadx=10)

        tk.Button(btn_frame, text="Cerrar",
                 font=FONTS['body'],
                 bg=COLORS['text_secondary'], fg='white',
                 cursor='hand2', relief='flat',
                 command=ventana.destroy
                 ).pack(side='right', ipady=5, ipadx=15)

    def _cargar_formula(self, formula_id):
        """Carga una formula guardada en la mezcla actual"""
        formula = self.mezclas_service.obtener_formula_detalle(formula_id)
        if not formula:
            messagebox.showerror("Error", "No se pudo cargar la formula",
                                 parent=self)
            return

        # Limpiar mezcla actual
        self.componentes = []

        # Cargar nombre y precio
        self.nombre_mezcla_var.set(formula.get('nombre', ''))
        self.precio_venta_var.set(str(int(formula.get('precio_venta', 0))))

        # Cargar componentes (las formulas ahora guardan en galones)
        for comp in formula.get('componentes', []):
            producto = self.productos_repo.obtener_por_id(comp['producto_id'])
            if producto:
                cantidad_galones = comp.get('cantidad', 0)
                cantidad_litros = cantidad_galones * 3.785
                self.componentes.append({
                    'producto': producto,
                    'cantidad': cantidad_galones,
                    'cantidad_litros': cantidad_litros,
                    'cantidad_galones': cantidad_galones,
                    'unidad': 'Galon',
                    'costo': producto.get('precio_venta', 0) * cantidad_galones
                })

        self._actualizar_tabla_componentes()
        self._actualizar_resumen()
