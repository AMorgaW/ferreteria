# -*- coding: utf-8 -*-
"""
Interfaz de Usuario para Reportes y Estadísticas
"""
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import datetime, timedelta
try:
    from tkcalendar import DateEntry
    HAS_CALENDAR = True
except ImportError:
    HAS_CALENDAR = False
from ui_config import COLORS, FONTS, ICONS


class ReportesUI:
    """Interfaz para reportes y estadísticas"""
    
    def __init__(self, parent_frame, reportes_service, auth_manager, 
                 reportes_compras_service=None, proveedores_repo=None, productos_repo=None):
        self.parent = parent_frame
        self.reportes_service = reportes_service
        self.auth = auth_manager
        
        self.reportes_compras_service = reportes_compras_service
        self.proveedores_repo = proveedores_repo
        self.productos_repo = productos_repo
        
        self.crear_interfaz()
    
    def crear_interfaz(self):
        """Crea la interfaz principal"""
        main_frame = tk.Frame(self.parent, bg=COLORS['bg_secondary'])
        main_frame.pack(fill='both', expand=True)
        
        # Header
        header = tk.Frame(main_frame, bg=COLORS['bg_secondary'])
        header.pack(fill='x', padx=20, pady=10)
        
        tk.Label(header, text=f"{ICONS['reportes']} Reportes y Estadísticas",
                font=FONTS['large'], bg=COLORS['bg_secondary'],
                fg=COLORS['text_primary']).pack(side='left')
        
        # Menú de reportes
        menu_frame = tk.Frame(main_frame, bg='white', relief='solid', borderwidth=1)
        menu_frame.pack(fill='both', expand=True, padx=20, pady=10)
        
        tk.Label(menu_frame, text="Seleccione un reporte",
                font=FONTS['heading'], bg='white').pack(pady=15)
        
        # Grid de botones de reportes
        btns_grid = tk.Frame(menu_frame, bg='white')
        btns_grid.pack(fill='both', expand=True, padx=30, pady=20)
        
        reportes = [
            # --- Conservados ---
            ("📊 Ventas por Período", self.reporte_ventas_periodo, COLORS['primary']),
            ("💰 Productos Más Vendidos", self.reporte_top_productos, COLORS['success']),
            ("💳 Ventas por Método de Pago", self.reporte_metodos_pago, COLORS['info']),
            ("📈 Estadísticas Generales", self.reporte_estadisticas, COLORS['primary']),
            # --- Nuevos ---
            ("📊 Comparativa de Períodos", self.reporte_comparativa, COLORS['warning']),
            ("💹 Reporte de Rentabilidad", self.reporte_rentabilidad, COLORS['success']),
            ("📋 Cuentas por Cobrar", self.reporte_cuentas_cobrar, '#8b5cf6'),
            ("🔄 Rotación de Inventario", self.reporte_rotacion, COLORS['danger']),
            ("💵 Flujo de Caja", self.reporte_flujo_caja, '#0891b2'),
        ]
        
        row = 0
        col = 0
        for texto, comando, color in reportes:
            btn = tk.Button(btns_grid, text=texto,
                           font=FONTS['body'], bg=color, fg='white',
                           cursor='hand2', relief='flat', padx=20, pady=15,
                           command=comando, width=25)
            btn.grid(row=row, column=col, padx=10, pady=10, sticky='ew')
            
            # Hover effects
            btn.bind('<Enter>', lambda e, b=btn, c=color: b.configure(bg=self._oscurecer(c)))
            btn.bind('<Leave>', lambda e, b=btn, c=color: b.configure(bg=c))
            
            col += 1
            if col > 1:
                col = 0
                row += 1
        
        btns_grid.columnconfigure(0, weight=1)
        btns_grid.columnconfigure(1, weight=1)

    def _oscurecer(self, hex_color):
        """Oscurece un color hex para efecto hover"""
        try:
            r = max(0, int(hex_color[1:3], 16) - 25)
            g = max(0, int(hex_color[3:5], 16) - 25)
            b = max(0, int(hex_color[5:7], 16) - 25)
            return f'#{r:02x}{g:02x}{b:02x}'
        except Exception:
            return hex_color

    # ==================== REPORTES CONSERVADOS ====================

    def reporte_ventas_periodo(self):
        """Ventas por período con UI profesional"""
        VentanaVentasPeriodo(self.parent, self.reportes_service)
    
    def reporte_top_productos(self):
        """Productos más vendidos - ventana profesional"""
        VentanaTopProductos(self.parent, self.reportes_service)
    
    def reporte_metodos_pago(self):
        """Ventas por método de pago - ventana profesional"""
        VentanaMetodosPago(self.parent, self.reportes_service)
    
    def reporte_estadisticas(self):
        """Estadísticas generales"""
        VentanaEstadisticasDashboard(self.parent, self.reportes_service)

    # ==================== NUEVOS REPORTES ====================

    def reporte_comparativa(self):
        """Comparativa entre dos períodos"""
        VentanaComparativa(self.parent, self.reportes_service)

    def reporte_rentabilidad(self):
        """Reporte de rentabilidad"""
        VentanaRentabilidadDashboard(
            self.parent, self.reportes_service
        )

    def reporte_cuentas_cobrar(self):
        """Cuentas por cobrar pendientes"""
        VentanaCuentasCobrar(self.parent, self.reportes_service)

    def reporte_rotacion(self):
        """Rotación de inventario"""
        VentanaRotacionInventario(self.parent, self.reportes_service)

    def reporte_flujo_caja(self):
        """Flujo de caja"""
        VentanaFlujoCajaDashboard(self.parent, self.reportes_service)


# ═══════════════════════════════════════════════════════════════════════════════
#  VENTANA TOP PRODUCTOS  (profesional con KPIs, tabla, ordenamiento, alertas)
# ═══════════════════════════════════════════════════════════════════════════════

class VentanaTopProductos:
    """Dashboard de Top Productos Vendidos con KPIs, tabla moderna y alertas de stock"""

    AZUL = '#1e3a5f'
    AZUL_CLARO = '#2563eb'
    AZUL_HEADER = '#1e40af'
    VERDE = '#059669'
    VERDE_CLARO = '#10b981'
    NARANJA = '#f59e0b'
    ROJO = '#ef4444'
    GRIS_BG = '#f1f5f9'
    GRIS_FILA = '#f8fafc'
    TEXTO = '#0f172a'
    TEXTO_SEC = '#64748b'

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service
        self.datos = None
        self.productos = []
        self.orden_actual = 'cantidad'  # 'cantidad' | 'monto'

        self.window = tk.Toplevel(parent)
        self.window.title("💰 Top Productos Vendidos")
        self.window.geometry("1150x720")
        self.window.minsize(950, 600)
        self.window.transient(parent)
        self.window.configure(bg=self.GRIS_BG)

        self._crear_interfaz()
        self.window.focus_set()
        self._cargar_datos()

    # ─── INTERFAZ ─────────────────────────────────────────────────────

    def _crear_interfaz(self):
        # ── HEADER ────────────────────────────────────────────────────
        top_bar = tk.Frame(self.window, bg=self.AZUL)
        top_bar.pack(fill='x')

        titulo_frame = tk.Frame(top_bar, bg=self.AZUL)
        titulo_frame.pack(fill='x', padx=25, pady=(12, 0))
        tk.Label(titulo_frame, text="💰 Top Productos Vendidos",
                font=('Segoe UI', 17, 'bold'), bg=self.AZUL, fg='white').pack(side='left')

        btn_frame_top = tk.Frame(titulo_frame, bg=self.AZUL)
        btn_frame_top.pack(side='right')
        for txt, icono, cmd in [("Exportar", "📤", self._exportar), ("Imprimir", "🖨️", self._imprimir)]:
            b = tk.Button(btn_frame_top, text=f"{icono} {txt}", font=('Segoe UI', 9),
                         bg='white', fg=self.AZUL, relief='flat', cursor='hand2',
                         padx=14, pady=3, command=cmd)
            b.pack(side='left', padx=4)
            b.bind('<Enter>', lambda e, w=b: w.configure(bg='#e0e7ff'))
            b.bind('<Leave>', lambda e, w=b: w.configure(bg='white'))

        # Filtros: fechas + botón generar + ordenamiento
        filtro_frame = tk.Frame(top_bar, bg=self.AZUL)
        filtro_frame.pack(fill='x', padx=25, pady=(10, 12))

        hoy = datetime.now()
        inicio_def = hoy - timedelta(days=30)

        tk.Label(filtro_frame, text="Desde:", font=('Segoe UI', 10, 'bold'),
                bg=self.AZUL, fg='#93c5fd').pack(side='left')
        self.fecha_inicio = tk.Entry(filtro_frame, width=13, font=('Segoe UI', 10),
                                     relief='flat', highlightthickness=1,
                                     highlightbackground='#94a3b8')
        self.fecha_inicio.insert(0, inicio_def.strftime('%Y-%m-%d'))
        self.fecha_inicio.pack(side='left', padx=(6, 16))

        tk.Label(filtro_frame, text="Hasta:", font=('Segoe UI', 10, 'bold'),
                bg=self.AZUL, fg='#93c5fd').pack(side='left')
        self.fecha_fin = tk.Entry(filtro_frame, width=13, font=('Segoe UI', 10),
                                  relief='flat', highlightthickness=1,
                                  highlightbackground='#94a3b8')
        self.fecha_fin.insert(0, hoy.strftime('%Y-%m-%d'))
        self.fecha_fin.pack(side='left', padx=(6, 20))

        self._generando = False
        self.btn_generar = tk.Button(filtro_frame, text="🔍  Generar",
                               font=('Segoe UI', 10, 'bold'), bg=self.VERDE, fg='white',
                               activebackground=self.VERDE_CLARO, activeforeground='white',
                               relief='flat', cursor='hand2', padx=16, pady=3,
                               command=self._on_generar)
        self.btn_generar.pack(side='left', padx=(0, 20))
        self.btn_generar.bind('<Enter>', lambda e: self.btn_generar.configure(bg=self.VERDE_CLARO) if not self._generando else None)
        self.btn_generar.bind('<Leave>', lambda e: self.btn_generar.configure(bg=self.VERDE) if not self._generando else None)
        self.fecha_inicio.bind('<Return>', lambda e: self._on_generar())
        self.fecha_fin.bind('<Return>', lambda e: self._on_generar())

        # Toggle: Ordenar por
        tk.Label(filtro_frame, text="Ordenar por:", font=('Segoe UI', 9, 'bold'),
                bg=self.AZUL, fg='#93c5fd').pack(side='left', padx=(0, 6))
        self.btn_ord_cant = tk.Button(filtro_frame, text="📦 Cantidad",
                                       font=('Segoe UI', 9, 'bold'), bg='white', fg=self.AZUL,
                                       relief='flat', cursor='hand2', padx=10, pady=2,
                                       command=lambda: self._cambiar_orden('cantidad'))
        self.btn_ord_cant.pack(side='left', padx=2)
        self.btn_ord_monto = tk.Button(filtro_frame, text="💵 Monto",
                                        font=('Segoe UI', 9), bg='#475569', fg='white',
                                        relief='flat', cursor='hand2', padx=10, pady=2,
                                        command=lambda: self._cambiar_orden('monto'))
        self.btn_ord_monto.pack(side='left', padx=2)

        # ── KPI CARDS ────────────────────────────────────────────────
        self.kpi_frame = tk.Frame(self.window, bg=self.GRIS_BG)
        self.kpi_frame.pack(fill='x', padx=20, pady=(15, 5))

        # ── TABLA ─────────────────────────────────────────────────────
        tabla_container = tk.Frame(self.window, bg='white', relief='solid', borderwidth=1)
        tabla_container.pack(fill='both', expand=True, padx=20, pady=(5, 8))

        self.lbl_conteo = tk.Label(tabla_container, text="",
                                    font=('Segoe UI', 9), bg='white', fg=self.TEXTO_SEC, anchor='w')
        self.lbl_conteo.pack(fill='x', padx=15, pady=(8, 0))

        tree_frame = tk.Frame(tabla_container, bg='white')
        tree_frame.pack(fill='both', expand=True, padx=10, pady=(4, 10))

        scroll_y = ttk.Scrollbar(tree_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')

        columnas = ('rank', 'producto', 'categoria', 'cantidad', 'ingresos', 'pct', 'stock', 'estado')
        self.tree = ttk.Treeview(tree_frame, columns=columnas, show='headings',
                                  yscrollcommand=scroll_y.set, height=16)
        scroll_y.config(command=self.tree.yview)

        style = ttk.Style()
        style.configure('TopProd.Treeview', font=('Segoe UI', 10), rowheight=32,
                        background='white', fieldbackground='white', foreground=self.TEXTO)
        style.configure('TopProd.Treeview.Heading', font=('Segoe UI', 10, 'bold'),
                        background=self.AZUL_HEADER, foreground='white',
                        relief='flat', padding=(8, 6))
        style.map('TopProd.Treeview.Heading', background=[('active', self.AZUL_CLARO)])
        style.map('TopProd.Treeview', background=[('selected', '#dbeafe')],
                  foreground=[('selected', self.AZUL)])
        self.tree.configure(style='TopProd.Treeview')

        col_config = [
            ('rank',      '#',               50,  'center'),
            ('producto',  'Producto',        220, 'w'),
            ('categoria', 'Categoría',       130, 'w'),
            ('cantidad',  'Cant. Vendida',    100, 'center'),
            ('ingresos',  'Ingreso Total',   120, 'e'),
            ('pct',       '% Ingresos',       85, 'center'),
            ('stock',     'Stock Actual',     100, 'center'),
            ('estado',    'Estado Stock',      95, 'center'),
        ]
        for col_id, heading, width, anchor in col_config:
            self.tree.heading(col_id, text=heading)
            self.tree.column(col_id, width=width, minwidth=40, anchor=anchor)

        self.tree.tag_configure('par', background=self.GRIS_FILA)
        self.tree.tag_configure('impar', background='white')
        self.tree.tag_configure('stock_ok', foreground=self.VERDE)
        self.tree.tag_configure('stock_bajo', foreground=self.NARANJA)
        self.tree.tag_configure('stock_agotado', foreground=self.ROJO)
        self.tree.pack(fill='both', expand=True)

        # ── BARRA INFERIOR ────────────────────────────────────────────
        bottom = tk.Frame(self.window, bg=self.GRIS_BG, height=40)
        bottom.pack(fill='x', padx=20, pady=(0, 10))

        self.lbl_alerta = tk.Label(bottom, text="", font=('Segoe UI', 9, 'bold'),
                                    bg=self.GRIS_BG, fg=self.ROJO)
        self.lbl_alerta.pack(side='left')

        self.lbl_estado = tk.Label(bottom, text="", font=('Segoe UI', 9, 'italic'),
                                    bg=self.GRIS_BG, fg=self.TEXTO_SEC)
        self.lbl_estado.pack(side='right', padx=10)

    # ─── KPIs ─────────────────────────────────────────────────────────

    def _dibujar_kpis(self, datos):
        for w in self.kpi_frame.winfo_children():
            w.destroy()

        estrella = datos.get('producto_estrella')
        cat_top = datos.get('categoria_top', {})
        total_u = datos.get('total_unidades', 0)

        kpis = [
            ("🏆 Producto Estrella",
             estrella['nombre'] if estrella else '-',
             f"{estrella['cantidad_vendida']} uds vendidas" if estrella else '',
             self.AZUL_CLARO),
            ("📂 Categoría Más Rentable",
             cat_top.get('categoria', '-'),
             f"$ {cat_top.get('total_cat', 0):,.2f}" if cat_top.get('total_cat') else '',
             '#8b5cf6'),
            ("📦 Unidades Totales Vendidas",
             f"{total_u:,}",
             f"en el período",
             self.VERDE),
        ]

        for i, (titulo, valor, subtexto, color) in enumerate(kpis):
            card = tk.Frame(self.kpi_frame, bg='white', relief='solid', borderwidth=1,
                           padx=18, pady=12)
            card.grid(row=0, column=i, padx=8, sticky='nsew')
            self.kpi_frame.columnconfigure(i, weight=1)

            barra = tk.Frame(card, bg=color, height=4)
            barra.pack(fill='x', pady=(0, 8))

            tk.Label(card, text=titulo, font=('Segoe UI', 9),
                    bg='white', fg=self.TEXTO_SEC).pack(anchor='w')
            tk.Label(card, text=valor, font=('Segoe UI', 16, 'bold'),
                    bg='white', fg=color).pack(anchor='w', pady=(2, 0))
            if subtexto:
                tk.Label(card, text=subtexto, font=('Segoe UI', 8),
                        bg='white', fg=self.TEXTO_SEC).pack(anchor='w')

    # ─── CARGA Y ORDEN ───────────────────────────────────────────────

    def _on_generar(self):
        if self._generando:
            return
        self._generando = True
        try:
            self.btn_generar.config(text="⏳ ...", state='disabled', bg='#6b7280')
        except Exception:
            pass
        self.window.after(50, self._ejecutar)

    def _ejecutar(self):
        try:
            self._cargar_datos()
        except Exception as e:
            messagebox.showerror("Error", f"Error:\n{str(e)}")
        finally:
            if self.window.winfo_exists():
                self._generando = False
                try:
                    self.btn_generar.config(text="🔍  Generar", state='normal', bg=self.VERDE)
                except Exception:
                    pass

    def _cargar_datos(self):
        inicio = self.fecha_inicio.get().strip()
        fin = self.fecha_fin.get().strip()

        try:
            datetime.strptime(inicio, '%Y-%m-%d')
            datetime.strptime(fin, '%Y-%m-%d')
        except ValueError:
            messagebox.showwarning("Fecha inválida",
                                   "Formato: YYYY-MM-DD")
            return

        if inicio > fin:
            messagebox.showwarning("Rango inválido",
                                   "La fecha 'Desde' no puede ser mayor que 'Hasta'.")
            return

        self.datos = self.reportes_service.reporte_productos_mas_vendidos(inicio, fin, 20)
        self.productos = self.datos.get('productos', [])

        # Dibujar KPIs
        self._dibujar_kpis(self.datos)

        # Ordenar y rellenar tabla
        self._rellenar_tabla()

        # Alertas de reabastecimiento
        alertas = [p for p in self.productos if p.get('estado_stock') in ('BAJO', 'AGOTADO')]
        if alertas:
            nombres = ', '.join(p['nombre'] for p in alertas[:3])
            extra = f" (+{len(alertas)-3} más)" if len(alertas) > 3 else ""
            self.lbl_alerta.config(
                text=f"⚠️ ¡Atención! {len(alertas)} producto(s) del Top necesitan reabastecimiento: {nombres}{extra}")
        else:
            self.lbl_alerta.config(text="")

        self.lbl_estado.config(text=f"✅ Período: {inicio} → {fin}")

    def _cambiar_orden(self, nuevo_orden):
        if nuevo_orden == self.orden_actual:
            return
        self.orden_actual = nuevo_orden
        # Actualizar botones visuales
        if nuevo_orden == 'cantidad':
            self.btn_ord_cant.config(bg='white', fg=self.AZUL, font=('Segoe UI', 9, 'bold'))
            self.btn_ord_monto.config(bg='#475569', fg='white', font=('Segoe UI', 9))
        else:
            self.btn_ord_cant.config(bg='#475569', fg='white', font=('Segoe UI', 9))
            self.btn_ord_monto.config(bg='white', fg=self.AZUL, font=('Segoe UI', 9, 'bold'))
        self._rellenar_tabla()

    def _rellenar_tabla(self):
        self.tree.delete(*self.tree.get_children())

        if self.orden_actual == 'monto':
            productos_ord = sorted(self.productos, key=lambda x: x.get('monto_total', 0), reverse=True)
        else:
            productos_ord = list(self.productos)  # ya viene por cantidad DESC

        total = len(productos_ord)
        self.lbl_conteo.config(text=f"Mostrando {total} producto{'s' if total != 1 else ''}  •  "
                                     f"Ordenado por: {'Cantidad' if self.orden_actual == 'cantidad' else 'Monto Total'}")

        for idx, p in enumerate(productos_ord):
            rank = idx + 1
            stock = p.get('stock', 0) or 0
            unidad = p.get('unidad_medida', 'u') or 'u'
            estado = p.get('estado_stock', 'OK')

            # Iconos de estado
            if estado == 'AGOTADO':
                estado_txt = "❌ Agotado"
                estado_tag = 'stock_agotado'
            elif estado == 'BAJO':
                estado_txt = "⚠️ Bajo"
                estado_tag = 'stock_bajo'
            else:
                estado_txt = "✅ OK"
                estado_tag = 'stock_ok'

            tag_fila = 'par' if idx % 2 == 0 else 'impar'

            # Medalla para top 3
            if rank == 1:
                rank_txt = "🥇 1"
            elif rank == 2:
                rank_txt = "🥈 2"
            elif rank == 3:
                rank_txt = "🥉 3"
            else:
                rank_txt = str(rank)

            self.tree.insert('', 'end', values=(
                rank_txt,
                p.get('nombre', ''),
                p.get('categoria', ''),
                p.get('cantidad_vendida', 0),
                f"$ {p.get('monto_total', 0):,.2f}",
                f"{p.get('porcentaje_ingresos', 0)}%",
                f"{stock} {unidad}",
                estado_txt,
            ), tags=(tag_fila, estado_tag))

    # ─── ACCIONES ─────────────────────────────────────────────────────

    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportación en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresión en desarrollo.")


# ═══════════════════════════════════════════════════════════════════════════════
#  VENTANA VENTAS POR MÉTODO DE PAGO  (compacta, sin scroll, estilo SaaS)
# ═══════════════════════════════════════════════════════════════════════════════

class VentanaMetodosPago:
    """Dashboard compacto de Ventas por Método de Pago — todo visible en 1920×1080"""

    AZUL = '#1e3a5f'
    AZUL_CLARO = '#2563eb'
    AZUL_HEADER = '#1e40af'
    VERDE = '#059669'
    VERDE_CLARO = '#10b981'
    NARANJA = '#f59e0b'
    ROJO = '#ef4444'
    MORADO = '#8b5cf6'
    GRIS_BG = '#f1f5f9'
    GRIS_FILA = '#f8fafc'
    BORDE = '#edf2f7'          # borde más claro / liviano
    BORDE_SUTIL = '#f0f4f8'    # borde ultra-sutil
    TEXTO = '#0f172a'
    TEXTO_SEC = '#64748b'

    METODO_CONFIG = {
        'EFECTIVO':      {'color': '#059669', 'icon': '💵', 'label': 'Efectivo'},
        'TARJETA':       {'color': '#2563eb', 'icon': '💳', 'label': 'Tarjeta'},
        'TRANSFERENCIA': {'color': '#f59e0b', 'icon': '🏦', 'label': 'Transferencia'},
        'CREDITO':       {'color': '#8b5cf6', 'icon': '📋', 'label': 'Crédito'},
        'NEQUI':         {'color': '#e91e63', 'icon': '📱', 'label': 'Nequi'},
        'DAVIPLATA':     {'color': '#ff5722', 'icon': '📱', 'label': 'Daviplata'},
    }
    DEFAULT_CONFIG = {'color': '#64748b', 'icon': '💰', 'label': None}

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service
        self.datos = None
        self._arc_items = {}      # arc_id → metodo_pago  (para hover dona)
        self._tree_iids = {}      # metodo_pago → tree iid (para highlight cruzado)
        self._tree = None

        self.window = tk.Toplevel(parent)
        self.window.title("💳 Ventas por Método de Pago")
        self.window.geometry("1100x700")
        self.window.minsize(960, 600)
        self.window.transient(parent)
        self.window.configure(bg=self.GRIS_BG)

        self._crear_interfaz()
        self.window.focus_set()
        self._cargar_datos()

    def _get_metodo_cfg(self, metodo):
        cfg = self.METODO_CONFIG.get(metodo, self.DEFAULT_CONFIG)
        if cfg['label'] is None:
            cfg = dict(cfg)
            cfg['label'] = metodo.title()
        return cfg

    # ─── INTERFAZ ─────────────────────────────────────────────────────

    def _crear_interfaz(self):
        # ══ HEADER: Título + Fechas + Botones — una sola línea ════════
        header = tk.Frame(self.window, bg=self.AZUL)
        header.pack(fill='x')

        hdr_inner = tk.Frame(header, bg=self.AZUL)
        hdr_inner.pack(fill='x', padx=22, pady=9)          # más padding lateral

        tk.Label(hdr_inner, text="💳 Ventas por Método de Pago",
                font=('Segoe UI', 14, 'bold'), bg=self.AZUL, fg='white').pack(side='left')

        # Botones (derecha) — con margen derecho extra
        btn_wrapper = tk.Frame(hdr_inner, bg=self.AZUL)
        btn_wrapper.pack(side='right', padx=(0, 4))        # respira del borde derecho

        for txt, icono, cmd in [("Imprimir", "🖨", self._imprimir),
                                 ("Exportar", "📤", self._exportar)]:
            b = tk.Button(btn_wrapper, text=f"{icono} {txt}", font=('Segoe UI', 8),
                         bg='white', fg=self.AZUL, relief='flat', cursor='hand2',
                         padx=10, pady=1, command=cmd)
            b.pack(side='right', padx=4)
            b.bind('<Enter>', lambda e, w=b: w.configure(bg='#e0e7ff'))
            b.bind('<Leave>', lambda e, w=b: w.configure(bg='white'))

        # Generar
        self._generando = False
        self.btn_generar = tk.Button(btn_wrapper, text="🔍 Generar",
                               font=('Segoe UI', 9, 'bold'), bg=self.VERDE, fg='white',
                               activebackground=self.VERDE_CLARO, relief='flat',
                               cursor='hand2', padx=12, pady=1, command=self._on_generar)
        self.btn_generar.pack(side='right', padx=(0, 14))
        self.btn_generar.bind('<Enter>', lambda e: self.btn_generar.configure(bg=self.VERDE_CLARO) if not self._generando else None)
        self.btn_generar.bind('<Leave>', lambda e: self.btn_generar.configure(bg=self.VERDE) if not self._generando else None)

        hoy = datetime.now()
        inicio_def = hoy - timedelta(days=30)

        # Fechas (centro-derecha)
        fechas_frame = tk.Frame(hdr_inner, bg=self.AZUL)
        fechas_frame.pack(side='right', padx=(0, 12))

        tk.Label(fechas_frame, text="Desde:", font=('Segoe UI', 9),
                bg=self.AZUL, fg='#93c5fd').pack(side='left')
        self.fecha_inicio = tk.Entry(fechas_frame, width=11, font=('Segoe UI', 9),
                                     relief='flat', highlightthickness=1,
                                     highlightbackground='#94a3b8')
        self.fecha_inicio.insert(0, inicio_def.strftime('%Y-%m-%d'))
        self.fecha_inicio.pack(side='left', padx=(4, 14))

        tk.Label(fechas_frame, text="Hasta:", font=('Segoe UI', 9),
                bg=self.AZUL, fg='#93c5fd').pack(side='left')
        self.fecha_fin = tk.Entry(fechas_frame, width=11, font=('Segoe UI', 9),
                                  relief='flat', highlightthickness=1,
                                  highlightbackground='#94a3b8')
        self.fecha_fin.insert(0, hoy.strftime('%Y-%m-%d'))
        self.fecha_fin.pack(side='left', padx=(4, 0))

        self.fecha_inicio.bind('<Return>', lambda e: self._on_generar())
        self.fecha_fin.bind('<Return>', lambda e: self._on_generar())

        # ══ KPI BAR — 3 celdas de igual ancho ═════════════════════════
        self.kpi_bar = tk.Frame(self.window, bg='white',
                               highlightbackground=self.BORDE, highlightthickness=1)
        self.kpi_bar.pack(fill='x', padx=16, pady=(10, 0))

        # ══ MEDIO: Donut (izq) + Desglose (der) ══════════════════════
        self.mid_frame = tk.Frame(self.window, bg=self.GRIS_BG)
        self.mid_frame.pack(fill='both', expand=True, padx=16, pady=(8, 0))

        # ══ TABLA compacta abajo ══════════════════════════════════════
        self.tabla_frame = tk.Frame(self.window, bg='white',
                                   highlightbackground=self.BORDE, highlightthickness=1)
        self.tabla_frame.pack(fill='x', padx=16, pady=(6, 10))

    # ─── KPI BAR (4 celdas uniformes con grid) ───────────────────────

    def _dibujar_kpis(self, datos):
        for w in self.kpi_bar.winfo_children():
            w.destroy()

        resumen = datos.get('resumen', {})
        predominante = datos.get('metodo_predominante', '-')
        pct_pre = datos.get('pct_predominante', 0)
        cfg_pre = self._get_metodo_cfg(predominante)
        cred = datos.get('credito_info', {})

        pendiente = cred.get('pendiente', 0)
        fact_pend = cred.get('facturas_pendientes', 0)
        fact_total = cred.get('facturas_total', 0)
        sub_cred = f"{fact_pend} de {fact_total} facturas" if fact_total > 0 else "Sin ventas a crédito"

        kpis = [
            ("💰", "Total Recaudado", f"$ {resumen.get('total_monto', 0):,.2f}", None, self.AZUL_CLARO),
            ("🧾", "Transacciones", f"{resumen.get('total_ventas', 0)}", None, self.VERDE),
            ("👑", "Predominante", f"{cfg_pre['icon']} {predominante} ({pct_pre}%)", None, self.MORADO),
            ("⚠", "Pendiente Crédito", f"$ {pendiente:,.2f}", sub_cred, self.NARANJA),
        ]

        # Grid con 4 columnas de igual peso → misma anchura
        inner = tk.Frame(self.kpi_bar, bg='white')
        inner.pack(fill='x', padx=4, pady=8)
        for col_i in range(4):
            inner.columnconfigure(col_i, weight=1, uniform='kpi')

        for i, (icon, titulo, valor, subtexto, color) in enumerate(kpis):
            cell = tk.Frame(inner, bg='white')
            cell.grid(row=0, column=i, sticky='nsew', padx=6)

            # Barra coloreada superior
            tk.Frame(cell, bg=color, height=3).pack(fill='x', pady=(0, 4))
            tk.Label(cell, text=f"{icon} {titulo}", font=('Segoe UI', 8),
                    bg='white', fg=self.TEXTO_SEC).pack(anchor='center')
            tk.Label(cell, text=valor, font=('Segoe UI', 13, 'bold'),
                    bg='white', fg=color).pack(anchor='center')
            if subtexto:
                tk.Label(cell, text=subtexto, font=('Segoe UI', 7),
                        bg='white', fg=self.TEXTO_SEC).pack(anchor='center', pady=(0, 2))

            # Separador vertical entre celdas (excepto la última)
            if i < 3:
                sep = tk.Frame(inner, bg=self.BORDE, width=1)
                sep.grid(row=0, column=i, sticky='nse', pady=6)

    # ─── DONUT + DESGLOSE ────────────────────────────────────────────

    def _dibujar_contenido(self, datos):
        for w in self.mid_frame.winfo_children():
            w.destroy()
        self._arc_items.clear()

        metodos = datos.get('por_metodo', [])

        # ── IZQUIERDA: Donut con leyenda al costado ──────────────────
        left = tk.Frame(self.mid_frame, bg='white',
                       highlightbackground=self.BORDE, highlightthickness=1)
        left.pack(side='left', fill='both', padx=(0, 5))

        donut_row = tk.Frame(left, bg='white')
        donut_row.pack(fill='both', expand=True, padx=10, pady=10)

        canvas_sz = 170
        self._donut_canvas = tk.Canvas(donut_row, width=canvas_sz, height=canvas_sz,
                                       bg='white', highlightthickness=0)
        self._donut_canvas.pack(side='left', padx=(4, 12))

        if metodos:
            cx, cy, r = canvas_sz // 2, canvas_sz // 2, 72
            inner_r = 38          # más grueso: 72-38 = 34px de anillo vs antes 68-42 = 26px
            start = 0
            total = sum(m.get('monto_total', 0) for m in metodos) or 1

            for m in metodos:
                pct = m['monto_total'] / total
                extent = max(pct * 360, 0.5)
                cfg = self._get_metodo_cfg(m['metodo_pago'])
                arc_id = self._donut_canvas.create_arc(
                    cx - r, cy - r, cx + r, cy + r,
                    start=start, extent=extent,
                    fill=cfg['color'], outline='white', width=2)
                self._arc_items[arc_id] = m['metodo_pago']
                start += extent

            self._donut_canvas.create_oval(cx - inner_r, cy - inner_r,
                                           cx + inner_r, cy + inner_r,
                                           fill='white', outline='white')
            self._donut_canvas.create_text(cx, cy - 8, text="Total",
                                           font=('Segoe UI', 8), fill=self.TEXTO_SEC)
            self._donut_canvas.create_text(cx, cy + 10,
                                           text=f"$ {total:,.0f}",
                                           font=('Segoe UI', 10, 'bold'), fill=self.TEXTO)

            # Bind hover en dona → highlight tabla
            self._donut_canvas.bind('<Motion>', self._on_donut_hover)
            self._donut_canvas.bind('<Leave>', self._on_donut_leave)
        else:
            self._donut_canvas.create_text(canvas_sz // 2, canvas_sz // 2,
                                           text="Sin datos", font=('Segoe UI', 10),
                                           fill=self.TEXTO_SEC)

        # Leyenda al costado — alineada verticalmente bajo el centro del donut
        legend = tk.Frame(donut_row, bg='white')
        legend.pack(side='left', fill='y', padx=(0, 8), anchor='center')
        for m in metodos:
            cfg = self._get_metodo_cfg(m['metodo_pago'])
            row = tk.Frame(legend, bg='white')
            row.pack(fill='x', pady=3)
            dot = tk.Frame(row, bg=cfg['color'], width=10, height=10)
            dot.pack(side='left', pady=2)
            dot.pack_propagate(False)
            tk.Label(row, text=f" {cfg['icon']} {cfg['label']}",
                    font=('Segoe UI', 9), bg='white', fg=self.TEXTO).pack(side='left')
            tk.Label(row, text=f"  {m.get('porcentaje_monto', 0)}%",
                    font=('Segoe UI', 9, 'bold'), bg='white',
                    fg=cfg['color']).pack(side='left')

        # ── DERECHA: Desglose — diferenciado de tabla con mini-sparklines ──
        right = tk.Frame(self.mid_frame, bg='white',
                        highlightbackground=self.BORDE, highlightthickness=1)
        right.pack(side='left', fill='both', expand=True, padx=(5, 0))

        tk.Label(right, text="📊 Distribución y Tendencia",
                font=('Segoe UI', 10, 'bold'), bg='white', fg=self.AZUL
                ).pack(anchor='w', padx=14, pady=(10, 6))

        if not metodos:
            tk.Label(right, text="Sin datos en este período",
                    font=('Segoe UI', 9, 'italic'), bg='white',
                    fg=self.TEXTO_SEC).pack(pady=20)

        max_monto = max((m.get('monto_total', 0) for m in metodos), default=1) or 1

        for idx, m in enumerate(metodos):
            cfg = self._get_metodo_cfg(m['metodo_pago'])
            color = cfg['color']

            item = tk.Frame(right, bg='white')
            item.pack(fill='x', padx=14, pady=4)

            # Fila info: icono + nombre + tendencia …………… monto alineado a la derecha
            info_row = tk.Frame(item, bg='white')
            info_row.pack(fill='x')

            tk.Label(info_row, text=f"{cfg['icon']} {cfg['label']}",
                    font=('Segoe UI', 10, 'bold'), bg='white', fg=self.TEXTO).pack(side='left')

            variacion = m.get('variacion')
            if variacion is None:
                t_txt, t_col = "✦ Nuevo", self.AZUL_CLARO
            elif variacion > 0:
                t_txt, t_col = f"▲ +{variacion}%", self.VERDE
            elif variacion < 0:
                t_txt, t_col = f"▼ {variacion}%", self.ROJO
            else:
                t_txt, t_col = "— 0%", self.TEXTO_SEC
            tk.Label(info_row, text=t_txt, font=('Segoe UI', 8, 'bold'),
                    bg='white', fg=t_col).pack(side='left', padx=8)

            # Monto alineado a la derecha (columna limpia)
            tk.Label(info_row, text=f"$ {m.get('monto_total', 0):>14,.2f}",
                    font=('Segoe UI', 10, 'bold'), bg='white', fg=color).pack(side='right')
            tk.Label(info_row, text=f"{m.get('cantidad_ventas', 0)} txn  ·  "
                                   f"Prom $ {m.get('promedio_venta', 0):,.0f}",
                    font=('Segoe UI', 8), bg='white', fg=self.TEXTO_SEC).pack(side='right', padx=10)

            # Barra de progreso más larga (ocupa todo el ancho)
            # Para CRÉDITO: barra bicolor (cobrado + pendiente)
            is_credito = m.get('metodo_pago') == 'CREDITO' and m.get('pendiente', 0) > 0
            bar_bg = tk.Frame(item, bg='#e9ecef', height=6)
            bar_bg.pack(fill='x', pady=(3, 0))
            pct_width = max(m.get('monto_total', 0) / max_monto, 0.02)

            if is_credito:
                pct_cobrado_visual = m.get('pct_cobrado', 100) / 100.0
                # Parte cobrada (color sólido)
                bar_cobrado = tk.Frame(bar_bg, bg=color, height=6)
                bar_cobrado.place(relwidth=pct_width * pct_cobrado_visual, relheight=1.0)
                # Parte pendiente (rojo suave)
                bar_pend = tk.Frame(bar_bg, bg='#fca5a5', height=6)
                bar_pend.place(relx=pct_width * pct_cobrado_visual,
                              relwidth=pct_width * (1 - pct_cobrado_visual), relheight=1.0)
            else:
                bar_fill = tk.Frame(bar_bg, bg=color, height=6)
                bar_fill.place(relwidth=pct_width, relheight=1.0)

            # Línea extra de cobrado/pendiente solo para CRÉDITO
            if is_credito:
                cred_row = tk.Frame(item, bg='white')
                cred_row.pack(fill='x', pady=(2, 0))
                cobrado = m.get('cobrado', 0)
                pendiente = m.get('pendiente', 0)
                pct_c = m.get('pct_cobrado', 0)
                tk.Label(cred_row, text=f"✅ Cobrado: $ {cobrado:,.2f} ({pct_c}%)",
                        font=('Segoe UI', 8), bg='white', fg=self.VERDE).pack(side='left')
                tk.Label(cred_row, text=f"🔴 Pendiente: $ {pendiente:,.2f} ({round(100 - pct_c, 1)}%)",
                        font=('Segoe UI', 8), bg='white', fg=self.ROJO).pack(side='right')

            # Separador ultra-sutil entre items
            if idx < len(metodos) - 1:
                tk.Frame(item, bg=self.BORDE_SUTIL, height=1).pack(fill='x', pady=(6, 0))

    # ─── TABLA COMPACTA (zebra + $ alineados a la derecha) ───────────

    def _dibujar_tabla(self, datos):
        for w in self.tabla_frame.winfo_children():
            w.destroy()
        self._tree_iids.clear()

        metodos = datos.get('por_metodo', [])

        cols = ('metodo', 'txn', 'monto', 'promedio', 'pct', 'trend', 'pendiente')
        tree = ttk.Treeview(self.tabla_frame, columns=cols, show='headings',
                            height=min(len(metodos) + 1, 6))
        self._tree = tree

        style = ttk.Style()
        style.configure('MetPago.Treeview', font=('Segoe UI', 9), rowheight=26,
                        background='white', fieldbackground='white')
        style.configure('MetPago.Treeview.Heading', font=('Segoe UI', 8, 'bold'),
                        background=self.AZUL_HEADER, foreground='white',
                        relief='flat', padding=(4, 4))
        style.map('MetPago.Treeview.Heading', background=[('active', self.AZUL_CLARO)])
        style.map('MetPago.Treeview',
                  background=[('selected', '#dbeafe')],
                  foreground=[('selected', self.AZUL)])
        tree.configure(style='MetPago.Treeview')

        col_cfg = [
            ('metodo',    'Método',           160, 'w'),
            ('txn',       'Transacciones',     90, 'center'),
            ('monto',     'Monto Total',      130, 'e'),
            ('promedio',  'Promedio',          110, 'e'),
            ('pct',       '% Total',            70, 'center'),
            ('trend',     'vs Ant.',            80, 'center'),
            ('pendiente', 'Pendiente',         120, 'e'),
        ]
        for cid, heading, w, anc in col_cfg:
            tree.heading(cid, text=heading)
            tree.column(cid, width=w, minwidth=40, anchor=anc)

        # Zebra striping
        tree.tag_configure('par', background='#f8fafc')
        tree.tag_configure('impar', background='white')
        tree.tag_configure('highlight', background='#dbeafe')

        for idx, m in enumerate(metodos):
            cfg = self._get_metodo_cfg(m['metodo_pago'])
            v = m.get('variacion')
            if v is None:
                trend = "✦ Nuevo"
            elif v > 0:
                trend = f"▲ +{v}%"
            elif v < 0:
                trend = f"▼ {v}%"
            else:
                trend = "— 0%"

            # Columna pendiente: solo para CRÉDITO
            pend = m.get('pendiente', 0)
            if m['metodo_pago'] == 'CREDITO' and pend > 0:
                pend_txt = f"$ {pend:,.2f} ⚠"
            else:
                pend_txt = "—"

            tag = 'par' if idx % 2 == 0 else 'impar'
            iid = tree.insert('', 'end', values=(
                f"{cfg['icon']} {cfg['label']}",
                m.get('cantidad_ventas', 0),
                f"$ {m.get('monto_total', 0):,.2f}",
                f"$ {m.get('promedio_venta', 0):,.2f}",
                f"{m.get('porcentaje_monto', 0)}%",
                trend,
                pend_txt,
            ), tags=(tag,))
            self._tree_iids[m['metodo_pago']] = iid

        tree.pack(fill='x', padx=8, pady=(4, 8))

    # ─── HOVER INTERACTIVO:  dona ↔ tabla ────────────────────────────

    def _on_donut_hover(self, event):
        """Resalta la fila de la tabla cuando el mouse pasa sobre un arco de la dona."""
        if not self._tree:
            return
        items = self._donut_canvas.find_overlapping(event.x, event.y, event.x, event.y)
        hovered_metodo = None
        for item_id in items:
            if item_id in self._arc_items:
                hovered_metodo = self._arc_items[item_id]
                break

        # Restaurar tags originales
        for idx, (metodo, iid) in enumerate(self._tree_iids.items()):
            tag = 'par' if idx % 2 == 0 else 'impar'
            self._tree.item(iid, tags=(tag,))

        # Aplicar highlight
        if hovered_metodo and hovered_metodo in self._tree_iids:
            iid = self._tree_iids[hovered_metodo]
            self._tree.item(iid, tags=('highlight',))
            self._tree.see(iid)

    def _on_donut_leave(self, _event):
        """Restaura colores al salir de la dona."""
        if not self._tree:
            return
        for idx, (metodo, iid) in enumerate(self._tree_iids.items()):
            tag = 'par' if idx % 2 == 0 else 'impar'
            self._tree.item(iid, tags=(tag,))

    # ─── CARGA ────────────────────────────────────────────────────────

    def _on_generar(self):
        if self._generando:
            return
        self._generando = True
        try:
            self.btn_generar.config(text="⏳ ...", state='disabled', bg='#6b7280')
        except Exception:
            pass
        self.window.after(50, self._ejecutar)

    def _ejecutar(self):
        try:
            self._cargar_datos()
        except Exception as e:
            messagebox.showerror("Error", f"Error:\n{str(e)}")
        finally:
            if self.window.winfo_exists():
                self._generando = False
                try:
                    self.btn_generar.config(text="🔍 Generar", state='normal', bg=self.VERDE)
                except Exception:
                    pass

    def _cargar_datos(self):
        inicio = self.fecha_inicio.get().strip()
        fin = self.fecha_fin.get().strip()

        try:
            datetime.strptime(inicio, '%Y-%m-%d')
            datetime.strptime(fin, '%Y-%m-%d')
        except ValueError:
            messagebox.showwarning("Fecha inválida", "Formato: YYYY-MM-DD")
            return

        if inicio > fin:
            messagebox.showwarning("Rango inválido",
                                   "La fecha 'Desde' no puede ser mayor que 'Hasta'.")
            return

        self.datos = self.reportes_service.ventas_por_metodo_pago(inicio, fin)
        self._dibujar_kpis(self.datos)
        self._dibujar_contenido(self.datos)
        self._dibujar_tabla(self.datos)

    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportación en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresión en desarrollo.")


# ═══════════════════════════════════════════════════════════════════════════════
#  VENTANA ESTADÍSTICAS GENERALES – DASHBOARD KPI
# ═══════════════════════════════════════════════════════════════════════════════

class VentanaEstadisticasDashboard:
    """Dashboard visual de Estadísticas Generales con tarjetas KPI agrupadas."""

    # Paleta de colores
    AZUL_HEADER = '#1e40af'
    AZUL_COBALT = '#2563eb'
    VERDE = '#059669'
    VERDE_CLARO = '#10b981'
    ROJO = '#ef4444'
    NARANJA = '#f59e0b'
    GRIS_BG = '#f1f5f9'
    BLANCO = '#ffffff'
    TEXTO = '#0f172a'
    TEXTO_SEC = '#64748b'
    TEXTO_LIGHT = '#94a3b8'
    SOMBRA = '#e2e8f0'

    CARD_H = 82
    PERIODOS = {
        'Última semana': 7,
        'Último mes': 30,
        'Último año': 365,
    }

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service
        self.parent = parent

        self.window = tk.Toplevel(parent)
        self.window.title("Estadísticas Generales")
        self.window.geometry("960x620")
        self.window.configure(bg=self.GRIS_BG)
        self.window.transient(parent)
        self.window.resizable(False, False)

        self._crear_header()
        self.body = tk.Frame(self.window, bg=self.GRIS_BG)
        self.body.pack(fill='both', expand=True)
        self._cargar_datos()

    # ── Header ────────────────────────────────────────────────────────────────────────
    def _crear_header(self):
        header = tk.Frame(self.window, bg=self.AZUL_HEADER, height=54)
        header.pack(fill='x')
        header.pack_propagate(False)

        tk.Label(header, text="📊  Estadísticas Generales",
                 font=('Segoe UI', 14, 'bold'), bg=self.AZUL_HEADER,
                 fg='white').pack(side='left', padx=20)

        # Botones redondeados
        for texto, cmd in [("🖨️ Imprimir", self._imprimir),
                           ("📤 Exportar", self._exportar)]:
            self._boton_redondeado(header, texto, cmd)

        # Selector de periodo
        self.periodo_var = tk.StringVar(value='Último mes')
        combo = ttk.Combobox(header, textvariable=self.periodo_var,
                             values=list(self.PERIODOS.keys()),
                             state='readonly', width=14, font=('Segoe UI', 9))
        combo.pack(side='right', padx=(0, 12), pady=14)
        combo.bind('<<ComboboxSelected>>', lambda e: self._cargar_datos())

        tk.Label(header, text="Periodo:", font=('Segoe UI', 9),
                 bg=self.AZUL_HEADER, fg='#cbd5e1').pack(side='right', padx=(0, 4))

    def _boton_redondeado(self, parent, texto, comando):
        """Botón con esquinas redondeadas via Canvas."""
        w, h, r = 108, 28, 8
        c = tk.Canvas(parent, width=w, height=h, bg=self.AZUL_HEADER,
                      highlightthickness=0)
        c.pack(side='right', padx=(0, 6), pady=13)
        for x0, y0, x1, y1, sa, ea in [
            (0, 0, r*2, r*2, 90, 90), (w-r*2, 0, w, r*2, 0, 90),
            (0, h-r*2, r*2, h, 180, 90), (w-r*2, h-r*2, w, h, 270, 90)]:
            c.create_arc(x0, y0, x1, y1, start=sa, extent=ea,
                         fill='white', outline='white')
        c.create_rectangle(r, 0, w-r, h, fill='white', outline='white')
        c.create_rectangle(0, r, w, h-r, fill='white', outline='white')
        c.create_text(w//2, h//2, text=texto, font=('Segoe UI', 9),
                      fill=self.AZUL_HEADER)
        c.configure(cursor='hand2')
        c.bind('<Button-1>', lambda e: comando())

    # ── Carga / recarga de datos ────────────────────────────────────────────────────────
    def _cargar_datos(self):
        for w in self.body.winfo_children():
            w.destroy()

        dias = self.PERIODOS.get(self.periodo_var.get(), 30)
        hoy = datetime.now()
        fecha_fin = hoy.strftime('%Y-%m-%d')
        fecha_inicio = (hoy - timedelta(days=dias)).strftime('%Y-%m-%d')

        try:
            datos = self.reportes_service.estadisticas_generales(fecha_inicio, fecha_fin)
        except Exception as e:
            messagebox.showerror("Error", f"Error al obtener estadísticas: {e}")
            return

        container = self.body

        # Fila 1 – Inventario
        self._crear_seccion(container, "📦  Inventario", [
            ("🏷️", "Total Productos", str(datos.get('total_productos', 0)),
             self.AZUL_COBALT),
            ("💲", "Valor Inv. Costo", self._fmt(datos.get('valor_inventario_costo', 0)),
             self.AZUL_COBALT),
            ("🏪", "Valor Inv. Venta", self._fmt(datos.get('valor_inventario_venta', 0)),
             self.AZUL_COBALT),
        ], row=0)

        # Fila 2 – Ventas y Alcance
        self._crear_seccion(container, "🛒  Ventas y Alcance", [
            ("🧾", "Total Ventas", str(datos.get('total_ventas', 0)),
             self.AZUL_COBALT),
            ("💰", "Monto Total Ventas", self._fmt(datos.get('monto_total_ventas', 0)),
             self.AZUL_COBALT),
            ("👥", "Total Clientes", str(datos.get('total_clientes', 0)),
             self.AZUL_COBALT),
            ("🚚", "Total Proveedores", str(datos.get('total_proveedores', 0)),
             self.AZUL_COBALT),
        ], row=1)

        # Fila 3 – Rendimiento del Periodo
        margen = datos.get('margen_mes', 0)
        color_margen = self.VERDE if margen >= 0 else self.ROJO

        self._crear_seccion(container, "📈  Rendimiento del Periodo", [
            ("💵", "Ingresos", self._fmt(datos.get('ingresos_mes', 0)),
             self.VERDE),
            ("💸", "Costos", self._fmt(datos.get('costos_mes', 0)),
             self.NARANJA),
            ("💹", "Utilidad", self._fmt(datos.get('utilidad_mes', 0)),
             self.VERDE_CLARO),
            ("⬆️", "Margen", f"{margen}%",
             color_margen),
        ], row=2, destacada=True)

    # ── Sección (título + fila de tarjetas) ───────────────────────────────────────────────
    def _crear_seccion(self, parent, titulo, tarjetas, row=0, destacada=False):
        section = tk.Frame(parent, bg=self.GRIS_BG)
        section.pack(fill='x', padx=24, pady=(10 if row == 0 else 2, 0))

        tk.Label(section, text=titulo, font=('Segoe UI', 10, 'bold'),
                 bg=self.GRIS_BG, fg=self.TEXTO).pack(anchor='w', pady=(0, 4))

        cards_frame = tk.Frame(section, bg=self.GRIS_BG)
        cards_frame.pack(fill='x')

        for i, (icono, etiqueta, valor, color_acento) in enumerate(tarjetas):
            cards_frame.columnconfigure(i, weight=1, uniform='card')
            self._crear_tarjeta(cards_frame, icono, etiqueta, valor,
                                color_acento, i, destacada)

    # ── Tarjeta KPI individual ──────────────────────────────────────────────────────
    def _crear_tarjeta(self, parent, icono, etiqueta, valor, color_acento, col, destacada):
        outer = tk.Frame(parent, bg=self.SOMBRA, padx=1, pady=1)
        outer.grid(row=0, column=col, padx=4, pady=3, sticky='nsew')

        bg = self.BLANCO
        card = tk.Frame(outer, bg=bg, height=self.CARD_H)
        card.pack(fill='both', expand=True)
        card.pack_propagate(False)

        inner = tk.Frame(card, bg=bg)
        inner.pack(fill='both', expand=True, padx=12, pady=8)

        # Barra de color superior
        bar = tk.Frame(inner, bg=color_acento, height=3)
        bar.pack(fill='x', pady=(0, 6))

        # Icono + etiqueta – altura fija
        top = tk.Frame(inner, bg=bg, height=18)
        top.pack(anchor='w', fill='x')
        top.pack_propagate(False)
        tk.Label(top, text=icono, font=('Segoe UI', 10), bg=bg).pack(side='left')
        tk.Label(top, text=etiqueta, font=('Segoe UI', 8),
                 bg=bg, fg=self.TEXTO_LIGHT).pack(side='left', padx=(4, 0))

        # Valor – fuente reducida en sección destacada
        if destacada:
            font_size = 16 if len(valor) <= 8 else (14 if len(valor) <= 12 else 12)
            fg = color_acento
        else:
            font_size = 18 if len(valor) <= 8 else (15 if len(valor) <= 12 else 13)
            fg = self.TEXTO

        tk.Label(inner, text=valor, font=('Segoe UI', font_size, 'bold'),
                 bg=bg, fg=fg).pack(anchor='w', pady=(2, 0))

    # ── Utilidades ──────────────────────────────────────────────────────────────
    @staticmethod
    def _fmt(valor):
        try:
            return f"${float(valor):,.2f}"
        except (ValueError, TypeError):
            return "$0.00"

    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportación en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresión en desarrollo.")

class VentanaReporte:
    """Ventana genérica para mostrar reportes sin parámetros"""
    
    def __init__(self, parent, titulo, funcion_reporte):
        self.funcion_reporte = funcion_reporte
        
        self.window = tk.Toplevel(parent)
        self.window.title(titulo)
        self.window.geometry("900x600")
        self.window.transient(parent)
        
        self.crear_interfaz(titulo)
        self.cargar_reporte()
    
    def crear_interfaz(self, titulo):
        """Crea la interfaz"""
        # Header
        header = tk.Frame(self.window, bg=COLORS['primary'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        
        tk.Label(header, text=titulo, font=FONTS['large'],
                bg=COLORS['primary'], fg='white').pack(side='left', padx=20, pady=15)
        
        # Botones
        tk.Button(header, text=f"{ICONS['imprimir']} Imprimir",
                 font=FONTS['body'], bg='white', fg=COLORS['primary'],
                 cursor='hand2', relief='flat', padx=15, pady=5,
                 command=self.imprimir).pack(side='right', padx=5)
        
        tk.Button(header, text=f"{ICONS['exportar']} Exportar",
                 font=FONTS['body'], bg='white', fg=COLORS['primary'],
                 cursor='hand2', relief='flat', padx=15, pady=5,
                 command=self.exportar).pack(side='right', padx=5)
        
        # Área de contenido
        content_frame = tk.Frame(self.window, bg='white')
        content_frame.pack(fill='both', expand=True, padx=20, pady=20)
        
        # Scrollbar
        scroll_y = ttk.Scrollbar(content_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')
        
        # Text widget para mostrar el reporte
        self.text = tk.Text(content_frame, font=('Courier New', 10),
                           wrap='word', yscrollcommand=scroll_y.set,
                           bg='white', relief='flat')
        self.text.pack(fill='both', expand=True)
        
        scroll_y.config(command=self.text.yview)
    
    def cargar_reporte(self):
        """Carga y muestra el reporte"""
        try:
            datos = self.funcion_reporte()
            
            self.text.delete('1.0', 'end')
            
            if isinstance(datos, dict):
                texto = self.formatear_dict(datos)
            elif isinstance(datos, list):
                texto = self.formatear_lista(datos)
            else:
                texto = str(datos)
            
            self.text.insert('1.0', texto)
            self.text.config(state='disabled')
            
        except Exception as e:
            messagebox.showerror("Error", f"Error al generar reporte: {str(e)}")
    
    def formatear_dict(self, datos, nivel=0):
        """Formatea un diccionario para visualización"""
        texto = ""
        indent = "  " * nivel
        
        for key, value in datos.items():
            label = str(key).replace('_', ' ').title()
            if isinstance(value, dict):
                texto += f"{indent}{'─' * 40}\n" if nivel == 0 else ""
                texto += f"{indent}{label}:\n"
                texto += self.formatear_dict(value, nivel + 1)
            elif isinstance(value, list):
                texto += f"{indent}{'─' * 40}\n" if nivel == 0 else ""
                texto += f"{indent}{label}: ({len(value)} registros)\n"
                texto += self.formatear_lista(value, nivel + 1)
            else:
                if isinstance(value, float):
                    value = f"{value:,.2f}"
                texto += f"{indent}{label}: {value}\n"
        
        return texto
    
    def formatear_lista(self, datos, nivel=0):
        """Formatea una lista para visualización"""
        texto = ""
        indent = "  " * nivel
        
        for i, item in enumerate(datos, 1):
            if isinstance(item, dict):
                texto += f"{indent}{'─' * 30}\n"
                texto += f"{indent}#{i}\n"
                for key, value in item.items():
                    label = str(key).replace('_', ' ').title()
                    if isinstance(value, float):
                        value = f"{value:,.2f}"
                    texto += f"{indent}  {label}: {value}\n"
            else:
                texto += f"{indent}{i}. {item}\n"
        
        return texto
    
    def imprimir(self):
        """Imprime el reporte"""
        messagebox.showinfo("Imprimir", "Funcionalidad de impresión en desarrollo")
    
    def exportar(self):
        """Exporta el reporte"""
        messagebox.showinfo("Exportar", "Funcionalidad de exportación en desarrollo")


# ═══════════════════════════════════════════════════════════════════════════════
#  VENTANA RENTABILIDAD – DASHBOARD KPI
# ═══════════════════════════════════════════════════════════════════════════════

class VentanaRentabilidadDashboard:
    """Dashboard visual de Rentabilidad con tarjetas KPI + gr\u00e1fica + top productos."""

    AZUL_HEADER = '#1e40af'
    AZUL_COBALT = '#2563eb'
    VERDE = '#059669'
    VERDE_CLARO = '#10b981'
    NARANJA = '#f59e0b'
    ROJO = '#ef4444'
    GRIS_BG = '#f1f5f9'
    BLANCO = '#ffffff'
    TEXTO = '#0f172a'
    TEXTO_SEC = '#64748b'
    TEXTO_LIGHT = '#94a3b8'
    SOMBRA = '#e2e8f0'
    CARD_H = 92

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service

        self.window = tk.Toplevel(parent)
        self.window.title("\U0001f4b9 Reporte de Rentabilidad")
        self.window.geometry("960x640")
        self.window.configure(bg=self.GRIS_BG)
        self.window.transient(parent)
        self.window.resizable(False, False)

        self._crear_header()
        self._crear_filtros()
        self.body = tk.Frame(self.window, bg=self.GRIS_BG)
        self.body.pack(fill='both', expand=True)
        self._generar()

    # ── Header ──────────────────────────────────────────────────────────────
    def _crear_header(self):
        header = tk.Frame(self.window, bg=self.AZUL_HEADER, height=50)
        header.pack(fill='x')
        header.pack_propagate(False)

        tk.Label(header, text="\U0001f4b9  Reporte de Rentabilidad",
                 font=('Segoe UI', 14, 'bold'), bg=self.AZUL_HEADER,
                 fg='white').pack(side='left', padx=20)

        for texto, cmd in [("\U0001f5a8\ufe0f Imprimir", self._imprimir),
                           ("\U0001f4e4 Exportar", self._exportar)]:
            self._btn_round(header, texto, cmd)

    def _btn_round(self, parent, texto, comando):
        w, h, r = 108, 26, 8
        c = tk.Canvas(parent, width=w, height=h, bg=self.AZUL_HEADER,
                      highlightthickness=0)
        c.pack(side='right', padx=(0, 6), pady=12)
        for x0, y0, x1, y1, sa, ea in [
            (0, 0, r*2, r*2, 90, 90), (w-r*2, 0, w, r*2, 0, 90),
            (0, h-r*2, r*2, h, 180, 90), (w-r*2, h-r*2, w, h, 270, 90)]:
            c.create_arc(x0, y0, x1, y1, start=sa, extent=ea,
                         fill='white', outline='white')
        c.create_rectangle(r, 0, w-r, h, fill='white', outline='white')
        c.create_rectangle(0, r, w, h-r, fill='white', outline='white')
        c.create_text(w//2, h//2, text=texto, font=('Segoe UI', 9),
                      fill=self.AZUL_HEADER)
        c.configure(cursor='hand2')
        c.bind('<Button-1>', lambda e: comando())

    # ── Filtros de fecha (centrados) ────────────────────────────────────────
    def _crear_filtros(self):
        wrapper = tk.Frame(self.window, bg=self.GRIS_BG)
        wrapper.pack(fill='x', padx=28, pady=(16, 8))

        bar = tk.Frame(wrapper, bg=self.BLANCO)
        bar.pack(anchor='center')

        hoy = datetime.now()
        inicio_def = (hoy - timedelta(days=30)).strftime('%Y-%m-%d')
        fin_def = hoy.strftime('%Y-%m-%d')

        lbl_cfg = dict(font=('Segoe UI', 9, 'bold'), bg=self.BLANCO, fg=self.TEXTO)
        entry_cfg = dict(width=12, font=('Segoe UI', 10))

        tk.Label(bar, text="Desde:", **lbl_cfg).pack(side='left', padx=(16, 4))
        if HAS_CALENDAR:
            prev = hoy - timedelta(days=30)
            self.fecha_inicio = DateEntry(bar, date_pattern='yyyy-mm-dd',
                                          year=prev.year, month=prev.month,
                                          day=prev.day, **entry_cfg)
        else:
            self.fecha_inicio = ttk.Entry(bar, **entry_cfg)
            self.fecha_inicio.insert(0, inicio_def)
        self.fecha_inicio.pack(side='left', padx=(0, 16))

        tk.Label(bar, text="Hasta:", **lbl_cfg).pack(side='left', padx=(0, 4))
        if HAS_CALENDAR:
            self.fecha_fin = DateEntry(bar, date_pattern='yyyy-mm-dd',
                                       year=hoy.year, month=hoy.month,
                                       day=hoy.day, **entry_cfg)
        else:
            self.fecha_fin = ttk.Entry(bar, **entry_cfg)
            self.fecha_fin.insert(0, fin_def)
        self.fecha_fin.pack(side='left', padx=(0, 20))

        # Bot\u00f3n generar – azul header para integrarse
        bw, bh, br = 160, 30, 8
        bc = tk.Canvas(bar, width=bw, height=bh, bg=self.BLANCO, highlightthickness=0)
        bc.pack(side='left', padx=(4, 16), pady=8)
        color_btn = self.AZUL_COBALT
        for x0, y0, x1, y1, sa, ea in [
            (0, 0, br*2, br*2, 90, 90), (bw-br*2, 0, bw, br*2, 0, 90),
            (0, bh-br*2, br*2, bh, 180, 90), (bw-br*2, bh-br*2, bw, bh, 270, 90)]:
            bc.create_arc(x0, y0, x1, y1, start=sa, extent=ea,
                          fill=color_btn, outline=color_btn)
        bc.create_rectangle(br, 0, bw-br, bh, fill=color_btn, outline=color_btn)
        bc.create_rectangle(0, br, bw, bh-br, fill=color_btn, outline=color_btn)
        bc.create_text(bw//2, bh//2, text="\U0001f50d Generar Reporte",
                       font=('Segoe UI', 9, 'bold'), fill='white')
        bc.configure(cursor='hand2')
        bc.bind('<Button-1>', lambda e: self._generar())

    # ── Generar / recargar ──────────────────────────────────────────────────
    def _generar(self):
        for w in self.body.winfo_children():
            w.destroy()

        inicio = self.fecha_inicio.get()
        fin = self.fecha_fin.get()

        try:
            d = self.reportes_service.reporte_rentabilidad(inicio, fin)
        except Exception as e:
            messagebox.showerror("Error", f"Error al generar reporte: {e}")
            return

        margen = d.get('margen_utilidad', 0)
        utilidad = d.get('utilidad_bruta', 0)
        ingresos = d.get('ingresos_ventas', 0)
        costos = d.get('costo_ventas', 0)
        color_util = self.VERDE_CLARO if utilidad >= 0 else self.ROJO
        color_margen = self.VERDE if margen >= 30 else (self.NARANJA if margen >= 0 else self.ROJO)

        tarjetas = [
            ("\U0001f4b0", "Ingresos Ventas", self._fmt(ingresos), self.VERDE),
            ("\U0001f69a", "Costo Ventas", self._fmt(costos), self.NARANJA),
            ("\U0001f4c8", "Utilidad Bruta", self._fmt(utilidad), color_util),
            ("\u2b06\ufe0f", "Margen Utilidad", f"{round(margen, 2)}%", color_margen),
        ]

        # ── Fila de tarjetas KPI ──
        cards = tk.Frame(self.body, bg=self.GRIS_BG)
        cards.pack(fill='x', padx=28, pady=(4, 0))
        for i in range(4):
            cards.columnconfigure(i, weight=1, uniform='rcard')
        for i, (icono, etiqueta, valor, color) in enumerate(tarjetas):
            self._crear_tarjeta(cards, icono, etiqueta, valor, color, i)

        # Pie con rango
        tk.Label(self.body, text=f"Periodo: {inicio}  a  {fin}",
                 font=('Segoe UI', 8), bg=self.GRIS_BG,
                 fg=self.TEXTO_LIGHT).pack(pady=(6, 4))

        # ── Fila inferior: gr\u00e1fica + top 5 productos ──
        bottom = tk.Frame(self.body, bg=self.GRIS_BG)
        bottom.pack(fill='both', expand=True, padx=28, pady=(0, 16))
        bottom.columnconfigure(0, weight=1)
        bottom.columnconfigure(1, weight=1)

        self._crear_grafica(bottom, ingresos, costos, utilidad, 0)
        self._crear_top_productos(bottom, inicio, fin, 1)

    # ── Tarjeta KPI ─────────────────────────────────────────────────────────
    def _crear_tarjeta(self, parent, icono, etiqueta, valor, color_acento, col):
        outer = tk.Frame(parent, bg=self.SOMBRA, padx=1, pady=1)
        outer.grid(row=0, column=col, padx=5, pady=3, sticky='nsew')

        card = tk.Frame(outer, bg=self.BLANCO, height=self.CARD_H)
        card.pack(fill='both', expand=True)
        card.pack_propagate(False)

        inner = tk.Frame(card, bg=self.BLANCO)
        inner.pack(fill='both', expand=True, padx=12, pady=8)

        tk.Frame(inner, bg=color_acento, height=3).pack(fill='x', pady=(0, 6))

        top = tk.Frame(inner, bg=self.BLANCO, height=18)
        top.pack(anchor='w', fill='x')
        top.pack_propagate(False)
        tk.Label(top, text=icono, font=('Segoe UI', 10), bg=self.BLANCO).pack(side='left')
        tk.Label(top, text=etiqueta, font=('Segoe UI', 8),
                 bg=self.BLANCO, fg=self.TEXTO_LIGHT).pack(side='left', padx=(4, 0))

        fs = 18 if len(valor) <= 8 else (14 if len(valor) <= 12 else 12)
        tk.Label(inner, text=valor, font=('Segoe UI', fs, 'bold'),
                 bg=self.BLANCO, fg=color_acento).pack(anchor='w', pady=(3, 0))

    # ── Gr\u00e1fica de barras (Canvas) ─────────────────────────────────────────
    def _crear_grafica(self, parent, ingresos, costos, utilidad, col):
        outer = tk.Frame(parent, bg=self.SOMBRA, padx=1, pady=1)
        outer.grid(row=0, column=col, padx=(0, 6), pady=4, sticky='nsew')

        panel = tk.Frame(outer, bg=self.BLANCO)
        panel.pack(fill='both', expand=True)

        tk.Label(panel, text="Ingresos vs Costos vs Utilidad",
                 font=('Segoe UI', 9, 'bold'), bg=self.BLANCO,
                 fg=self.TEXTO).pack(pady=(10, 4))

        cw, ch = 400, 180
        canvas = tk.Canvas(panel, width=cw, height=ch, bg=self.BLANCO,
                           highlightthickness=0)
        canvas.pack(padx=12, pady=(0, 10))

        max_val = max(ingresos, costos, utilidad, 1)
        bar_w = 70
        gap = 40
        total_w = 3 * bar_w + 2 * gap
        x_start = (cw - total_w) // 2
        y_base = ch - 30

        bars = [
            ("Ingresos", ingresos, self.VERDE),
            ("Costos", costos, self.NARANJA),
            ("Utilidad", utilidad, self.VERDE_CLARO),
        ]

        for i, (label, val, color) in enumerate(bars):
            x0 = x_start + i * (bar_w + gap)
            x1 = x0 + bar_w
            bar_h = max(int((val / max_val) * (y_base - 20)), 4) if max_val > 0 else 4
            y0 = y_base - bar_h

            canvas.create_rectangle(x0, y0, x1, y_base, fill=color, outline='')
            canvas.create_text((x0 + x1) // 2, y0 - 8, text=self._fmt_short(val),
                               font=('Segoe UI', 8, 'bold'), fill=color)
            canvas.create_text((x0 + x1) // 2, y_base + 14, text=label,
                               font=('Segoe UI', 8), fill=self.TEXTO_SEC)

    # ── Top 5 productos vendidos ────────────────────────────────────────────
    def _crear_top_productos(self, parent, inicio, fin, col):
        outer = tk.Frame(parent, bg=self.SOMBRA, padx=1, pady=1)
        outer.grid(row=0, column=col, padx=(6, 0), pady=4, sticky='nsew')

        panel = tk.Frame(outer, bg=self.BLANCO)
        panel.pack(fill='both', expand=True)

        tk.Label(panel, text="\U0001f3c6 Top 5 Productos del Periodo",
                 font=('Segoe UI', 9, 'bold'), bg=self.BLANCO,
                 fg=self.TEXTO).pack(pady=(10, 6))

        try:
            datos = self.reportes_service.reporte_productos_mas_vendidos(inicio, fin, limite=5)
            productos = datos.get('productos', datos) if isinstance(datos, dict) else datos
            if isinstance(productos, dict):
                productos = productos.get('productos', [])
        except Exception:
            productos = []

        # Encabezado de tabla
        hdr = tk.Frame(panel, bg='#eef2f7')
        hdr.pack(fill='x', padx=10)
        for j, (txt, w) in enumerate([("Producto", 22), ("Cant.", 6), ("Monto", 12)]):
            tk.Label(hdr, text=txt, font=('Segoe UI', 8, 'bold'), bg='#eef2f7',
                     fg=self.TEXTO_SEC, width=w, anchor='w').pack(side='left', padx=2, pady=3)

        if not productos:
            tk.Label(panel, text="Sin datos en este periodo",
                     font=('Segoe UI', 8), bg=self.BLANCO,
                     fg=self.TEXTO_LIGHT).pack(pady=20)
            return

        for i, p in enumerate(productos[:5]):
            bg_row = self.BLANCO if i % 2 == 0 else '#f8fafc'
            row = tk.Frame(panel, bg=bg_row)
            row.pack(fill='x', padx=10)

            nombre = p.get('nombre', '?')
            if len(nombre) > 22:
                nombre = nombre[:20] + '..'
            cant = p.get('cantidad_vendida', 0)
            monto = p.get('monto_total', 0)

            tk.Label(row, text=nombre, font=('Segoe UI', 8), bg=bg_row,
                     fg=self.TEXTO, width=22, anchor='w').pack(side='left', padx=2, pady=2)
            tk.Label(row, text=str(int(cant)), font=('Segoe UI', 8), bg=bg_row,
                     fg=self.TEXTO, width=6, anchor='w').pack(side='left', padx=2, pady=2)
            tk.Label(row, text=self._fmt_short(monto), font=('Segoe UI', 8, 'bold'),
                     bg=bg_row, fg=self.AZUL_COBALT, width=12, anchor='w').pack(side='left', padx=2, pady=2)

    # ── Utilidades ──────────────────────────────────────────────────────────
    @staticmethod
    def _fmt(v):
        try:
            return f"${float(v):,.2f}"
        except (ValueError, TypeError):
            return "$0.00"

    @staticmethod
    def _fmt_short(v):
        try:
            v = float(v)
            if v >= 1_000_000:
                return f"${v/1_000_000:,.1f}M"
            elif v >= 1_000:
                return f"${v:,.0f}"
            return f"${v:,.2f}"
        except (ValueError, TypeError):
            return "$0"

    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportaci\u00f3n en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresi\u00f3n en desarrollo.")


# ═══════════════════════════════════════════════════════════════════════════════
#  VENTANA CUENTAS POR COBRAR – TABLA PROFESIONAL
# ═══════════════════════════════════════════════════════════════════════════════

class VentanaCuentasCobrar:
    """Dashboard de Cuentas por Cobrar con KPIs, búsqueda y tabla profesional."""

    AZUL_HEADER = '#1e40af'
    AZUL_COBALT = '#2563eb'
    VERDE = '#059669'
    VERDE_CLARO = '#d1fae5'
    NARANJA = '#f59e0b'
    NARANJA_CLARO = '#fef3c7'
    ROJO = '#ef4444'
    ROJO_CLARO = '#fee2e2'
    GRIS_BG = '#f1f5f9'
    BLANCO = '#ffffff'
    TEXTO = '#0f172a'
    TEXTO_SEC = '#64748b'
    TEXTO_LIGHT = '#94a3b8'
    SOMBRA = '#e2e8f0'
    FILA_ALT = '#f8fafc'
    HOVER = '#eef2ff'

    COLUMNAS = [
        ('factura',    'Factura',        100),
        ('cliente',    'Cliente',        160),
        ('vencimiento','Vencimiento',    100),
        ('dias',       'Días Venc.',     70),
        ('monto',      'Monto Total',    110),
        ('saldo',      'Saldo Pend.',    110),
        ('estado',     'Estado',          80),
    ]

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service
        self.datos_raw = []

        self.window = tk.Toplevel(parent)
        self.window.title("📋 Cuentas por Cobrar")
        self.window.geometry("980x600")
        self.window.configure(bg=self.GRIS_BG)
        self.window.transient(parent)
        self.window.resizable(False, False)

        self._crear_header()
        self.kpi_frame = tk.Frame(self.window, bg=self.GRIS_BG)
        self.kpi_frame.pack(fill='x', padx=24, pady=(12, 4))
        self._crear_busqueda()
        self._crear_tabla()
        self._cargar()

    # ── Header ────────────────────────────────────────────────────────────────────────
    def _crear_header(self):
        header = tk.Frame(self.window, bg=self.AZUL_HEADER, height=50)
        header.pack(fill='x')
        header.pack_propagate(False)

        tk.Label(header, text="📋  Cuentas por Cobrar",
                 font=('Segoe UI', 14, 'bold'), bg=self.AZUL_HEADER,
                 fg='white').pack(side='left', padx=20)

        for texto, cmd in [("🖨️ Imprimir", self._imprimir),
                           ("📤 Exportar", self._exportar)]:
            self._btn_round(header, texto, cmd)

    def _btn_round(self, parent, texto, comando):
        w, h, r = 108, 26, 8
        c = tk.Canvas(parent, width=w, height=h, bg=self.AZUL_HEADER,
                      highlightthickness=0)
        c.pack(side='right', padx=(0, 6), pady=12)
        for x0, y0, x1, y1, sa, ea in [
            (0, 0, r*2, r*2, 90, 90), (w-r*2, 0, w, r*2, 0, 90),
            (0, h-r*2, r*2, h, 180, 90), (w-r*2, h-r*2, w, h, 270, 90)]:
            c.create_arc(x0, y0, x1, y1, start=sa, extent=ea,
                         fill='white', outline='white')
        c.create_rectangle(r, 0, w-r, h, fill='white', outline='white')
        c.create_rectangle(0, r, w, h-r, fill='white', outline='white')
        c.create_text(w//2, h//2, text=texto, font=('Segoe UI', 9),
                      fill=self.AZUL_HEADER)
        c.configure(cursor='hand2')
        c.bind('<Button-1>', lambda e: comando())

    # ── KPIs resumen ─────────────────────────────────────────────────────────────────
    def _dibujar_kpis(self, datos):
        for w in self.kpi_frame.winfo_children():
            w.destroy()

        total_cobrar = sum(float(r.get('saldo_pendiente', 0) or 0) for r in datos)
        clientes_mora = len(set(r.get('cliente_nombre', '') for r in datos
                                if float(r.get('dias_vencidos', 0) or 0) > 0))

        kpis = [
            ("💰", "Total por Cobrar", f"${total_cobrar:,.2f}", self.ROJO),
            ("⚠️", "Clientes en Mora", str(clientes_mora), self.NARANJA),
            ("📄", "Facturas Pendientes", str(len(datos)), self.AZUL_COBALT),
        ]

        for i in range(3):
            self.kpi_frame.columnconfigure(i, weight=1, uniform='kpi')

        for i, (icono, label, valor, color) in enumerate(kpis):
            outer = tk.Frame(self.kpi_frame, bg=self.SOMBRA, padx=1, pady=1)
            outer.grid(row=0, column=i, padx=5, pady=2, sticky='nsew')
            card = tk.Frame(outer, bg=self.BLANCO)
            card.pack(fill='both', expand=True)
            inner = tk.Frame(card, bg=self.BLANCO)
            inner.pack(fill='both', expand=True, padx=14, pady=8)
            tk.Frame(inner, bg=color, height=3).pack(fill='x', pady=(0, 5))
            top = tk.Frame(inner, bg=self.BLANCO)
            top.pack(anchor='w')
            tk.Label(top, text=icono, font=('Segoe UI', 10), bg=self.BLANCO).pack(side='left')
            tk.Label(top, text=label, font=('Segoe UI', 8),
                     bg=self.BLANCO, fg=self.TEXTO_LIGHT).pack(side='left', padx=(4, 0))
            fs = 18 if len(valor) <= 8 else (14 if len(valor) <= 14 else 12)
            tk.Label(inner, text=valor, font=('Segoe UI', fs, 'bold'),
                     bg=self.BLANCO, fg=color).pack(anchor='w', pady=(2, 0))

    # ── Búsqueda rápida ──────────────────────────────────────────────────────────────
    def _crear_busqueda(self):
        bar = tk.Frame(self.window, bg=self.GRIS_BG)
        bar.pack(fill='x', padx=24, pady=(6, 4))

        tk.Label(bar, text="🔍", font=('Segoe UI', 11),
                 bg=self.GRIS_BG).pack(side='left')
        self.search_var = tk.StringVar()
        self.search_var.trace_add('write', lambda *_: self._filtrar())
        entry = tk.Entry(bar, textvariable=self.search_var, font=('Segoe UI', 10),
                         relief='solid', bd=1, width=35)
        entry.pack(side='left', padx=(4, 0), ipady=3)
        tk.Label(bar, text="Buscar por cliente o factura",
                 font=('Segoe UI', 8), bg=self.GRIS_BG,
                 fg=self.TEXTO_LIGHT).pack(side='left', padx=(8, 0))

    # ── Tabla ─────────────────────────────────────────────────────────────────────────
    def _crear_tabla(self):
        container = tk.Frame(self.window, bg=self.BLANCO)
        container.pack(fill='both', expand=True, padx=24, pady=(2, 16))

        # Encabezado
        hdr_frame = tk.Frame(container, bg='#e2e8f0')
        hdr_frame.pack(fill='x')
        for _, titulo, ancho in self.COLUMNAS:
            tk.Label(hdr_frame, text=titulo, font=('Segoe UI', 9, 'bold'),
                     bg='#e2e8f0', fg=self.TEXTO, width=ancho // 8,
                     anchor='w').pack(side='left', padx=4, pady=6)

        # Cuerpo con scroll vertical
        body_wrapper = tk.Frame(container, bg=self.BLANCO)
        body_wrapper.pack(fill='both', expand=True)

        canvas = tk.Canvas(body_wrapper, bg=self.BLANCO, highlightthickness=0)
        canvas.pack(side='left', fill='both', expand=True)

        vsb = ttk.Scrollbar(body_wrapper, orient='vertical', command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)

        self.table_inner = tk.Frame(canvas, bg=self.BLANCO)
        canvas.create_window((0, 0), window=self.table_inner, anchor='nw')
        self.table_inner.bind('<Configure>',
            lambda e: canvas.configure(scrollregion=canvas.bbox('all')))
        canvas.bind_all('<MouseWheel>',
            lambda e: canvas.yview_scroll(int(-1*(e.delta/120)), 'units'))

        self._canvas = canvas
        self._vsb = vsb

    # ── Cargar datos ─────────────────────────────────────────────────────────────────
    def _cargar(self):
        try:
            self.datos_raw = self.reportes_service.reporte_cuentas_por_cobrar()
        except Exception as e:
            messagebox.showerror("Error", f"Error al cargar datos: {e}")
            self.datos_raw = []
        self._dibujar_kpis(self.datos_raw)
        self._renderizar(self.datos_raw)

    def _filtrar(self):
        q = self.search_var.get().lower().strip()
        if not q:
            filtrados = self.datos_raw
        else:
            filtrados = [r for r in self.datos_raw
                         if q in str(r.get('cliente_nombre', '')).lower()
                         or q in str(r.get('numero_factura', '')).lower()]
        self._dibujar_kpis(filtrados)
        self._renderizar(filtrados)

    # ── Renderizar filas ─────────────────────────────────────────────────────────────
    def _renderizar(self, datos):
        for w in self.table_inner.winfo_children():
            w.destroy()

        # Mostrar scrollbar solo si hay muchas filas
        if len(datos) > 8:
            self._vsb.pack(side='right', fill='y')
        else:
            self._vsb.pack_forget()

        if not datos:
            tk.Label(self.table_inner, text="No se encontraron cuentas pendientes",
                     font=('Segoe UI', 10), bg=self.BLANCO,
                     fg=self.TEXTO_LIGHT).pack(pady=40)
            return

        for i, r in enumerate(datos):
            bg = self.BLANCO if i % 2 == 0 else self.FILA_ALT
            row = tk.Frame(self.table_inner, bg=bg)
            row.pack(fill='x')

            # Hover efecto
            def on_enter(e, f=row):
                for child in f.winfo_children():
                    child.configure(bg=self.HOVER)
                f.configure(bg=self.HOVER)
            def on_leave(e, f=row, b=bg):
                for child in f.winfo_children():
                    try:
                        child.configure(bg=b)
                    except tk.TclError:
                        pass
                f.configure(bg=b)
            row.bind('<Enter>', on_enter)
            row.bind('<Leave>', on_leave)

            factura = str(r.get('numero_factura', '-'))
            cliente = str(r.get('cliente_nombre', '-'))
            if len(cliente) > 20:
                cliente = cliente[:18] + '..'
            venc_raw = str(r.get('fecha_vencimiento', ''))
            vencimiento = venc_raw[:10] if len(venc_raw) >= 10 else venc_raw
            dias = float(r.get('dias_vencidos', 0) or 0)
            monto = float(r.get('monto_total', 0) or 0)
            saldo = float(r.get('saldo_pendiente', 0) or 0)
            estado = str(r.get('estado', 'PENDIENTE'))

            # Color semáforo para días vencidos
            if dias > 60:
                dias_fg = self.ROJO
            elif dias > 30:
                dias_fg = self.NARANJA
            else:
                dias_fg = self.TEXTO

            celdas = [
                (factura, 100//8, self.AZUL_COBALT, 'normal'),
                (cliente, 160//8, self.TEXTO, 'normal'),
                (vencimiento, 100//8, self.TEXTO, 'normal'),
                (f"{int(dias)}d", 70//8, dias_fg, 'bold'),
                (f"${monto:,.2f}", 110//8, self.TEXTO, 'normal'),
                (f"${saldo:,.2f}", 110//8, self.ROJO if saldo > 0 else self.VERDE, 'bold'),
            ]

            for texto, ancho, fg, peso in celdas:
                lbl = tk.Label(row, text=texto, font=('Segoe UI', 9, peso),
                               bg=bg, fg=fg, width=ancho, anchor='w')
                lbl.pack(side='left', padx=4, pady=5)
                lbl.bind('<Enter>', on_enter)
                lbl.bind('<Leave>', on_leave)

            # Badge de estado
            if estado == 'PENDIENTE':
                badge_bg = self.ROJO_CLARO
                badge_fg = self.ROJO
            elif estado == 'PAGADO':
                badge_bg = self.VERDE_CLARO
                badge_fg = self.VERDE
            else:
                badge_bg = self.NARANJA_CLARO
                badge_fg = self.NARANJA

            badge = tk.Label(row, text=f" {estado} ", font=('Segoe UI', 8, 'bold'),
                             bg=badge_bg, fg=badge_fg, relief='flat', padx=6, pady=1)
            badge.pack(side='left', padx=4, pady=5)
            badge.bind('<Enter>', on_enter)
            badge.bind('<Leave>', on_leave)

    # ── Utilidades ─────────────────────────────────────────────────────────────────
    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportación en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresión en desarrollo.")



# ═══════════════════════════════════════════════════════════════════════════════
#  VENTANA ROTACIÓN DE INVENTARIO – TABLA ANALÍTICA
# ═══════════════════════════════════════════════════════════════════════════════

class VentanaRotacionInventario:
    """Dashboard analítico de Rotación de Inventario con KPIs, tabla y semáforo."""

    AZUL_HEADER  = '#1e40af'
    AZUL_COBALT  = '#2563eb'
    VERDE        = '#059669'
    VERDE_BG     = '#d1fae5'
    AMARILLO     = '#d97706'
    AMARILLO_BG  = '#fef3c7'
    ROJO         = '#ef4444'
    ROJO_BG      = '#fee2e2'
    GRIS_BG      = '#f1f5f9'
    BLANCO       = '#ffffff'
    TEXTO        = '#0f172a'
    TEXTO_SEC    = '#64748b'
    TEXTO_LIGHT  = '#94a3b8'
    SOMBRA       = '#e2e8f0'
    FILA_ALT     = '#f8fafc'
    HOVER        = '#eef2ff'
    BADGE_BG     = '#e2e8f0'
    BADGE_FG     = '#475569'

    COLS = [
        ('producto',  'Producto',          170),
        ('categoria', 'Categor\u00eda',    110),
        ('stock',     'Stock',              60),
        ('vendidas',  'Vendidas',           70),
        ('rotacion',  '\u00cdndice Rot.',   80),
        ('status',    'Estatus',            90),
        ('barra',     'Desempe\u00f1o',    110),
    ]

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service
        self.datos_raw = []
        self.sort_asc = False          # clic en encabezado alterna

        self.window = tk.Toplevel(parent)
        self.window.title("\U0001f504 Rotaci\u00f3n de Inventario")
        self.window.geometry("980x620")
        self.window.configure(bg=self.GRIS_BG)
        self.window.transient(parent)
        self.window.resizable(False, False)

        self._crear_header()
        self.kpi_frame = tk.Frame(self.window, bg=self.GRIS_BG)
        self.kpi_frame.pack(fill='x', padx=24, pady=(12, 4))
        self._crear_busqueda()
        self._crear_tabla()
        self._cargar()

    # ── Header ──────────────────────────────────────────────────────────────────
    def _crear_header(self):
        header = tk.Frame(self.window, bg=self.AZUL_HEADER, height=50)
        header.pack(fill='x')
        header.pack_propagate(False)
        tk.Label(header, text="\U0001f504  Rotaci\u00f3n de Inventario",
                 font=('Segoe UI', 14, 'bold'), bg=self.AZUL_HEADER,
                 fg='white').pack(side='left', padx=20)
        for texto, cmd in [("\U0001f5a8\ufe0f Imprimir", self._imprimir),
                           ("\U0001f4e4 Exportar", self._exportar)]:
            self._btn_round(header, texto, cmd)

    def _btn_round(self, parent, texto, comando):
        w, h, r = 108, 26, 8
        c = tk.Canvas(parent, width=w, height=h, bg=self.AZUL_HEADER,
                      highlightthickness=0)
        c.pack(side='right', padx=(0, 6), pady=12)
        for x0, y0, x1, y1, sa, ea in [
            (0, 0, r*2, r*2, 90, 90), (w-r*2, 0, w, r*2, 0, 90),
            (0, h-r*2, r*2, h, 180, 90), (w-r*2, h-r*2, w, h, 270, 90)]:
            c.create_arc(x0, y0, x1, y1, start=sa, extent=ea,
                         fill='white', outline='white')
        c.create_rectangle(r, 0, w-r, h, fill='white', outline='white')
        c.create_rectangle(0, r, w, h-r, fill='white', outline='white')
        c.create_text(w//2, h//2, text=texto, font=('Segoe UI', 9),
                      fill=self.AZUL_HEADER)
        c.configure(cursor='hand2')
        c.bind('<Button-1>', lambda e: comando())

    # ── KPIs ────────────────────────────────────────────────────────────────────
    def _dibujar_kpis(self, datos):
        for w in self.kpi_frame.winfo_children():
            w.destroy()

        # Producto Estrella
        estrella = '-'
        if datos:
            mejor = max(datos, key=lambda d: float(d.get('indice_rotacion', 0) or 0))
            estrella = str(mejor.get('nombre', '-'))
            if len(estrella) > 18:
                estrella = estrella[:16] + '..'

        # Promedio de Rotación
        indices = [float(d.get('indice_rotacion', 0) or 0) for d in datos]
        promedio = sum(indices) / len(indices) if indices else 0

        # Stock Crítico (< 5 unidades)
        critico = sum(1 for d in datos if int(d.get('stock_actual', 0) or 0) < 5)

        kpis = [
            ("\u2b50", "Producto Estrella", estrella, self.AZUL_COBALT),
            ("\U0001f4ca", "Promedio Rotaci\u00f3n", f"{promedio:.2f}", self.VERDE),
            ("\u26a0\ufe0f", "Stock Cr\u00edtico (<5)", str(critico), self.ROJO),
        ]

        for i in range(3):
            self.kpi_frame.columnconfigure(i, weight=1, uniform='kpi')

        for i, (icono, label, valor, color) in enumerate(kpis):
            outer = tk.Frame(self.kpi_frame, bg=self.SOMBRA, padx=1, pady=1)
            outer.grid(row=0, column=i, padx=5, pady=2, sticky='nsew')
            card = tk.Frame(outer, bg=self.BLANCO)
            card.pack(fill='both', expand=True)
            inner = tk.Frame(card, bg=self.BLANCO)
            inner.pack(fill='both', expand=True, padx=14, pady=8)
            tk.Frame(inner, bg=color, height=3).pack(fill='x', pady=(0, 5))
            top = tk.Frame(inner, bg=self.BLANCO)
            top.pack(anchor='w')
            tk.Label(top, text=icono, font=('Segoe UI', 10),
                     bg=self.BLANCO).pack(side='left')
            tk.Label(top, text=label, font=('Segoe UI', 8),
                     bg=self.BLANCO, fg=self.TEXTO_LIGHT).pack(side='left', padx=(4, 0))
            fs = 18 if len(valor) <= 8 else (14 if len(valor) <= 14 else 12)
            tk.Label(inner, text=valor, font=('Segoe UI', fs, 'bold'),
                     bg=self.BLANCO, fg=color).pack(anchor='w', pady=(2, 0))

    # ── Búsqueda ────────────────────────────────────────────────────────────────
    def _crear_busqueda(self):
        bar = tk.Frame(self.window, bg=self.GRIS_BG)
        bar.pack(fill='x', padx=24, pady=(6, 4))
        tk.Label(bar, text="\U0001f50d", font=('Segoe UI', 11),
                 bg=self.GRIS_BG).pack(side='left')
        self.search_var = tk.StringVar()
        self.search_var.trace_add('write', lambda *_: self._filtrar())
        entry = tk.Entry(bar, textvariable=self.search_var, font=('Segoe UI', 10),
                         relief='solid', bd=1, width=30)
        entry.pack(side='left', padx=(4, 0), ipady=3)
        tk.Label(bar, text="Buscar por categor\u00eda o marca",
                 font=('Segoe UI', 8), bg=self.GRIS_BG,
                 fg=self.TEXTO_LIGHT).pack(side='left', padx=(8, 0))

    # ── Tabla ───────────────────────────────────────────────────────────────────
    def _crear_tabla(self):
        container = tk.Frame(self.window, bg=self.BLANCO)
        container.pack(fill='both', expand=True, padx=24, pady=(2, 16))

        # Encabezado
        hdr = tk.Frame(container, bg=self.SOMBRA)
        hdr.pack(fill='x')
        for key, titulo, ancho in self.COLS:
            lbl = tk.Label(hdr, text=titulo, font=('Segoe UI', 9, 'bold'),
                           bg=self.SOMBRA, fg=self.TEXTO, width=ancho // 8,
                           anchor='w', cursor='hand2')
            lbl.pack(side='left', padx=4, pady=6)
            if key == 'rotacion':
                lbl.bind('<Button-1>', lambda e: self._sort_rotacion())

        # Cuerpo con scroll
        body = tk.Frame(container, bg=self.BLANCO)
        body.pack(fill='both', expand=True)
        self._canvas = tk.Canvas(body, bg=self.BLANCO, highlightthickness=0)
        self._canvas.pack(side='left', fill='both', expand=True)
        self._vsb = ttk.Scrollbar(body, orient='vertical', command=self._canvas.yview)
        self._canvas.configure(yscrollcommand=self._vsb.set)
        self.table_inner = tk.Frame(self._canvas, bg=self.BLANCO)
        self._canvas.create_window((0, 0), window=self.table_inner, anchor='nw')
        self.table_inner.bind('<Configure>',
            lambda e: self._canvas.configure(scrollregion=self._canvas.bbox('all')))
        self._canvas.bind_all('<MouseWheel>',
            lambda e: self._canvas.yview_scroll(int(-1*(e.delta/120)), 'units'))

    # ── Datos ───────────────────────────────────────────────────────────────────
    def _cargar(self):
        try:
            self.datos_raw = self.reportes_service.rotacion_inventario()
        except Exception as e:
            messagebox.showerror("Error", f"Error al cargar datos: {e}")
            self.datos_raw = []
        self._dibujar_kpis(self.datos_raw)
        self._renderizar(self.datos_raw)

    def _filtrar(self):
        q = self.search_var.get().lower().strip()
        if not q:
            filtrados = self.datos_raw
        else:
            filtrados = [r for r in self.datos_raw
                         if q in str(r.get('categoria', '')).lower()
                         or q in str(r.get('marca', '')).lower()
                         or q in str(r.get('nombre', '')).lower()]
        self._dibujar_kpis(filtrados)
        self._renderizar(filtrados)

    def _sort_rotacion(self):
        self.sort_asc = not self.sort_asc
        datos = sorted(self.datos_raw,
                        key=lambda d: float(d.get('indice_rotacion', 0) or 0),
                        reverse=not self.sort_asc)
        self.datos_raw = datos
        self._filtrar()

    # ── Renderizar ──────────────────────────────────────────────────────────────
    def _renderizar(self, datos):
        for w in self.table_inner.winfo_children():
            w.destroy()

        if len(datos) > 8:
            self._vsb.pack(side='right', fill='y')
        else:
            self._vsb.pack_forget()

        if not datos:
            tk.Label(self.table_inner, text="No se encontraron productos",
                     font=('Segoe UI', 10), bg=self.BLANCO,
                     fg=self.TEXTO_LIGHT).pack(pady=40)
            return

        # Máximo índice para escala de barra
        max_rot = max(float(d.get('indice_rotacion', 0) or 0) for d in datos)
        if max_rot == 0:
            max_rot = 1

        for i, r in enumerate(datos):
            bg = self.BLANCO if i % 2 == 0 else self.FILA_ALT
            row = tk.Frame(self.table_inner, bg=bg)
            row.pack(fill='x')

            def on_enter(e, f=row):
                for ch in f.winfo_children():
                    try: ch.configure(bg=self.HOVER)
                    except tk.TclError: pass
                f.configure(bg=self.HOVER)
            def on_leave(e, f=row, b=bg):
                for ch in f.winfo_children():
                    try: ch.configure(bg=b)
                    except tk.TclError: pass
                f.configure(bg=b)
            row.bind('<Enter>', on_enter)
            row.bind('<Leave>', on_leave)

            nombre = str(r.get('nombre', '-'))
            marca  = str(r.get('marca', ''))
            prod_txt = f"{nombre}"
            if marca:
                prod_txt += f"  ({marca})"
            if len(prod_txt) > 24:
                prod_txt = prod_txt[:22] + '..'

            cat    = str(r.get('categoria', '-'))
            stock  = int(r.get('stock_actual', 0) or 0)
            vend   = int(r.get('unidades_vendidas', 0) or 0)
            rot    = float(r.get('indice_rotacion', 0) or 0)

            # Semáforo
            if rot >= 3:
                status_txt, s_bg, s_fg = 'Alta', self.VERDE_BG, self.VERDE
            elif rot >= 1:
                status_txt, s_bg, s_fg = 'Media', self.AMARILLO_BG, self.AMARILLO
            else:
                status_txt, s_bg, s_fg = 'Baja', self.ROJO_BG, self.ROJO

            # Stock color
            stock_fg = self.ROJO if stock < 5 else self.TEXTO

            # Producto
            lbl_prod = tk.Label(row, text=prod_txt, font=('Segoe UI', 9),
                                bg=bg, fg=self.TEXTO, width=170//8, anchor='w')
            lbl_prod.pack(side='left', padx=4, pady=5)
            lbl_prod.bind('<Enter>', on_enter); lbl_prod.bind('<Leave>', on_leave)

            # Categoría badge
            cat_frame = tk.Frame(row, bg=bg, width=110)
            cat_frame.pack(side='left', padx=4, pady=5)
            cat_frame.pack_propagate(False)
            cat_short = cat if len(cat) <= 14 else cat[:12] + '..'
            badge_cat = tk.Label(cat_frame, text=f" {cat_short} ",
                                 font=('Segoe UI', 8), bg=self.BADGE_BG,
                                 fg=self.BADGE_FG, padx=4, pady=1)
            badge_cat.pack(anchor='w', pady=2)
            cat_frame.bind('<Enter>', on_enter); cat_frame.bind('<Leave>', on_leave)

            # Stock
            lbl_stock = tk.Label(row, text=str(stock), font=('Segoe UI', 9, 'bold'),
                                 bg=bg, fg=stock_fg, width=60//8, anchor='center')
            lbl_stock.pack(side='left', padx=4, pady=5)
            lbl_stock.bind('<Enter>', on_enter); lbl_stock.bind('<Leave>', on_leave)

            # Vendidas
            lbl_vend = tk.Label(row, text=str(vend), font=('Segoe UI', 9),
                                bg=bg, fg=self.TEXTO, width=70//8, anchor='center')
            lbl_vend.pack(side='left', padx=4, pady=5)
            lbl_vend.bind('<Enter>', on_enter); lbl_vend.bind('<Leave>', on_leave)

            # Índice Rotación
            lbl_rot = tk.Label(row, text=f"{rot:.2f}", font=('Segoe UI', 10, 'bold'),
                               bg=bg, fg=s_fg, width=80//8, anchor='center')
            lbl_rot.pack(side='left', padx=4, pady=5)
            lbl_rot.bind('<Enter>', on_enter); lbl_rot.bind('<Leave>', on_leave)

            # Estatus badge
            stat_frame = tk.Frame(row, bg=bg, width=90)
            stat_frame.pack(side='left', padx=4, pady=5)
            stat_frame.pack_propagate(False)
            badge_st = tk.Label(stat_frame, text=f" {status_txt} ",
                                font=('Segoe UI', 8, 'bold'),
                                bg=s_bg, fg=s_fg, padx=6, pady=1)
            badge_st.pack(anchor='w', pady=2)
            stat_frame.bind('<Enter>', on_enter); stat_frame.bind('<Leave>', on_leave)

            # Barra de desempeño
            bar_frame = tk.Frame(row, bg=bg, width=110, height=22)
            bar_frame.pack(side='left', padx=4, pady=5)
            bar_frame.pack_propagate(False)
            bar_canvas = tk.Canvas(bar_frame, width=100, height=14,
                                   bg='#f1f5f9', highlightthickness=0)
            bar_canvas.pack(anchor='w', pady=3)
            pct = min(rot / max_rot, 1.0)
            bar_w = int(pct * 96)
            if bar_w > 0:
                bar_canvas.create_rectangle(2, 2, 2 + bar_w, 12,
                                            fill=s_fg, outline=s_fg)

    # ── Utilidades ──────────────────────────────────────────────────────────────
    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportaci\u00f3n en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresi\u00f3n en desarrollo.")



# ═══════════════════════════════════════════════════════════════════════════════
#  VENTANA FLUJO DE CAJA – DASHBOARD ANALÍTICO
# ═══════════════════════════════════════════════════════════════════════════════

class VentanaFlujoCajaDashboard:
    """Dashboard de Flujo de Caja con KPIs, desglose, gráfica de tendencia."""

    AZUL_HEADER  = '#1e40af'
    AZUL_COBALT  = '#2563eb'
    VERDE        = '#059669'
    VERDE_CLARO  = '#d1fae5'
    NARANJA      = '#d97706'
    NARANJA_CLARO= '#fef3c7'
    ROJO         = '#ef4444'
    ROJO_CLARO   = '#fee2e2'
    GRIS_BG      = '#f1f5f9'
    BLANCO       = '#ffffff'
    TEXTO        = '#0f172a'
    TEXTO_SEC    = '#64748b'
    TEXTO_LIGHT  = '#94a3b8'
    SOMBRA       = '#e2e8f0'
    FILA_ALT     = '#f8fafc'

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service
        self.datos = None

        self.window = tk.Toplevel(parent)
        self.window.title("\U0001f4b5 Flujo de Caja")
        self.window.geometry("1020x640")
        self.window.configure(bg=self.GRIS_BG)
        self.window.transient(parent)
        self.window.resizable(False, False)

        self._crear_header()
        self._crear_filtros()

        # Contenedor principal (se llena al generar)
        self.main_area = tk.Frame(self.window, bg=self.GRIS_BG)
        self.main_area.pack(fill='both', expand=True, padx=24, pady=(0, 16))

        # Auto-generar último mes
        self._generar()

    # ── Header ──────────────────────────────────────────────────────────────────
    def _crear_header(self):
        h = tk.Frame(self.window, bg=self.AZUL_HEADER, height=50)
        h.pack(fill='x'); h.pack_propagate(False)
        tk.Label(h, text="\U0001f4b5  Flujo de Caja",
                 font=('Segoe UI', 14, 'bold'), bg=self.AZUL_HEADER,
                 fg='white').pack(side='left', padx=20)
        for txt, cmd in [("\U0001f5a8\ufe0f Imprimir", self._imprimir),
                         ("\U0001f4e4 Exportar", self._exportar)]:
            self._btn_round(h, txt, cmd)

    def _btn_round(self, parent, texto, comando):
        w, h, r = 108, 26, 8
        c = tk.Canvas(parent, width=w, height=h, bg=self.AZUL_HEADER,
                      highlightthickness=0)
        c.pack(side='right', padx=(0, 6), pady=12)
        for x0, y0, x1, y1, sa, ea in [
            (0, 0, r*2, r*2, 90, 90), (w-r*2, 0, w, r*2, 0, 90),
            (0, h-r*2, r*2, h, 180, 90), (w-r*2, h-r*2, w, h, 270, 90)]:
            c.create_arc(x0, y0, x1, y1, start=sa, extent=ea,
                         fill='white', outline='white')
        c.create_rectangle(r, 0, w-r, h, fill='white', outline='white')
        c.create_rectangle(0, r, w, h-r, fill='white', outline='white')
        c.create_text(w//2, h//2, text=texto, font=('Segoe UI', 9),
                      fill=self.AZUL_HEADER)
        c.configure(cursor='hand2')
        c.bind('<Button-1>', lambda e: comando())

    # ── Filtros ─────────────────────────────────────────────────────────────────
    def _crear_filtros(self):
        bar = tk.Frame(self.window, bg=self.GRIS_BG)
        bar.pack(fill='x', padx=24, pady=(10, 4))

        from datetime import datetime, timedelta
        hoy = datetime.now()
        hace30 = (hoy - timedelta(days=30)).strftime('%Y-%m-%d')
        hoy_str = hoy.strftime('%Y-%m-%d')

        tk.Label(bar, text="Desde:", font=('Segoe UI', 10, 'bold'),
                 bg=self.GRIS_BG, fg=self.TEXTO).pack(side='left')
        self.desde_var = tk.StringVar(value=hace30)
        ttk.Entry(bar, textvariable=self.desde_var, font=('Segoe UI', 10),
                  width=12).pack(side='left', padx=(4, 12))

        tk.Label(bar, text="Hasta:", font=('Segoe UI', 10, 'bold'),
                 bg=self.GRIS_BG, fg=self.TEXTO).pack(side='left')
        self.hasta_var = tk.StringVar(value=hoy_str)
        ttk.Entry(bar, textvariable=self.hasta_var, font=('Segoe UI', 10),
                  width=12).pack(side='left', padx=(4, 12))

        btn = tk.Button(bar, text="\U0001f50d Generar Reporte",
                        font=('Segoe UI', 10, 'bold'), bg=self.AZUL_COBALT,
                        fg='white', relief='flat', cursor='hand2',
                        padx=16, pady=4, command=self._generar)
        btn.pack(side='left', padx=4)

    # ── Generar ─────────────────────────────────────────────────────────────────
    def _generar(self):
        for w in self.main_area.winfo_children():
            w.destroy()

        desde = self.desde_var.get().strip()
        hasta = self.hasta_var.get().strip()

        try:
            self.datos = self.reportes_service.flujo_caja(desde, hasta)
        except Exception as e:
            messagebox.showerror("Error", f"Error al generar reporte: {e}")
            return

        d = self.datos
        ing = d['ingresos']
        egr = d['egresos']
        neto = d['flujo_neto']

        # ── KPI cards ──
        self._dibujar_kpis(ing['total'], egr['total'], neto)

        # ── Cuerpo: dos columnas ──
        body = tk.Frame(self.main_area, bg=self.GRIS_BG)
        body.pack(fill='both', expand=True, pady=(8, 0))
        body.columnconfigure(0, weight=1, uniform='fc')
        body.columnconfigure(1, weight=1, uniform='fc')

        # Columna izquierda: desglose
        self._crear_desglose(body, ing, egr, neto)

        # Columna derecha: gráfica + ventas diarias
        self._crear_grafica_y_tabla(body, d['ventas_diarias'])

    # ── KPIs ────────────────────────────────────────────────────────────────────
    def _dibujar_kpis(self, ingresos, egresos, neto):
        kpi_frame = tk.Frame(self.main_area, bg=self.GRIS_BG)
        kpi_frame.pack(fill='x', pady=(4, 0))
        for i in range(3):
            kpi_frame.columnconfigure(i, weight=1, uniform='kpi')

        neto_color = self.VERDE if neto >= 0 else self.ROJO
        kpis = [
            ("\U0001f4c8", "Total Ingresos", f"${ingresos:,.0f}", self.VERDE),
            ("\U0001f4c9", "Total Egresos", f"${egresos:,.0f}", self.ROJO),
            ("\U0001f4b0", "Flujo Neto", f"${neto:,.0f}", neto_color),
        ]

        for i, (icono, label, valor, color) in enumerate(kpis):
            outer = tk.Frame(kpi_frame, bg=self.SOMBRA, padx=1, pady=1)
            outer.grid(row=0, column=i, padx=5, pady=2, sticky='nsew')
            card = tk.Frame(outer, bg=self.BLANCO)
            card.pack(fill='both', expand=True)
            inner = tk.Frame(card, bg=self.BLANCO)
            inner.pack(fill='both', expand=True, padx=14, pady=8)
            tk.Frame(inner, bg=color, height=3).pack(fill='x', pady=(0, 5))
            top = tk.Frame(inner, bg=self.BLANCO)
            top.pack(anchor='w')
            tk.Label(top, text=icono, font=('Segoe UI', 10),
                     bg=self.BLANCO).pack(side='left')
            tk.Label(top, text=label, font=('Segoe UI', 8),
                     bg=self.BLANCO, fg=self.TEXTO_LIGHT).pack(side='left', padx=(4, 0))
            fs = 18 if len(valor) <= 10 else (14 if len(valor) <= 14 else 12)
            tk.Label(inner, text=valor, font=('Segoe UI', fs, 'bold'),
                     bg=self.BLANCO, fg=color).pack(anchor='w', pady=(2, 0))

    # ── Desglose ────────────────────────────────────────────────────────────────
    def _crear_desglose(self, parent, ing, egr, neto):
        outer = tk.Frame(parent, bg=self.SOMBRA, padx=1, pady=1)
        outer.grid(row=0, column=0, padx=(0, 6), sticky='nsew')
        card = tk.Frame(outer, bg=self.BLANCO)
        card.pack(fill='both', expand=True)
        inner = tk.Frame(card, bg=self.BLANCO)
        inner.pack(fill='both', expand=True, padx=16, pady=12)

        tk.Label(inner, text="Desglose de Movimientos",
                 font=('Segoe UI', 11, 'bold'), bg=self.BLANCO,
                 fg=self.TEXTO).pack(anchor='w', pady=(0, 8))

        # Ingresos
        tk.Label(inner, text="\U0001f4c8 Ingresos", font=('Segoe UI', 10, 'bold'),
                 bg=self.BLANCO, fg=self.VERDE).pack(anchor='w', pady=(4, 2))
        self._fila_desglose(inner, "Ventas", ing['ventas'], self.TEXTO)
        self._fila_desglose(inner, "Abonos Cobrados", ing['abonos_cobrados'], self.TEXTO)
        tk.Frame(inner, bg=self.SOMBRA, height=1).pack(fill='x', pady=2)
        self._fila_desglose(inner, "Total Ingresos", ing['total'], self.VERDE, bold=True)

        # Separador
        tk.Frame(inner, bg=self.GRIS_BG, height=2).pack(fill='x', pady=8)

        # Egresos
        tk.Label(inner, text="\U0001f4c9 Egresos", font=('Segoe UI', 10, 'bold'),
                 bg=self.BLANCO, fg=self.ROJO).pack(anchor='w', pady=(4, 2))
        self._fila_desglose(inner, "Compras", egr['compras'], self.TEXTO)
        # Desglose por categoría de gastos
        for cat in egr.get('gastos_por_categoria', []):
            nombre = cat.get('categoria', 'Otros')
            monto = cat.get('total', 0)
            self._fila_desglose(inner, f"  {nombre}", monto, self.TEXTO)
        if not egr.get('gastos_por_categoria'):
            self._fila_desglose(inner, "Gastos Operativos", egr['gastos'], self.TEXTO)
        tk.Frame(inner, bg=self.SOMBRA, height=1).pack(fill='x', pady=2)
        self._fila_desglose(inner, "Total Egresos", egr['total'], self.ROJO, bold=True)

        # Separador grueso
        tk.Frame(inner, bg=self.AZUL_COBALT, height=2).pack(fill='x', pady=10)

        # Flujo Neto
        neto_color = self.VERDE if neto >= 0 else self.ROJO
        row = tk.Frame(inner, bg=self.BLANCO)
        row.pack(fill='x')
        tk.Label(row, text="\U0001f4b0 Flujo Neto", font=('Segoe UI', 12, 'bold'),
                 bg=self.BLANCO, fg=self.TEXTO).pack(side='left')
        tk.Label(row, text=f"${neto:,.0f}", font=('Segoe UI', 14, 'bold'),
                 bg=self.BLANCO, fg=neto_color).pack(side='right')

    def _fila_desglose(self, parent, concepto, monto, fg, bold=False):
        row = tk.Frame(parent, bg=self.BLANCO)
        row.pack(fill='x', pady=1)
        peso = 'bold' if bold else 'normal'
        tk.Label(row, text=concepto, font=('Segoe UI', 9, peso),
                 bg=self.BLANCO, fg=self.TEXTO_SEC if not bold else fg).pack(side='left', padx=(12, 0))
        tk.Label(row, text=f"${monto:,.0f}", font=('Segoe UI', 9, peso),
                 bg=self.BLANCO, fg=fg).pack(side='right')

    # ── Gráfica + Tabla ventas diarias ──────────────────────────────────────────
    def _crear_grafica_y_tabla(self, parent, ventas_diarias):
        outer = tk.Frame(parent, bg=self.SOMBRA, padx=1, pady=1)
        outer.grid(row=0, column=1, padx=(6, 0), sticky='nsew')
        card = tk.Frame(outer, bg=self.BLANCO)
        card.pack(fill='both', expand=True)
        inner = tk.Frame(card, bg=self.BLANCO)
        inner.pack(fill='both', expand=True, padx=16, pady=12)

        tk.Label(inner, text="Ventas Diarias",
                 font=('Segoe UI', 11, 'bold'), bg=self.BLANCO,
                 fg=self.TEXTO).pack(anchor='w', pady=(0, 6))

        # Gráfica de barras
        if ventas_diarias:
            self._dibujar_grafica(inner, ventas_diarias)

        # Tabla
        tk.Frame(inner, bg=self.SOMBRA, height=1).pack(fill='x', pady=(8, 4))

        # Encabezados
        hdr = tk.Frame(inner, bg=self.SOMBRA)
        hdr.pack(fill='x')
        tk.Label(hdr, text="Fecha", font=('Segoe UI', 9, 'bold'),
                 bg=self.SOMBRA, fg=self.TEXTO, width=14, anchor='w').pack(side='left', padx=4, pady=4)
        tk.Label(hdr, text="Monto", font=('Segoe UI', 9, 'bold'),
                 bg=self.SOMBRA, fg=self.TEXTO, width=14, anchor='e').pack(side='right', padx=4, pady=4)

        # Filas
        if not ventas_diarias:
            tk.Label(inner, text="Sin ventas en el periodo",
                     font=('Segoe UI', 9), bg=self.BLANCO,
                     fg=self.TEXTO_LIGHT).pack(pady=20)
        else:
            for i, vd in enumerate(ventas_diarias):
                bg = self.BLANCO if i % 2 == 0 else self.FILA_ALT
                row = tk.Frame(inner, bg=bg)
                row.pack(fill='x')
                tk.Label(row, text=vd['dia'], font=('Segoe UI', 9),
                         bg=bg, fg=self.TEXTO, width=14, anchor='w').pack(side='left', padx=4, pady=3)
                tk.Label(row, text=f"${vd['monto']:,.0f}", font=('Segoe UI', 9, 'bold'),
                         bg=bg, fg=self.AZUL_COBALT, width=14, anchor='e').pack(side='right', padx=4, pady=3)

    def _dibujar_grafica(self, parent, ventas_diarias):
        """Gráfica de barras de tendencia de ventas diarias."""
        chart_h = 120
        chart_w = 420
        canvas = tk.Canvas(parent, width=chart_w, height=chart_h,
                           bg=self.BLANCO, highlightthickness=0)
        canvas.pack(anchor='w', pady=(0, 4))

        if not ventas_diarias:
            return

        montos = [float(v['monto']) for v in ventas_diarias]
        max_m = max(montos) if montos else 1
        if max_m == 0:
            max_m = 1

        n = len(montos)
        padding_l = 10
        padding_r = 10
        padding_t = 12
        padding_b = 22
        usable_w = chart_w - padding_l - padding_r
        usable_h = chart_h - padding_t - padding_b

        bar_gap = 2
        bar_w = max(4, min(30, (usable_w - bar_gap * (n - 1)) // n)) if n > 0 else 20
        total_bars_w = n * bar_w + (n - 1) * bar_gap
        offset_x = padding_l + (usable_w - total_bars_w) // 2

        # Línea base
        base_y = chart_h - padding_b
        canvas.create_line(padding_l, base_y, chart_w - padding_r, base_y,
                           fill=self.SOMBRA, width=1)

        # Líneas de referencia
        for pct in [0.25, 0.5, 0.75]:
            y = base_y - int(usable_h * pct)
            canvas.create_line(padding_l, y, chart_w - padding_r, y,
                               fill='#f1f5f9', width=1, dash=(2, 4))

        for i, m in enumerate(montos):
            x = offset_x + i * (bar_w + bar_gap)
            h = int((m / max_m) * usable_h)
            if h < 2:
                h = 2
            y_top = base_y - h

            # Color gradiente por intensidad
            pct = m / max_m
            if pct >= 0.7:
                color = self.VERDE
            elif pct >= 0.4:
                color = self.AZUL_COBALT
            else:
                color = self.TEXTO_LIGHT

            canvas.create_rectangle(x, y_top, x + bar_w, base_y,
                                    fill=color, outline=color)

            # Label de fecha (solo si caben)
            if n <= 15:
                dia_label = ventas_diarias[i]['dia'][-5:]  # MM-DD
                canvas.create_text(x + bar_w // 2, base_y + 10,
                                   text=dia_label, font=('Segoe UI', 6),
                                   fill=self.TEXTO_LIGHT, anchor='center')

    # ── Utilidades ──────────────────────────────────────────────────────────────
    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportaci\u00f3n en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresi\u00f3n en desarrollo.")


class VentanaReporteConFechas:
    """Ventana de reporte que solicita rango de fechas antes de generar"""

    def __init__(self, parent, titulo, funcion_reporte, columnas_tabla=None):
        self.funcion_reporte = funcion_reporte
        self.columnas_tabla = columnas_tabla

        self.window = tk.Toplevel(parent)
        self.window.title(titulo)
        self.window.geometry("950x650")
        self.window.transient(parent)

        self.crear_interfaz(titulo)

    def crear_interfaz(self, titulo):
        """Crea la interfaz con selector de fechas"""
        # Header
        header = tk.Frame(self.window, bg=COLORS['primary'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)

        tk.Label(header, text=titulo, font=FONTS['large'],
                bg=COLORS['primary'], fg='white').pack(side='left', padx=20, pady=15)

        tk.Button(header, text=f"{ICONS['imprimir']} Imprimir",
                 font=FONTS['body'], bg='white', fg=COLORS['primary'],
                 cursor='hand2', relief='flat', padx=15, pady=5,
                 command=self.imprimir).pack(side='right', padx=5)

        tk.Button(header, text=f"{ICONS['exportar']} Exportar",
                 font=FONTS['body'], bg='white', fg=COLORS['primary'],
                 cursor='hand2', relief='flat', padx=15, pady=5,
                 command=self.exportar).pack(side='right', padx=5)

        # Panel de fechas
        fecha_frame = tk.Frame(self.window, bg=COLORS['bg_secondary'], pady=10)
        fecha_frame.pack(fill='x', padx=20, pady=(10, 0))

        tk.Label(fecha_frame, text="Desde:", font=FONTS['body_bold'],
                bg=COLORS['bg_secondary']).pack(side='left', padx=(10, 5))

        hoy = datetime.now()
        inicio_default = hoy - timedelta(days=30)

        if HAS_CALENDAR:
            self.fecha_inicio = DateEntry(fecha_frame, width=12, font=FONTS['body'],
                                          date_pattern='yyyy-mm-dd',
                                          year=inicio_default.year,
                                          month=inicio_default.month,
                                          day=inicio_default.day)
        else:
            self.fecha_inicio = ttk.Entry(fecha_frame, width=12, font=FONTS['body'])
            self.fecha_inicio.insert(0, inicio_default.strftime('%Y-%m-%d'))
        self.fecha_inicio.pack(side='left', padx=5)

        tk.Label(fecha_frame, text="Hasta:", font=FONTS['body_bold'],
                bg=COLORS['bg_secondary']).pack(side='left', padx=(15, 5))

        if HAS_CALENDAR:
            self.fecha_fin = DateEntry(fecha_frame, width=12, font=FONTS['body'],
                                       date_pattern='yyyy-mm-dd',
                                       year=hoy.year, month=hoy.month, day=hoy.day)
        else:
            self.fecha_fin = ttk.Entry(fecha_frame, width=12, font=FONTS['body'])
            self.fecha_fin.insert(0, hoy.strftime('%Y-%m-%d'))
        self.fecha_fin.pack(side='left', padx=5)

        tk.Button(fecha_frame, text="🔍 Generar Reporte",
                 font=FONTS['body_bold'], bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat', padx=20, pady=5,
                 command=self.cargar_reporte).pack(side='left', padx=15)

        # Área de contenido
        content_frame = tk.Frame(self.window, bg='white')
        content_frame.pack(fill='both', expand=True, padx=20, pady=10)

        scroll_y = ttk.Scrollbar(content_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')

        self.text = tk.Text(content_frame, font=('Courier New', 10),
                           wrap='word', yscrollcommand=scroll_y.set,
                           bg='white', relief='flat')
        self.text.pack(fill='both', expand=True)
        scroll_y.config(command=self.text.yview)

        # Cargar con fechas por defecto
        self.cargar_reporte()

    def cargar_reporte(self):
        """Carga el reporte con las fechas seleccionadas"""
        try:
            inicio = self.fecha_inicio.get()
            fin = self.fecha_fin.get()

            datos = self.funcion_reporte(inicio, fin)

            self.text.config(state='normal')
            self.text.delete('1.0', 'end')

            if isinstance(datos, dict):
                texto = VentanaReporte.formatear_dict(self, datos)
            elif isinstance(datos, list):
                texto = VentanaReporte.formatear_lista(self, datos)
            else:
                texto = str(datos)

            self.text.insert('1.0', texto)
            self.text.config(state='disabled')

        except Exception as e:
            messagebox.showerror("Error", f"Error al generar reporte: {str(e)}")

    def formatear_dict(self, datos, nivel=0):
        return VentanaReporte.formatear_dict(self, datos, nivel)

    def formatear_lista(self, datos, nivel=0):
        return VentanaReporte.formatear_lista(self, datos, nivel)

    def imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresión en desarrollo")

    def exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportación en desarrollo")


class VentanaComparativa:
    """Ventana especializada para comparar dos períodos"""

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service

        self.window = tk.Toplevel(parent)
        self.window.title("📊 Comparativa de Períodos")
        self.window.geometry("1000x650")
        self.window.transient(parent)

        self.crear_interfaz()

    def crear_interfaz(self):
        # Header
        header = tk.Frame(self.window, bg=COLORS['warning'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        tk.Label(header, text="📊 Comparativa de Períodos", font=FONTS['large'],
                bg=COLORS['warning'], fg='white').pack(side='left', padx=20, pady=15)

        # Panel de selección de períodos
        sel_frame = tk.Frame(self.window, bg=COLORS['bg_secondary'], pady=10)
        sel_frame.pack(fill='x', padx=20, pady=(10, 0))

        hoy = datetime.now()
        hace_30 = hoy - timedelta(days=30)
        hace_60 = hoy - timedelta(days=60)
        hace_31 = hoy - timedelta(days=31)

        # Período 1
        tk.Label(sel_frame, text="Período 1 →", font=FONTS['body_bold'],
                bg=COLORS['bg_secondary'], fg=COLORS['primary']).grid(row=0, column=0, padx=5, pady=5)
        tk.Label(sel_frame, text="Desde:", font=FONTS['body'],
                bg=COLORS['bg_secondary']).grid(row=0, column=1, padx=3)

        if HAS_CALENDAR:
            self.p1_inicio = DateEntry(sel_frame, width=11, font=FONTS['body'],
                                       date_pattern='yyyy-mm-dd',
                                       year=hace_30.year, month=hace_30.month, day=hace_30.day)
        else:
            self.p1_inicio = ttk.Entry(sel_frame, width=11)
            self.p1_inicio.insert(0, hace_30.strftime('%Y-%m-%d'))
        self.p1_inicio.grid(row=0, column=2, padx=3)

        tk.Label(sel_frame, text="Hasta:", font=FONTS['body'],
                bg=COLORS['bg_secondary']).grid(row=0, column=3, padx=3)
        if HAS_CALENDAR:
            self.p1_fin = DateEntry(sel_frame, width=11, font=FONTS['body'],
                                    date_pattern='yyyy-mm-dd',
                                    year=hoy.year, month=hoy.month, day=hoy.day)
        else:
            self.p1_fin = ttk.Entry(sel_frame, width=11)
            self.p1_fin.insert(0, hoy.strftime('%Y-%m-%d'))
        self.p1_fin.grid(row=0, column=4, padx=3)

        # Período 2
        tk.Label(sel_frame, text="Período 2 →", font=FONTS['body_bold'],
                bg=COLORS['bg_secondary'], fg=COLORS['danger']).grid(row=1, column=0, padx=5, pady=5)
        tk.Label(sel_frame, text="Desde:", font=FONTS['body'],
                bg=COLORS['bg_secondary']).grid(row=1, column=1, padx=3)

        if HAS_CALENDAR:
            self.p2_inicio = DateEntry(sel_frame, width=11, font=FONTS['body'],
                                       date_pattern='yyyy-mm-dd',
                                       year=hace_60.year, month=hace_60.month, day=hace_60.day)
        else:
            self.p2_inicio = ttk.Entry(sel_frame, width=11)
            self.p2_inicio.insert(0, hace_60.strftime('%Y-%m-%d'))
        self.p2_inicio.grid(row=1, column=2, padx=3)

        tk.Label(sel_frame, text="Hasta:", font=FONTS['body'],
                bg=COLORS['bg_secondary']).grid(row=1, column=3, padx=3)
        if HAS_CALENDAR:
            self.p2_fin = DateEntry(sel_frame, width=11, font=FONTS['body'],
                                    date_pattern='yyyy-mm-dd',
                                    year=hace_31.year, month=hace_31.month, day=hace_31.day)
        else:
            self.p2_fin = ttk.Entry(sel_frame, width=11)
            self.p2_fin.insert(0, hace_31.strftime('%Y-%m-%d'))
        self.p2_fin.grid(row=1, column=4, padx=3)

        tk.Button(sel_frame, text="🔍 Comparar", font=FONTS['body_bold'],
                 bg=COLORS['warning'], fg='white', cursor='hand2', relief='flat',
                 padx=20, pady=8, command=self.comparar).grid(row=0, column=5, rowspan=2, padx=15)

        # Área de resultados
        self.result_frame = tk.Frame(self.window, bg='white')
        self.result_frame.pack(fill='both', expand=True, padx=20, pady=10)

        self.comparar()

    def comparar(self):
        """Ejecuta la comparativa"""
        try:
            datos = self.reportes_service.comparativa_periodos(
                self.p1_inicio.get(), self.p1_fin.get(),
                self.p2_inicio.get(), self.p2_fin.get()
            )

            # Limpiar resultados previos
            for w in self.result_frame.winfo_children():
                w.destroy()

            p1 = datos['periodo_1']
            p2 = datos['periodo_2']
            var = datos['variacion_porcentual']

            # Título
            tk.Label(self.result_frame, text="Resultados de la Comparativa",
                    font=FONTS['heading'], bg='white').pack(pady=10)

            # Cards de comparación
            cards_frame = tk.Frame(self.result_frame, bg='white')
            cards_frame.pack(fill='x', padx=20, pady=10)

            metricas = [
                ('Total Ventas', 'total_ventas', '', COLORS['primary']),
                ('Monto Total', 'monto_total', '$', COLORS['success']),
                ('Promedio Venta', 'promedio_venta', '$', COLORS['info']),
                ('Utilidad', 'utilidad', '$', COLORS['warning']),
            ]

            for i, (label, key, prefix, color) in enumerate(metricas):
                card = tk.Frame(cards_frame, bg=COLORS['bg_secondary'], relief='solid', borderwidth=1, padx=15, pady=10)
                card.grid(row=0, column=i, padx=8, sticky='nsew')
                cards_frame.columnconfigure(i, weight=1)

                tk.Label(card, text=label, font=FONTS['body_bold'],
                        bg=COLORS['bg_secondary'], fg=COLORS['text_secondary']).pack()

                val1 = p1.get(key, 0)
                val2 = p2.get(key, 0)
                fmt1 = f"{prefix}{val1:,.2f}" if isinstance(val1, float) else f"{prefix}{val1}"
                fmt2 = f"{prefix}{val2:,.2f}" if isinstance(val2, float) else f"{prefix}{val2}"

                tk.Label(card, text=f"P1: {fmt1}", font=FONTS['body'],
                        bg=COLORS['bg_secondary'], fg=color).pack()
                tk.Label(card, text=f"P2: {fmt2}", font=FONTS['body'],
                        bg=COLORS['bg_secondary'], fg=COLORS['danger']).pack()

                # Variación
                v = var.get(key, 0)
                v_color = COLORS['success'] if v >= 0 else COLORS['danger']
                v_sign = "▲" if v >= 0 else "▼"
                tk.Label(card, text=f"{v_sign} {v:+.1f}%", font=FONTS['body_bold'],
                        bg=COLORS['bg_secondary'], fg=v_color).pack(pady=(5, 0))

            # Rangos
            info_frame = tk.Frame(self.result_frame, bg='white')
            info_frame.pack(fill='x', padx=20, pady=15)
            tk.Label(info_frame, text=f"Período 1: {p1['rango']}  |  Período 2: {p2['rango']}",
                    font=FONTS['body'], bg='white', fg=COLORS['text_secondary']).pack()

        except Exception as e:
            messagebox.showerror("Error", f"Error al comparar períodos: {str(e)}")


class VentanaVentasPeriodo:
    """Ventana profesional de Reporte de Ventas por Período con KPIs y DataGrid"""

    # Colores corporativos
    AZUL = '#1e3a5f'
    AZUL_CLARO = '#2563eb'
    AZUL_HEADER = '#1e40af'
    VERDE = '#059669'
    VERDE_CLARO = '#10b981'
    GRIS_BG = '#f1f5f9'
    GRIS_FILA = '#f8fafc'
    BLANCO = '#ffffff'
    TEXTO = '#0f172a'
    TEXTO_SEC = '#64748b'

    def __init__(self, parent, reportes_service):
        self.reportes_service = reportes_service
        self.datos = None
        self.ventas_list = []

        self.window = tk.Toplevel(parent)
        self.window.title("📊 Reporte de Ventas por Período")
        self.window.geometry("1100x720")
        self.window.minsize(900, 600)
        self.window.transient(parent)
        self.window.configure(bg=self.GRIS_BG)

        self._crear_interfaz()
        self.window.focus_set()
        self._cargar_datos()

    # ─── INTERFAZ PRINCIPAL ───────────────────────────────────────────

    def _crear_interfaz(self):
        # ── BARRA SUPERIOR (Header + filtros) ─────────────────────────
        top_bar = tk.Frame(self.window, bg=self.AZUL)
        top_bar.pack(fill='x')

        # Título
        titulo_frame = tk.Frame(top_bar, bg=self.AZUL)
        titulo_frame.pack(fill='x', padx=25, pady=(12, 0))
        tk.Label(titulo_frame, text="📊 Reporte de Ventas por Período",
                font=('Segoe UI', 17, 'bold'), bg=self.AZUL, fg='white').pack(side='left')

        # Botones exportar / imprimir
        btn_frame_top = tk.Frame(titulo_frame, bg=self.AZUL)
        btn_frame_top.pack(side='right')
        for txt, icono, cmd in [("Exportar", "📤", self._exportar), ("Imprimir", "🖨️", self._imprimir)]:
            b = tk.Button(btn_frame_top, text=f"{icono} {txt}", font=('Segoe UI', 9),
                         bg='white', fg=self.AZUL, relief='flat', cursor='hand2',
                         padx=14, pady=3, command=cmd)
            b.pack(side='left', padx=4)
            b.bind('<Enter>', lambda e, w=b: w.configure(bg='#e0e7ff'))
            b.bind('<Leave>', lambda e, w=b: w.configure(bg='white'))

        # Fila de filtros
        filtro_frame = tk.Frame(top_bar, bg=self.AZUL)
        filtro_frame.pack(fill='x', padx=25, pady=(10, 12))

        hoy = datetime.now()
        inicio_def = hoy - timedelta(days=30)

        tk.Label(filtro_frame, text="Desde:", font=('Segoe UI', 10, 'bold'),
                bg=self.AZUL, fg='#93c5fd').pack(side='left')
        if HAS_CALENDAR:
            self.fecha_inicio = DateEntry(filtro_frame, width=12,
                                          font=('Segoe UI', 10), date_pattern='yyyy-mm-dd',
                                          year=inicio_def.year, month=inicio_def.month, day=inicio_def.day)
        else:
            self.fecha_inicio = tk.Entry(filtro_frame, width=13, font=('Segoe UI', 10),
                                         relief='flat', highlightthickness=1,
                                         highlightbackground='#94a3b8')
            self.fecha_inicio.insert(0, inicio_def.strftime('%Y-%m-%d'))
        self.fecha_inicio.pack(side='left', padx=(6, 16))

        tk.Label(filtro_frame, text="Hasta:", font=('Segoe UI', 10, 'bold'),
                bg=self.AZUL, fg='#93c5fd').pack(side='left')
        if HAS_CALENDAR:
            self.fecha_fin = DateEntry(filtro_frame, width=12,
                                       font=('Segoe UI', 10), date_pattern='yyyy-mm-dd',
                                       year=hoy.year, month=hoy.month, day=hoy.day)
        else:
            self.fecha_fin = tk.Entry(filtro_frame, width=13, font=('Segoe UI', 10),
                                      relief='flat', highlightthickness=1,
                                      highlightbackground='#94a3b8')
            self.fecha_fin.insert(0, hoy.strftime('%Y-%m-%d'))
        self.fecha_fin.pack(side='left', padx=(6, 20))

        self._generando = False
        self.btn_generar = tk.Button(filtro_frame, text="🔍  Generar Reporte",
                               font=('Segoe UI', 11, 'bold'), bg=self.VERDE, fg='white',
                               activebackground=self.VERDE_CLARO, activeforeground='white',
                               relief='flat', cursor='hand2', padx=22, pady=4,
                               command=self._on_generar_click)
        self.btn_generar.pack(side='left')
        self.btn_generar.bind('<Enter>', lambda e: self.btn_generar.configure(bg=self.VERDE_CLARO) if not self._generando else None)
        self.btn_generar.bind('<Leave>', lambda e: self.btn_generar.configure(bg=self.VERDE) if not self._generando else None)

        # Permitir Enter en campos de fecha para refrescar
        self.fecha_inicio.bind('<Return>', lambda e: self._on_generar_click())
        self.fecha_fin.bind('<Return>', lambda e: self._on_generar_click())

        # ── ÁREA DE KPIs ──────────────────────────────────────────────
        self.kpi_frame = tk.Frame(self.window, bg=self.GRIS_BG)
        self.kpi_frame.pack(fill='x', padx=20, pady=(15, 5))

        # ── TABLA DE DATOS ────────────────────────────────────────────
        tabla_container = tk.Frame(self.window, bg='white', relief='solid', borderwidth=1)
        tabla_container.pack(fill='both', expand=True, padx=20, pady=(5, 12))

        # Label de conteo
        self.lbl_conteo = tk.Label(tabla_container, text="",
                                    font=('Segoe UI', 9), bg='white', fg=self.TEXTO_SEC,
                                    anchor='w')
        self.lbl_conteo.pack(fill='x', padx=15, pady=(8, 0))

        # Treeview con scrollbar
        tree_frame = tk.Frame(tabla_container, bg='white')
        tree_frame.pack(fill='both', expand=True, padx=10, pady=(4, 10))

        scroll_y = ttk.Scrollbar(tree_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')

        columnas = ('id', 'factura', 'fecha', 'cliente', 'total', 'metodo', 'estado')
        self.tree = ttk.Treeview(tree_frame, columns=columnas, show='headings',
                                  yscrollcommand=scroll_y.set, height=18)
        scroll_y.config(command=self.tree.yview)

        # Configurar estilo de Treeview (sin cambiar tema global)
        style = ttk.Style()
        style.configure('Ventas.Treeview',
                        font=('Segoe UI', 10),
                        rowheight=32,
                        background='white',
                        fieldbackground='white',
                        foreground=self.TEXTO)
        style.configure('Ventas.Treeview.Heading',
                        font=('Segoe UI', 10, 'bold'),
                        background=self.AZUL_HEADER,
                        foreground='white',
                        relief='flat',
                        padding=(8, 6))
        style.map('Ventas.Treeview.Heading',
                  background=[('active', self.AZUL_CLARO)])
        style.map('Ventas.Treeview',
                  background=[('selected', '#dbeafe')],
                  foreground=[('selected', self.AZUL)])
        self.tree.configure(style='Ventas.Treeview')

        # Definir columnas
        col_config = [
            ('id',       'ID',              60,  'center'),
            ('factura',  'N° Factura',      140, 'center'),
            ('fecha',    'Fecha',           130, 'center'),
            ('cliente',  'Cliente',         180, 'w'),
            ('total',    'Total',           110, 'e'),
            ('metodo',   'Método de Pago',  120, 'center'),
            ('estado',   'Estado',          100, 'center'),
        ]
        for col_id, heading, width, anchor in col_config:
            self.tree.heading(col_id, text=heading)
            self.tree.column(col_id, width=width, minwidth=50, anchor=anchor)

        self.tree.pack(fill='both', expand=True)

        # Tags para filas alternas
        self.tree.tag_configure('par', background=self.GRIS_FILA)
        self.tree.tag_configure('impar', background='white')
        self.tree.tag_configure('completada', foreground=self.VERDE)
        self.tree.tag_configure('pendiente', foreground='#f59e0b')
        self.tree.tag_configure('anulada', foreground='#ef4444')

        # Doble clic para ver detalle
        self.tree.bind('<Double-1>', lambda e: self._ver_detalle())

        # ── BARRA DE ACCIONES INFERIOR ────────────────────────────────
        bottom_bar = tk.Frame(self.window, bg=self.GRIS_BG, height=44)
        bottom_bar.pack(fill='x', padx=20, pady=(0, 10))

        tk.Button(bottom_bar, text="👁️  Ver Detalle", font=('Segoe UI', 10, 'bold'),
                 bg=self.AZUL_CLARO, fg='white', relief='flat', cursor='hand2',
                 padx=16, pady=5, command=self._ver_detalle).pack(side='left', padx=(0, 8))

        tk.Button(bottom_bar, text="🖨️  Imprimir Factura", font=('Segoe UI', 10, 'bold'),
                 bg=self.TEXTO_SEC, fg='white', relief='flat', cursor='hand2',
                 padx=16, pady=5, command=self._imprimir_factura).pack(side='left')

        self.lbl_seleccion = tk.Label(bottom_bar, text="Seleccione una venta de la tabla",
                                       font=('Segoe UI', 9, 'italic'), bg=self.GRIS_BG,
                                       fg=self.TEXTO_SEC)
        self.lbl_seleccion.pack(side='right', padx=10)

    # ─── KPI CARDS ────────────────────────────────────────────────────

    def _dibujar_kpis(self, resumen):
        for w in self.kpi_frame.winfo_children():
            w.destroy()

        kpis = [
            ("Total Vendido",       f"$ {resumen.get('monto_total', 0):,.2f}",    self.AZUL_CLARO, "💰"),
            ("Total Impuestos",     f"$ {resumen.get('iva_total', 0):,.2f}",      "#8b5cf6",       "🧾"),
            ("N° de Facturas",      f"{resumen.get('total_ventas', 0)}",           self.VERDE,      "📋"),
            ("Venta Promedio",      f"$ {resumen.get('promedio_venta', 0):,.2f}",  "#f59e0b",       "📊"),
        ]

        for i, (titulo, valor, color, icono) in enumerate(kpis):
            card = tk.Frame(self.kpi_frame, bg='white', relief='solid', borderwidth=1,
                           padx=18, pady=12)
            card.grid(row=0, column=i, padx=8, sticky='nsew')
            self.kpi_frame.columnconfigure(i, weight=1)

            # Barra de color superior
            barra = tk.Frame(card, bg=color, height=4)
            barra.pack(fill='x', pady=(0, 8))

            # Icono + Título
            header_kpi = tk.Frame(card, bg='white')
            header_kpi.pack(fill='x')
            tk.Label(header_kpi, text=icono, font=('Segoe UI', 14),
                    bg='white').pack(side='left')
            tk.Label(header_kpi, text=titulo, font=('Segoe UI', 9),
                    bg='white', fg=self.TEXTO_SEC).pack(side='left', padx=(6, 0))

            # Valor
            tk.Label(card, text=valor, font=('Segoe UI', 18, 'bold'),
                    bg='white', fg=color, anchor='w').pack(fill='x', pady=(4, 0))

    # ─── CARGAR DATOS ─────────────────────────────────────────────────

    def _on_generar_click(self):
        """Callback del botón Generar con feedback visual"""
        if self._generando:
            return
        self._generando = True
        try:
            self.btn_generar.config(text="⏳ Cargando...", state='disabled', bg='#6b7280')
        except Exception:
            pass
        # Deferir al event loop para que el botón se actualice visualmente
        self.window.after(50, self._ejecutar_reporte)

    def _ejecutar_reporte(self):
        """Ejecuta la consulta y restaura el botón"""
        try:
            self._cargar_datos()
        except Exception as e:
            messagebox.showerror("Error", f"Error inesperado:\n{str(e)}")
        finally:
            if self.window.winfo_exists():
                self._generando = False
                try:
                    self.btn_generar.config(text="🔍  Generar Reporte", state='normal', bg=self.VERDE)
                except Exception:
                    pass

    def _cargar_datos(self):
        """Lee fechas, consulta BD, actualiza KPIs y refresca la tabla"""
        inicio = self.fecha_inicio.get().strip()
        fin = self.fecha_fin.get().strip()

        # Validar formato de fechas
        try:
            datetime.strptime(inicio, '%Y-%m-%d')
            datetime.strptime(fin, '%Y-%m-%d')
        except ValueError:
            messagebox.showwarning("Fecha inválida",
                                   "Formato de fecha incorrecto.\nUse el formato: YYYY-MM-DD\n"
                                   f"Ejemplo: {datetime.now().strftime('%Y-%m-%d')}")
            return

        if inicio > fin:
            messagebox.showwarning("Rango inválido",
                                   "La fecha 'Desde' no puede ser mayor que 'Hasta'.")
            return

        try:
            # 1. Consultar datos del servicio
            self.datos = self.reportes_service.reporte_ventas_periodo(inicio, fin)
            self.ventas_list = self.datos.get('ventas', [])
            resumen = self.datos.get('resumen', {})

            # 2. Actualizar KPIs
            self._dibujar_kpis(resumen)

            # 3. Actualizar contador
            total = len(self.ventas_list)
            self.lbl_conteo.config(
                text=f"Mostrando {total} venta{'s' if total != 1 else ''}  •  "
                     f"Período: {inicio}  →  {fin}")

            # 4. Limpiar y rellenar tabla
            self.tree.delete(*self.tree.get_children())
            for idx, v in enumerate(self.ventas_list):
                fecha_raw = v.get('fecha', '')
                if isinstance(fecha_raw, str) and len(fecha_raw) > 16:
                    fecha_fmt = fecha_raw[:16]
                else:
                    fecha_fmt = str(fecha_raw)

                total_fmt = f"$ {v.get('total', 0):,.2f}"
                cliente = v.get('cliente_nombre') or 'Público General'
                estado = v.get('estado', '')

                tag_fila = 'par' if idx % 2 == 0 else 'impar'

                self.tree.insert('', 'end', iid=str(v.get('id', idx)),
                                values=(
                                    v.get('id', ''),
                                    v.get('numero_factura', ''),
                                    fecha_fmt,
                                    cliente,
                                    total_fmt,
                                    v.get('metodo_pago', ''),
                                    estado
                                ),
                                tags=(tag_fila,))

            # 5. Feedback de éxito
            self.lbl_seleccion.config(text="✅ Reporte generado exitosamente", fg=self.VERDE)
            # Restaurar texto después de 3 segundos
            self.window.after(3000, lambda: self.lbl_seleccion.config(
                text="Seleccione una venta de la tabla", fg=self.TEXTO_SEC
            ) if self.window.winfo_exists() else None)

        except Exception as e:
            messagebox.showerror("Error", f"Error al generar reporte:\n{str(e)}")

    # ─── ACCIONES DE FILA ─────────────────────────────────────────────

    def _get_venta_seleccionada(self):
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("Atención", "Seleccione una venta de la tabla primero.")
            return None
        venta_id = int(sel[0])
        for v in self.ventas_list:
            if v.get('id') == venta_id:
                return v
        return None

    def _ver_detalle(self):
        venta = self._get_venta_seleccionada()
        if not venta:
            return
        VentanaDetalleVenta(self.window, venta, self.reportes_service)

    def _imprimir_factura(self):
        venta = self._get_venta_seleccionada()
        if not venta:
            return
        messagebox.showinfo("Imprimir",
                           f"Imprimiendo factura {venta.get('numero_factura', '')}...\n"
                           "Funcionalidad de impresión en desarrollo.")

    def _exportar(self):
        messagebox.showinfo("Exportar", "Funcionalidad de exportación en desarrollo.")

    def _imprimir(self):
        messagebox.showinfo("Imprimir", "Funcionalidad de impresión general en desarrollo.")


class VentanaDetalleVenta:
    """Popup con el detalle completo de una venta incluyendo productos"""

    AZUL = '#1e3a5f'
    VERDE = '#059669'
    GRIS_BG = '#f1f5f9'
    GRIS_FILA = '#f8fafc'
    TEXTO = '#0f172a'
    TEXTO_SEC = '#64748b'

    def __init__(self, parent, venta, reportes_service):
        self.venta = venta
        self.reportes_service = reportes_service

        self.win = tk.Toplevel(parent)
        self.win.title(f"Detalle — {venta.get('numero_factura', '')}")
        self.win.geometry("750x620")
        self.win.minsize(650, 500)
        self.win.transient(parent)
        self.win.configure(bg='white')

        self._crear_ui()
        self.win.focus_set()

    def _crear_ui(self):
        v = self.venta

        # ── Header ────────────────────────────────────────────────────
        hdr = tk.Frame(self.win, bg=self.AZUL)
        hdr.pack(fill='x')
        tk.Label(hdr, text=f"📄 Factura {v.get('numero_factura', '')}",
                font=('Segoe UI', 14, 'bold'), bg=self.AZUL, fg='white'
                ).pack(side='left', padx=20, pady=12)
        tk.Label(hdr, text=v.get('fecha', ''),
                font=('Segoe UI', 10), bg=self.AZUL, fg='#93c5fd'
                ).pack(side='right', padx=20)

        # ── Info general (2 columnas compactas) ───────────────────────
        info_frame = tk.Frame(self.win, bg=self.GRIS_BG)
        info_frame.pack(fill='x', padx=0, pady=0)

        campos_izq = [
            ("Cliente", v.get('cliente_nombre') or 'Público General'),
            ("Vendedor", v.get('vendedor', '') or '-'),
            ("Método de Pago", v.get('metodo_pago', '')),
        ]
        campos_der = [
            ("Estado", v.get('estado', '')),
            ("Estado de Pago", v.get('estado_pago', '') or '-'),
            ("ID Venta", v.get('id', '')),
        ]

        for col_idx, campos in enumerate([campos_izq, campos_der]):
            col_frame = tk.Frame(info_frame, bg=self.GRIS_BG)
            col_frame.pack(side='left', fill='x', expand=True, padx=20, pady=10)
            for label, val in campos:
                row_f = tk.Frame(col_frame, bg=self.GRIS_BG)
                row_f.pack(fill='x', pady=1)
                tk.Label(row_f, text=f"{label}:", font=('Segoe UI', 9, 'bold'),
                        bg=self.GRIS_BG, fg=self.TEXTO_SEC, width=16, anchor='w').pack(side='left')
                tk.Label(row_f, text=str(val), font=('Segoe UI', 9),
                        bg=self.GRIS_BG, fg=self.TEXTO, anchor='w').pack(side='left')

        # ── Tabla de productos ────────────────────────────────────────
        prod_label = tk.Frame(self.win, bg='white')
        prod_label.pack(fill='x', padx=20, pady=(12, 4))
        tk.Label(prod_label, text="📦 Productos vendidos",
                font=('Segoe UI', 11, 'bold'), bg='white', fg=self.AZUL).pack(side='left')

        tabla_frame = tk.Frame(self.win, bg='white', relief='solid', borderwidth=1)
        tabla_frame.pack(fill='both', expand=True, padx=20, pady=(0, 10))

        scroll = ttk.Scrollbar(tabla_frame, orient='vertical')
        scroll.pack(side='right', fill='y')

        cols = ('producto', 'cantidad', 'precio_unit', 'descuento', 'subtotal')
        self.tree = ttk.Treeview(tabla_frame, columns=cols, show='headings',
                                  yscrollcommand=scroll.set, height=8)
        scroll.config(command=self.tree.yview)

        style = ttk.Style()
        style.configure('Detalle.Treeview', font=('Segoe UI', 9), rowheight=28,
                        background='white', fieldbackground='white')
        style.configure('Detalle.Treeview.Heading', font=('Segoe UI', 9, 'bold'),
                        background=self.AZUL, foreground='white', relief='flat', padding=(6, 4))
        style.map('Detalle.Treeview.Heading', background=[('active', '#2563eb')])
        style.map('Detalle.Treeview', background=[('selected', '#dbeafe')],
                  foreground=[('selected', self.AZUL)])
        self.tree.configure(style='Detalle.Treeview')

        col_cfg = [
            ('producto',    'Producto',        250, 'w'),
            ('cantidad',    'Cantidad',         80, 'center'),
            ('precio_unit', 'Precio Unit.',    110, 'e'),
            ('descuento',   'Descuento',        90, 'e'),
            ('subtotal',    'Subtotal',        110, 'e'),
        ]
        for cid, heading, width, anc in col_cfg:
            self.tree.heading(cid, text=heading)
            self.tree.column(cid, width=width, minwidth=50, anchor=anc)

        self.tree.tag_configure('par', background=self.GRIS_FILA)
        self.tree.tag_configure('impar', background='white')
        self.tree.pack(fill='both', expand=True)

        # Cargar productos desde BD
        self._cargar_productos()

        # ── Resumen de montos ─────────────────────────────────────────
        resumen_frame = tk.Frame(self.win, bg='white')
        resumen_frame.pack(fill='x', padx=20, pady=(0, 5))

        # Lado derecho: montos alineados
        montos_frame = tk.Frame(resumen_frame, bg='white')
        montos_frame.pack(side='right')

        montos = [
            ("Subtotal", f"$ {v.get('subtotal', 0):,.2f}", ('Segoe UI', 10), self.TEXTO),
            ("Descuento", f"- $ {v.get('descuento', 0):,.2f}", ('Segoe UI', 10), '#ef4444'),
            ("IVA", f"$ {v.get('iva', 0):,.2f}", ('Segoe UI', 10), self.TEXTO),
        ]
        for label, val, font_m, color in montos:
            row_m = tk.Frame(montos_frame, bg='white')
            row_m.pack(fill='x', pady=1)
            tk.Label(row_m, text=f"{label}:", font=font_m, bg='white',
                    fg=self.TEXTO_SEC, width=12, anchor='e').pack(side='left')
            tk.Label(row_m, text=val, font=font_m, bg='white',
                    fg=color, width=14, anchor='e').pack(side='left')

        # Línea separadora antes del total
        sep_row = tk.Frame(montos_frame, bg='white')
        sep_row.pack(fill='x', pady=2)
        tk.Frame(sep_row, bg='#cbd5e1', height=1).pack(fill='x')

        total_row = tk.Frame(montos_frame, bg='white')
        total_row.pack(fill='x', pady=(2, 0))
        tk.Label(total_row, text="TOTAL:", font=('Segoe UI', 13, 'bold'), bg='white',
                fg=self.AZUL, width=12, anchor='e').pack(side='left')
        tk.Label(total_row, text=f"$ {v.get('total', 0):,.2f}",
                font=('Segoe UI', 13, 'bold'), bg='white',
                fg=self.VERDE, width=14, anchor='e').pack(side='left')

        # ── Botón cerrar ──────────────────────────────────────────────
        tk.Button(self.win, text="Cerrar", font=('Segoe UI', 10),
                 bg='#e2e8f0', fg='#334155', relief='flat', cursor='hand2',
                 padx=20, pady=5, command=self.win.destroy).pack(pady=(5, 12))

    def _cargar_productos(self):
        """Consulta los productos de esta venta desde la BD"""
        try:
            venta_id = self.venta.get('id')
            if not venta_id:
                return
            conn = self.reportes_service.db.conectar()
            cursor = conn.cursor()
            cursor.execute("""
                SELECT p.nombre, dv.cantidad, dv.precio_unitario,
                       dv.descuento, dv.subtotal
                FROM detalle_ventas dv
                JOIN productos p ON dv.producto_id = p.id
                WHERE dv.venta_id = ?
                ORDER BY dv.id
            """, (venta_id,))
            rows = cursor.fetchall()
            conn.close()

            for idx, row in enumerate(rows):
                tag = 'par' if idx % 2 == 0 else 'impar'
                self.tree.insert('', 'end', values=(
                    row['nombre'],
                    row['cantidad'],
                    f"$ {row['precio_unitario']:,.2f}",
                    f"$ {row['descuento']:,.2f}",
                    f"$ {row['subtotal']:,.2f}"
                ), tags=(tag,))

            # Actualizar label con cantidad de productos
            total_items = len(rows)
            # Buscar el label de productos y agregar contador
        except Exception as e:
            tk.Label(self.win, text=f"Error al cargar productos: {e}",
                    font=('Segoe UI', 9), bg='white', fg='#ef4444').pack()