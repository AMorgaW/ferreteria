# -*- coding: utf-8 -*-
"""
Interfaz de Usuario para Gestión de Alertas
"""
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import datetime
from ui_config import COLORS, FONTS, ICONS


class AlertasUI:
    """Interfaz para visualización y gestión de alertas"""
    
    def __init__(self, parent_frame, alertas_service):
        self.parent = parent_frame
        self.alertas_service = alertas_service
        
        self.crear_interfaz()
        self.cargar_alertas()
    
    def crear_interfaz(self):
        """Crea la interfaz principal"""
        main_frame = tk.Frame(self.parent, bg=COLORS['bg_secondary'])
        main_frame.pack(fill='both', expand=True)
        
        # Header
        header = tk.Frame(main_frame, bg=COLORS['bg_secondary'])
        header.pack(fill='x', padx=20, pady=10)
        
        tk.Label(header, text=f"{ICONS['alertas']} Centro de Alertas",
                font=FONTS['large'], bg=COLORS['bg_secondary'],
                fg=COLORS['text_primary']).pack(side='left')
        
        # Botones
        btn_frame = tk.Frame(header, bg=COLORS['bg_secondary'])
        btn_frame.pack(side='right')
        
        tk.Button(btn_frame, text="[OK] Marcar Todas como Leídas",
                 font=FONTS['body'], bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat', padx=15, pady=8,
                 command=self.marcar_todas_leidas).pack(side='left', padx=5)
        
        tk.Button(btn_frame, text=f"{ICONS['actualizar']} Actualizar",
                 font=FONTS['body'], bg=COLORS['info'], fg='white',
                 cursor='hand2', relief='flat', padx=15, pady=8,
                 command=self.cargar_alertas).pack(side='left', padx=5)
        
        # Filtros
        filtros_frame = tk.Frame(main_frame, bg=COLORS['bg_secondary'])
        filtros_frame.pack(fill='x', padx=20, pady=10)
        
        tk.Label(filtros_frame, text="Mostrar:", font=FONTS['body'],
                bg=COLORS['bg_secondary']).pack(side='left', padx=5)
        
        self.filtro_var = tk.StringVar(value='TODAS')
        filtros = ['TODAS', 'NO LEÍDAS', 'CRÍTICAS', 'ALTAS', 'MEDIAS']
        
        for filtro in filtros:
            tk.Radiobutton(filtros_frame, text=filtro, variable=self.filtro_var,
                          value=filtro, bg=COLORS['bg_secondary'],
                          font=FONTS['body'], command=self.cargar_alertas).pack(side='left', padx=5)
        
        # Contador
        self.contador_label = tk.Label(main_frame, text="",
                                       font=FONTS['body_bold'],
                                       bg=COLORS['bg_secondary'],
                                       fg=COLORS['primary'])
        self.contador_label.pack(anchor='w', padx=20, pady=5)
        
        # Lista de alertas
        lista_frame = tk.Frame(main_frame, bg='white')
        lista_frame.pack(fill='both', expand=True, padx=20, pady=10)
        
        # Scrollbar
        scroll_y = ttk.Scrollbar(lista_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')
        
        # Canvas para alertas
        self.canvas = tk.Canvas(lista_frame, bg='white',
                               yscrollcommand=scroll_y.set,
                               highlightthickness=0)
        self.canvas.pack(side='left', fill='both', expand=True)
        
        scroll_y.config(command=self.canvas.yview)
        
        # Frame interno para las alertas
        self.alertas_frame = tk.Frame(self.canvas, bg='white')
        self.canvas_window = self.canvas.create_window((0, 0), window=self.alertas_frame,
                                                       anchor='nw')
        
        # Bind para ajustar scroll
        self.alertas_frame.bind('<Configure>', 
                               lambda e: self.canvas.configure(scrollregion=self.canvas.bbox('all')))
        self.canvas.bind('<Configure>', self._on_canvas_configure)
    
    def _on_canvas_configure(self, event):
        """Ajusta el ancho del frame interno al canvas"""
        self.canvas.itemconfig(self.canvas_window, width=event.width)
    
    def cargar_alertas(self):
        """Carga y muestra las alertas"""
        # Limpiar alertas anteriores
        for widget in self.alertas_frame.winfo_children():
            widget.destroy()
        
        # Obtener filtro
        filtro = self.filtro_var.get()
        
        if filtro == 'NO LEÍDAS':
            alertas = self.alertas_service.obtener_alertas(solo_no_leidas=True)
        else:
            alertas = self.alertas_service.obtener_alertas(solo_no_leidas=False)
            
            # Filtrar por prioridad si es necesario
            if filtro in ['CRÍTICAS', 'ALTAS', 'MEDIAS']:
                prioridad_map = {'CRÍTICAS': 'CRITICA', 'ALTAS': 'ALTA', 'MEDIAS': 'MEDIA'}
                alertas = [a for a in alertas if a.prioridad == prioridad_map[filtro]]
        
        # Actualizar contador
        total = len(alertas)
        no_leidas = len([a for a in alertas if not a.leida])
        self.contador_label.config(
            text=f"[REPORTE] Total: {total} alertas | [ALERTA] Sin leer: {no_leidas}"
        )
        
        # Mostrar alertas
        if not alertas:
            tk.Label(self.alertas_frame, 
                    text="[OK] No hay alertas",
                    font=FONTS['heading'],
                    bg='white', fg=COLORS['text_light']).pack(pady=50)
        else:
            for alerta in alertas:
                self.crear_tarjeta_alerta(alerta)
    
    def crear_tarjeta_alerta(self, alerta):
        """Crea una tarjeta visual para una alerta"""
        # Frame principal de la tarjeta
        card = tk.Frame(self.alertas_frame, bg='white',
                       relief='solid', borderwidth=1)
        card.pack(fill='x', padx=10, pady=5)
        
        # Color según prioridad
        colores = {
            'CRITICA': COLORS['danger'],
            'ALTA': COLORS['warning'],
            'MEDIA': COLORS['info'],
            'BAJA': COLORS['secondary']
        }
        color = colores.get(alerta.prioridad, COLORS['secondary'])
        
        # Barra de color
        barra = tk.Frame(card, bg=color, height=5)
        barra.pack(fill='x')
        
        # Contenido
        content = tk.Frame(card, bg='white' if alerta.leida else '#f0f9ff')
        content.pack(fill='both', expand=True, padx=15, pady=10)
        
        # Header de la alerta
        header_alerta = tk.Frame(content, bg=content['bg'])
        header_alerta.pack(fill='x')
        
        # Tipo e icono
        iconos_tipo = {
            'STOCK_BAJO': '📦',
            'STOCK_CRITICO': '[AVISO]',
            'VENCIMIENTO': '📅',
            'COBRO': '💰',
            'SISTEMA': 'ℹ️'
        }
        icono = iconos_tipo.get(alerta.tipo, '[ALERTA]')
        
        tk.Label(header_alerta, text=f"{icono} {alerta.titulo}",
                font=FONTS['body_bold'], bg=content['bg'],
                fg=COLORS['text_primary']).pack(side='left')
        
        # Fecha
        try:
            fecha = datetime.fromisoformat(alerta.fecha_creacion).strftime('%d/%m/%Y %H:%M')
        except:
            fecha = alerta.fecha_creacion
        
        tk.Label(header_alerta, text=fecha,
                font=FONTS['small'], bg=content['bg'],
                fg=COLORS['text_light']).pack(side='right')
        
        # Mensaje
        tk.Label(content, text=alerta.mensaje,
                font=FONTS['body'], bg=content['bg'],
                fg=COLORS['text_secondary'],
                wraplength=700, justify='left').pack(anchor='w', pady=5)
        
        # Botones de acción
        acciones = tk.Frame(content, bg=content['bg'])
        acciones.pack(fill='x', pady=(5, 0))
        
        if not alerta.leida:
            tk.Button(acciones, text="[OK] Marcar como leída",
                     font=FONTS['small'], bg=COLORS['success'], fg='white',
                     cursor='hand2', relief='flat', padx=10, pady=3,
                     command=lambda: self.marcar_leida(alerta.id)).pack(side='left', padx=2)
        
        # Prioridad badge
        tk.Label(acciones, text=f"Prioridad: {alerta.prioridad}",
                font=FONTS['small'], bg=color, fg='white',
                padx=8, pady=2).pack(side='right')
    
    def marcar_leida(self, alerta_id):
        """Marca una alerta como leída"""
        exito = self.alertas_service.marcar_leida(alerta_id)
        if exito:
            self.cargar_alertas()
    
    def marcar_todas_leidas(self):
        """Marca todas las alertas como leídas"""
        respuesta = messagebox.askyesno(
            "Confirmar",
            "¿Desea marcar todas las alertas como leídas?"
        )
        
        if respuesta:
            exito = self.alertas_service.marcar_todas_leidas()
            if exito:
                messagebox.showinfo("Éxito", "Todas las alertas fueron marcadas como leídas")
                self.cargar_alertas()


class VentanaAlertasPopup:
    """Ventana emergente para mostrar alertas importantes"""
    
    def __init__(self, parent, alertas_service):
        self.alertas_service = alertas_service
        
        # Obtener alertas críticas no leídas
        alertas = alertas_service.obtener_alertas(solo_no_leidas=True)
        alertas_criticas = [a for a in alertas if a.prioridad in ['CRITICA', 'ALTA']]
        
        if not alertas_criticas:
            return
        
        self.window = tk.Toplevel(parent)
        self.window.title("[AVISO] Alertas Importantes")
        self.window.geometry("500x400")
        self.window.transient(parent)
        
        # Centrar ventana
        self.window.update_idletasks()
        x = (self.window.winfo_screenwidth() // 2) - (250)
        y = (self.window.winfo_screenheight() // 2) - (200)
        self.window.geometry(f"500x400+{x}+{y}")
        
        self.crear_interfaz(alertas_criticas)
    
    def crear_interfaz(self, alertas):
        """Crea la interfaz del popup"""
        # Header
        header = tk.Frame(self.window, bg=COLORS['danger'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        
        tk.Label(header, text="[AVISO] Alertas Importantes",
                font=FONTS['large'], bg=COLORS['danger'],
                fg='white').pack(pady=15)
        
        # Contenido
        content = tk.Frame(self.window, bg='white')
        content.pack(fill='both', expand=True, padx=20, pady=20)
        
        tk.Label(content, 
                text=f"Tiene {len(alertas)} alerta(s) que requieren atención:",
                font=FONTS['body'], bg='white',
                fg=COLORS['text_primary']).pack(anchor='w', pady=(0, 10))
        
        # Lista de alertas
        lista_frame = tk.Frame(content, bg='white')
        lista_frame.pack(fill='both', expand=True)
        
        scroll = ttk.Scrollbar(lista_frame, orient='vertical')
        scroll.pack(side='right', fill='y')
        
        text = tk.Text(lista_frame, font=FONTS['body'], wrap='word',
                      yscrollcommand=scroll.set, bg='#fff8f8',
                      relief='flat', padx=10, pady=10)
        text.pack(fill='both', expand=True)
        
        scroll.config(command=text.yview)
        
        # Agregar alertas
        for i, alerta in enumerate(alertas, 1):
            text.insert('end', f"{i}. ", 'numero')
            text.insert('end', f"{alerta.titulo}\n", 'titulo')
            text.insert('end', f"   {alerta.mensaje}\n\n", 'mensaje')
        
        text.tag_config('numero', font=FONTS['body_bold'], foreground=COLORS['danger'])
        text.tag_config('titulo', font=FONTS['body_bold'], foreground=COLORS['text_primary'])
        text.tag_config('mensaje', foreground=COLORS['text_secondary'])
        
        text.config(state='disabled')
        
        # Botones
        btn_frame = tk.Frame(self.window, bg='white')
        btn_frame.pack(fill='x', padx=20, pady=20)
        
        tk.Button(btn_frame, text="Entendido",
                 font=FONTS['body_bold'], bg=COLORS['primary'], fg='white',
                 cursor='hand2', relief='flat', padx=30, pady=10,
                 command=self.window.destroy).pack(side='right', padx=5)
        
        tk.Button(btn_frame, text="Marcar como leídas",
                 font=FONTS['body'], bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat', padx=20, pady=10,
                 command=lambda: self.marcar_y_cerrar(alertas)).pack(side='right', padx=5)
    
    def marcar_y_cerrar(self, alertas):
        """Marca las alertas como leídas y cierra la ventana"""
        for alerta in alertas:
            self.alertas_service.marcar_como_leida(alerta.id)
        messagebox.showinfo("Éxito", "Alertas marcadas como leídas")
        self.window.destroy()