# -*- coding: utf-8 -*-
"""
Diálogo para buscar y seleccionar productos
"""
import tkinter as tk
from tkinter import ttk
from ui_config import COLORS, FONTS

class BuscarProductoDialog:
    """Diálogo de búsqueda de productos"""
    
    def __init__(self, parent, productos_repo):
        self.parent = parent
        self.productos_repo = productos_repo
        self.producto_seleccionado = None
        
        self.crear_ventana()
        self.cargar_productos()
    
    def crear_ventana(self):
        """Crea la ventana de búsqueda"""
        self.ventana = tk.Toplevel(self.parent)
        self.ventana.title("Buscar Producto")
        self.ventana.geometry("800x500")
        self.ventana.resizable(False, False)
        self.ventana.configure(bg='white')
        self.ventana.transient(self.parent)
        self.ventana.grab_set()
        
        # Centrar ventana
        self.ventana.update_idletasks()
        x = (self.ventana.winfo_screenwidth() // 2) - 400
        y = (self.ventana.winfo_screenheight() // 2) - 250
        self.ventana.geometry(f'800x500+{x}+{y}')
        
        # Header
        header = tk.Frame(self.ventana, bg=COLORS['primary'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        
        tk.Label(header, text="🔍 Buscar Producto",
                font=FONTS['large'],
                bg=COLORS['primary'], fg='white').pack(expand=True)
        
        # Búsqueda
        search_frame = tk.Frame(self.ventana, bg='white', padx=20, pady=15)
        search_frame.pack(fill='x')
        
        tk.Label(search_frame, text="Buscar:",
                font=FONTS['body'], bg='white').pack(side='left', padx=(0,10))
        
        self.search_var = tk.StringVar()
        self.search_var.trace('w', lambda *args: self.cargar_productos())
        
        search_entry = ttk.Entry(search_frame, textvariable=self.search_var,
                                font=FONTS['body'], width=50)
        search_entry.pack(side='left', fill='x', expand=True)
        search_entry.focus()
        
        # Tabla
        table_frame = tk.Frame(self.ventana, bg='white', padx=20)
        table_frame.pack(fill='both', expand=True)
        
        scroll_y = ttk.Scrollbar(table_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')
        
        columnas = ('ID', 'Nombre', 'Categoría', 'Marca', 'Stock', 'Precio Venta')
        
        self.tree = ttk.Treeview(table_frame,
                                columns=columnas,
                                show='headings',
                                yscrollcommand=scroll_y.set)
        
        scroll_y.config(command=self.tree.yview)
        
        # Configurar columnas
        anchos = {'ID': 50, 'Nombre': 250, 'Categoría': 120, 
                 'Marca': 120, 'Stock': 80, 'Precio Venta': 100}
        
        for col in columnas:
            self.tree.heading(col, text=col)
            self.tree.column(col, width=anchos.get(col, 100), anchor='center')
        
        self.tree.pack(fill='both', expand=True)
        
        # Doble clic para seleccionar
        self.tree.bind('<Double-Button-1>', lambda e: self.seleccionar_producto())
        
        # Botones
        btn_frame = tk.Frame(self.ventana, bg='white', padx=20, pady=15)
        btn_frame.pack(fill='x')
        
        tk.Button(btn_frame, text="[OK] Seleccionar",
                 font=FONTS['body_bold'],
                 bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.seleccionar_producto).pack(side='left', padx=5, ipadx=20, ipady=8)
        
        tk.Button(btn_frame, text="[ERROR] Cancelar",
                 font=FONTS['body'],
                 bg=COLORS['secondary'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.ventana.destroy).pack(side='left', padx=5, ipadx=20, ipady=8)
    
    def cargar_productos(self):
        """Carga los productos en la tabla"""
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        try:
            termino = self.search_var.get().strip()
            productos = self.productos_repo.buscar_productos(termino)
            
            for p in productos:
                self.tree.insert('', 'end', values=(
                    p['id'],
                    p['nombre'],
                    p['categoria'] or 'Sin categoría',
                    p['marca'] or 'Sin marca',
                    p['stock'],
                    f"${p['precio_venta']:,.0f}"
                ))
        except Exception as e:
            print(f"Error cargando productos: {e}")
    
    def seleccionar_producto(self):
        """Selecciona el producto y cierra la ventana"""
        seleccion = self.tree.selection()
        if not seleccion:
            return
        
        item = self.tree.item(seleccion[0])
        producto_id = item['values'][0]
        
        # Obtener el producto completo
        producto = self.productos_repo.obtener_por_id(producto_id)
        if producto:
            self.producto_seleccionado = producto
            self.ventana.destroy()