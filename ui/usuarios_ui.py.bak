# -*- coding: utf-8 -*-
"""
Interfaz de Gestión de Usuarios
"""
import tkinter as tk
from tkinter import ttk, messagebox
from typing import Optional
from models import Usuario, RolUsuario
from ui_config import COLORS, FONTS


class UsuariosUI:
    """Interfaz para gestionar usuarios"""
    
    def __init__(self, parent, auth):
        self.parent = parent
        self.auth = auth
        
        self.crear_interfaz()
        self.cargar_usuarios()
    
    def crear_interfaz(self):
        """Crea la interfaz de usuarios"""
        # Header
        header = tk.Frame(self.parent, bg=COLORS['bg_secondary'])
        header.pack(fill='x', padx=20, pady=10)
        
        tk.Label(header, text="👤 Gestión de Usuarios",
                font=FONTS['large'],
                bg=COLORS['bg_secondary'],
                fg=COLORS['text_primary']).pack(side='left')
        
        # Botones de acción
        btn_frame = tk.Frame(header, bg=COLORS['bg_secondary'])
        btn_frame.pack(side='right')
        
        tk.Button(btn_frame, text="➕ Nuevo Usuario",
                 font=FONTS['body'],
                 bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.nuevo_usuario).pack(side='left', padx=5)
        
        tk.Button(btn_frame, text="✏️ Editar",
                 font=FONTS['body'],
                 bg=COLORS['primary'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.editar_usuario).pack(side='left', padx=5)
        
        tk.Button(btn_frame, text="🔑 Cambiar Contraseña",
                 font=FONTS['body'],
                 bg=COLORS['warning'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.cambiar_password).pack(side='left', padx=5)
        
        tk.Button(btn_frame, text="🔄 Actualizar",
                 font=FONTS['body'],
                 bg=COLORS['info'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.cargar_usuarios).pack(side='left', padx=5)
        
        # Tabla de usuarios
        table_frame = tk.Frame(self.parent, bg='white')
        table_frame.pack(fill='both', expand=True, padx=20, pady=10)
        
        # Scrollbars
        scroll_y = ttk.Scrollbar(table_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')
        
        scroll_x = ttk.Scrollbar(table_frame, orient='horizontal')
        scroll_x.pack(side='bottom', fill='x')
        
        # Treeview
        columns = ('ID', 'Usuario', 'Nombre', 'Rol', 'Email', 'Teléfono', 'Último Acceso', 'Estado')
        self.tree = ttk.Treeview(table_frame, columns=columns, show='headings',
                                yscrollcommand=scroll_y.set,
                                xscrollcommand=scroll_x.set)
        
        # Configurar columnas
        column_widths = {
            'ID': 50,
            'Usuario': 120,
            'Nombre': 200,
            'Rol': 120,
            'Email': 200,
            'Teléfono': 120,
            'Último Acceso': 150,
            'Estado': 80
        }
        
        for col in columns:
            self.tree.heading(col, text=col)
            self.tree.column(col, width=column_widths.get(col, 100))
        
        self.tree.pack(fill='both', expand=True)
        
        scroll_y.config(command=self.tree.yview)
        scroll_x.config(command=self.tree.xview)
        
        # Bind doble click
        self.tree.bind('<Double-1>', lambda e: self.editar_usuario())
    
    def cargar_usuarios(self):
        """Carga los usuarios en la tabla"""
        # Limpiar tabla
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        # Obtener usuarios
        usuarios = self.auth.listar_usuarios()
        
        for usuario in usuarios:
            estado = "Activo" if usuario.activo else "Inactivo"
            ultimo_acceso = usuario.ultimo_acceso if usuario.ultimo_acceso else "Nunca"
            
            self.tree.insert('', 'end', values=(
                usuario.id,
                usuario.username,
                usuario.nombre_completo,
                usuario.rol,
                usuario.email or '',
                usuario.telefono or '',
                ultimo_acceso,
                estado
            ))
    
    def nuevo_usuario(self):
        """Abre ventana para crear nuevo usuario"""
        if not self.auth.tiene_permiso('crear_usuario'):
            messagebox.showerror("Error", "No tiene permisos para crear usuarios")
            return
        
        VentanaUsuarioForm(self.parent, self.auth, None, self.cargar_usuarios)
    
    def editar_usuario(self):
        """Abre ventana para editar usuario seleccionado"""
        selection = self.tree.selection()
        if not selection:
            messagebox.showwarning("Advertencia", "Seleccione un usuario")
            return
        
        if not self.auth.tiene_permiso('gestionar_usuarios'):
            messagebox.showerror("Error", "No tiene permisos para editar usuarios")
            return
        
        # Obtener datos del usuario desde el tree
        item = self.tree.item(selection[0])
        valores = item['values']
        
        # Crear objeto usuario con los datos
        usuario = Usuario(
            id=valores[0],
            username=valores[1],
            nombre_completo=valores[2],
            rol=valores[3],
            email=valores[4] if valores[4] else None,
            telefono=valores[5] if valores[5] else None,
            activo=valores[7] == "Activo"
        )
        
        VentanaUsuarioForm(self.parent, self.auth, usuario, self.cargar_usuarios)
    
    def cambiar_password(self):
        """Cambia la contraseña de un usuario"""
        selection = self.tree.selection()
        if not selection:
            messagebox.showwarning("Advertencia", "Seleccione un usuario")
            return
        
        # Obtener ID del usuario
        item = self.tree.item(selection[0])
        usuario_id = item['values'][0]
        usuario_nombre = item['values'][2]
        
        VentanaCambiarPassword(self.parent, self.auth, usuario_id, usuario_nombre)


class VentanaUsuarioForm:
    """Ventana de formulario para crear/editar usuario"""
    
    def __init__(self, parent, auth, usuario: Optional[Usuario], callback):
        self.auth = auth
        self.usuario = usuario
        self.callback = callback
        
        self.ventana = tk.Toplevel(parent)
        self.ventana.title("Editar Usuario" if usuario else "Nuevo Usuario")
        self.ventana.geometry("500x600")
        self.ventana.configure(bg=COLORS['bg_primary'])
        self.ventana.transient(parent)
        self.ventana.grab_set()
        
        self.crear_formulario()
        
        if usuario:
            self.cargar_datos()
    
    def crear_formulario(self):
        """Crea el formulario"""
        # Header
        header = tk.Frame(self.ventana, bg=COLORS['primary'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        
        titulo = "Editar Usuario" if self.usuario else "Nuevo Usuario"
        tk.Label(header, text=titulo, font=FONTS['large'],
                bg=COLORS['primary'], fg='white').pack(pady=15)
        
        # Formulario
        form_frame = tk.Frame(self.ventana, bg=COLORS['bg_primary'])
        form_frame.pack(fill='both', expand=True, padx=30, pady=20)
        
        self.entries = {}
        
        # Usuario
        self.crear_campo(form_frame, 'username', 'Usuario:', True, 
                        readonly=bool(self.usuario))
        
        # Contraseña (solo para nuevo)
        if not self.usuario:
            self.crear_campo(form_frame, 'password', 'Contraseña:', True, show='●')
            self.crear_campo(form_frame, 'password2', 'Confirmar Contraseña:', True, show='●')
        
        # Nombre completo
        self.crear_campo(form_frame, 'nombre_completo', 'Nombre Completo:', True)
        
        # Rol
        frame = tk.Frame(form_frame, bg=COLORS['bg_primary'])
        frame.pack(fill='x', pady=5)
        
        tk.Label(frame, text="Rol: *", font=FONTS['body'],
                bg=COLORS['bg_primary'], fg=COLORS['text_secondary'],
                anchor='w').pack(fill='x')
        
        self.rol_var = tk.StringVar()
        roles = [rol.name for rol in RolUsuario]
        rol_combo = ttk.Combobox(frame, textvariable=self.rol_var,
                                values=roles, state='readonly',
                                font=FONTS['body'])
        rol_combo.pack(fill='x', pady=(5, 0))
        rol_combo.set(roles[0])
        self.entries['rol'] = rol_combo
        
        # Email
        self.crear_campo(form_frame, 'email', 'Email:', False)
        
        # Teléfono
        self.crear_campo(form_frame, 'telefono', 'Teléfono:', False)
        
        # Estado
        self.activo_var = tk.BooleanVar(value=True)
        tk.Checkbutton(form_frame, text="Usuario Activo",
                      variable=self.activo_var,
                      font=FONTS['body'],
                      bg=COLORS['bg_primary']).pack(anchor='w', pady=10)
        
        # Botones
        btn_frame = tk.Frame(self.ventana, bg=COLORS['bg_primary'])
        btn_frame.pack(fill='x', padx=30, pady=(0, 20))
        
        tk.Button(btn_frame, text="[GUARDAR] Guardar",
                 font=FONTS['body_bold'],
                 bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.guardar).pack(side='left', padx=5, fill='x', expand=True)
        
        tk.Button(btn_frame, text="[ERROR] Cancelar",
                 font=FONTS['body'],
                 bg=COLORS['danger'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.ventana.destroy).pack(side='left', padx=5, fill='x', expand=True)
    
    def crear_campo(self, parent, nombre, etiqueta, requerido, readonly=False, show=None):
        """Crea un campo del formulario"""
        frame = tk.Frame(parent, bg=COLORS['bg_primary'])
        frame.pack(fill='x', pady=5)
        
        label_text = etiqueta + (' *' if requerido else '')
        tk.Label(frame, text=label_text, font=FONTS['body'],
                bg=COLORS['bg_primary'], fg=COLORS['text_secondary'],
                anchor='w').pack(fill='x')
        
        entry = ttk.Entry(frame, font=FONTS['body'])
        if show:
            entry.config(show=show)
        if readonly:
            entry.config(state='readonly')
        
        entry.pack(fill='x', pady=(5, 0))
        self.entries[nombre] = entry
    
    def cargar_datos(self):
        """Carga los datos del usuario en el formulario"""
        if not self.usuario:
            return
        
        self.entries['username'].delete(0, 'end')
        self.entries['username'].insert(0, self.usuario.username)
        
        self.entries['nombre_completo'].delete(0, 'end')
        self.entries['nombre_completo'].insert(0, self.usuario.nombre_completo)
        
        self.rol_var.set(self.usuario.rol)
        
        if self.usuario.email:
            self.entries['email'].delete(0, 'end')
            self.entries['email'].insert(0, self.usuario.email)
        
        if self.usuario.telefono:
            self.entries['telefono'].delete(0, 'end')
            self.entries['telefono'].insert(0, self.usuario.telefono)
        
        self.activo_var.set(self.usuario.activo)
    
    def guardar(self):
        """Guarda el usuario"""
        # Validar campos requeridos
        username = self.entries['username'].get().strip()
        nombre_completo = self.entries['nombre_completo'].get().strip()
        rol = self.rol_var.get()
        
        if not username or not nombre_completo or not rol:
            messagebox.showerror("Error", "Complete todos los campos obligatorios")
            return
        
        # Validar contraseñas para nuevo usuario
        if not self.usuario:
            password = self.entries['password'].get()
            password2 = self.entries['password2'].get()
            
            if not password or not password2:
                messagebox.showerror("Error", "Complete las contraseñas")
                return
            
            if password != password2:
                messagebox.showerror("Error", "Las contraseñas no coinciden")
                return
            
            if len(password) < 6:
                messagebox.showerror("Error", "La contraseña debe tener al menos 6 caracteres")
                return
        
        email = self.entries['email'].get().strip() or None
        telefono = self.entries['telefono'].get().strip() or None
        
        # Crear o actualizar usuario
        if self.usuario:
            # Actualizar (no hay método directo, usar SQL)
            conn = self.auth.db.conectar()
            cursor = conn.cursor()
            
            try:
                cursor.execute('''
                    UPDATE usuarios
                    SET nombre_completo = ?, rol = ?, email = ?, telefono = ?, activo = ?
                    WHERE id = ?
                ''', (nombre_completo, rol, email, telefono, 
                     1 if self.activo_var.get() else 0, self.usuario.id))
                
                conn.commit()
                conn.close()
                
                messagebox.showinfo("Éxito", "Usuario actualizado exitosamente")
                self.callback()
                self.ventana.destroy()
            except Exception as e:
                conn.close()
                messagebox.showerror("Error", f"Error al actualizar: {str(e)}")
        else:
            # Crear nuevo
            password = self.entries['password'].get()
            exito, mensaje = self.auth.crear_usuario(
                username, password, nombre_completo, rol, email, telefono
            )
            
            if exito:
                messagebox.showinfo("Éxito", mensaje)
                self.callback()
                self.ventana.destroy()
            else:
                messagebox.showerror("Error", mensaje)


class VentanaCambiarPassword:
    """Ventana para cambiar contraseña"""
    
    def __init__(self, parent, auth, usuario_id, usuario_nombre):
        self.auth = auth
        self.usuario_id = usuario_id
        
        self.ventana = tk.Toplevel(parent)
        self.ventana.title("Cambiar Contraseña")
        self.ventana.geometry("400x300")
        self.ventana.configure(bg=COLORS['bg_primary'])
        self.ventana.transient(parent)
        self.ventana.grab_set()
        
        # Header
        header = tk.Frame(self.ventana, bg=COLORS['primary'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        
        tk.Label(header, text="🔑 Cambiar Contraseña", font=FONTS['large'],
                bg=COLORS['primary'], fg='white').pack(pady=15)
        
        # Form
        form_frame = tk.Frame(self.ventana, bg=COLORS['bg_primary'])
        form_frame.pack(fill='both', expand=True, padx=30, pady=20)
        
        tk.Label(form_frame, text=f"Usuario: {usuario_nombre}",
                font=FONTS['body_bold'],
                bg=COLORS['bg_primary'],
                fg=COLORS['text_primary']).pack(pady=10)
        
        # Nueva contraseña
        tk.Label(form_frame, text="Nueva Contraseña:",
                font=FONTS['body'],
                bg=COLORS['bg_primary'],
                fg=COLORS['text_secondary']).pack(anchor='w', pady=(10, 5))
        
        self.password_entry = ttk.Entry(form_frame, font=FONTS['body'], show='●')
        self.password_entry.pack(fill='x')
        
        # Confirmar contraseña
        tk.Label(form_frame, text="Confirmar Contraseña:",
                font=FONTS['body'],
                bg=COLORS['bg_primary'],
                fg=COLORS['text_secondary']).pack(anchor='w', pady=(10, 5))
        
        self.password2_entry = ttk.Entry(form_frame, font=FONTS['body'], show='●')
        self.password2_entry.pack(fill='x')
        
        # Botones
        btn_frame = tk.Frame(self.ventana, bg=COLORS['bg_primary'])
        btn_frame.pack(fill='x', padx=30, pady=(0, 20))
        
        tk.Button(btn_frame, text="[GUARDAR] Cambiar",
                 font=FONTS['body_bold'],
                 bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.cambiar).pack(side='left', padx=5, fill='x', expand=True)
        
        tk.Button(btn_frame, text="[ERROR] Cancelar",
                 font=FONTS['body'],
                 bg=COLORS['danger'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.ventana.destroy).pack(side='left', padx=5, fill='x', expand=True)
    
    def cambiar(self):
        """Cambia la contraseña"""
        password = self.password_entry.get()
        password2 = self.password2_entry.get()
        
        if not password or not password2:
            messagebox.showerror("Error", "Complete ambos campos")
            return
        
        if password != password2:
            messagebox.showerror("Error", "Las contraseñas no coinciden")
            return
        
        if len(password) < 6:
            messagebox.showerror("Error", "La contraseña debe tener al menos 6 caracteres")
            return
        
        exito, mensaje = self.auth.cambiar_password(self.usuario_id, password)
        
        if exito:
            messagebox.showinfo("Éxito", mensaje)
            self.ventana.destroy()
        else:
            messagebox.showerror("Error", mensaje)