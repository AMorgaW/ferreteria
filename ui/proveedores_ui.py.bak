# -*- coding: utf-8 -*-
"""
Interfaz de usuario para gestión de proveedores
"""
import tkinter as tk
from tkinter import ttk, messagebox
from models import Proveedor
from ui_config import COLORS, FONTS


class ProveedoresUI:
    """Interfaz para gestión de proveedores"""
    
    def __init__(self, parent, proveedores_repo, auth_manager):
        self.parent = parent
        self.repo = proveedores_repo
        self.auth = auth_manager
        self.proveedor_seleccionado = None
        
        self.crear_ui()
        self.cargar_proveedores()
    
    def crear_ui(self):
        """Crea la interfaz de usuario"""
        # Header
        header = tk.Frame(self.parent, bg=COLORS['bg_secondary'])
        header.pack(fill='x', padx=20, pady=20)
        
        tk.Label(header, text="🏪 Gestión de Proveedores",
                font=FONTS['large'], bg=COLORS['bg_secondary'],
                fg=COLORS['text_primary']).pack(side='left')
        
        # Botones de acción
        btn_frame = tk.Frame(header, bg=COLORS['bg_secondary'])
        btn_frame.pack(side='right')
        
        tk.Button(btn_frame, text="➕ Nuevo Proveedor",
                 font=FONTS['body_bold'], bg=COLORS['primary'],
                 fg='white', cursor='hand2', relief='flat',
                 command=self.nuevo_proveedor).pack(side='left', padx=5)
        
        tk.Button(btn_frame, text="✏️ Editar",
                 font=FONTS['body_bold'], bg=COLORS['info'],
                 fg='white', cursor='hand2', relief='flat',
                 command=self.editar_proveedor).pack(side='left', padx=5)
        
        tk.Button(btn_frame, text="🗑️ Eliminar",
                 font=FONTS['body_bold'], bg=COLORS['danger'],
                 fg='white', cursor='hand2', relief='flat',
                 command=self.eliminar_proveedor).pack(side='left', padx=5)
        
        tk.Button(btn_frame, text="🔄 Actualizar",
                 font=FONTS['body'], bg=COLORS['secondary'],
                 fg='white', cursor='hand2', relief='flat',
                 command=self.cargar_proveedores).pack(side='left', padx=5)
        
        # Búsqueda
        search_frame = tk.Frame(self.parent, bg=COLORS['bg_secondary'])
        search_frame.pack(fill='x', padx=20, pady=(0, 10))
        
        tk.Label(search_frame, text="🔍 Buscar:",
                font=FONTS['body'], bg=COLORS['bg_secondary']).pack(side='left', padx=5)
        
        self.search_var = tk.StringVar()
        self.search_var.trace('w', lambda *args: self.buscar_proveedores())
        
        search_entry = ttk.Entry(search_frame, textvariable=self.search_var,
                                font=FONTS['body'], width=40)
        search_entry.pack(side='left', padx=5)
        
        # Tabla
        table_frame = tk.Frame(self.parent, bg='white')
        table_frame.pack(fill='both', expand=True, padx=20, pady=10)
        
        # Scrollbars
        scroll_y = ttk.Scrollbar(table_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')
        
        scroll_x = ttk.Scrollbar(table_frame, orient='horizontal')
        scroll_x.pack(side='bottom', fill='x')
        
        # Treeview
        columns = ('ID', 'NIT', 'Nombre', 'Teléfono', 'Ciudad', 'Contacto', 
                   'Productos', 'Calificación', 'Días Crédito', 'Estado')
        
        self.tree = ttk.Treeview(table_frame, columns=columns, show='headings',
                                yscrollcommand=scroll_y.set,
                                xscrollcommand=scroll_x.set)
        
        scroll_y.config(command=self.tree.yview)
        scroll_x.config(command=self.tree.xview)
        
        # Configurar columnas
        widths = [50, 100, 200, 100, 100, 150, 150, 80, 80, 80]
        for col, width in zip(columns, widths):
            self.tree.heading(col, text=col)
            self.tree.column(col, width=width, anchor='center')
        
        self.tree.pack(fill='both', expand=True)
        
        # Bind doble clic
        self.tree.bind('<Double-1>', lambda e: self.editar_proveedor())
    
    def cargar_proveedores(self):
        """Carga proveedores en la tabla"""
        # Limpiar tabla
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        try:
            # [OK] CORREGIDO: Ahora recibe objetos Proveedor
            proveedores = self.repo.listar_proveedores(solo_activos=False)
            
            for proveedor in proveedores:
                # [OK] CORREGIDO: Acceder a atributos del objeto en lugar de diccionario
                estado = "[OK] Activo" if proveedor.activo else "[ERROR] Inactivo"
                calificacion = "⭐" * int(proveedor.calificacion)
                
                self.tree.insert('', 'end', values=(
                    proveedor.id,
                    proveedor.nit or 'N/A',
                    proveedor.nombre,
                    proveedor.telefono or 'N/A',
                    proveedor.ciudad or 'N/A',
                    proveedor.contacto_nombre or 'N/A',
                    proveedor.productos_provee or 'N/A',
                    calificacion,
                    proveedor.dias_credito,
                    estado
                ))
        except Exception as e:
            messagebox.showerror("Error", f"Error al cargar proveedores:\n{str(e)}")
    
    def buscar_proveedores(self):
        """Busca proveedores según criterio"""
        criterio = self.search_var.get().strip()
        
        # Limpiar tabla
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        try:
            # [OK] CORREGIDO: Usar método correcto
            if criterio:
                proveedores = self.repo.buscar_proveedores(criterio, solo_activos=False)
            else:
                proveedores = self.repo.listar_proveedores(solo_activos=False)
            
            for proveedor in proveedores:
                # [OK] CORREGIDO: Acceder a atributos del objeto
                estado = "[OK] Activo" if proveedor.activo else "[ERROR] Inactivo"
                calificacion = "⭐" * int(proveedor.calificacion)
                
                self.tree.insert('', 'end', values=(
                    proveedor.id,
                    proveedor.nit or 'N/A',
                    proveedor.nombre,
                    proveedor.telefono or 'N/A',
                    proveedor.ciudad or 'N/A',
                    proveedor.contacto_nombre or 'N/A',
                    proveedor.productos_provee or 'N/A',
                    calificacion,
                    proveedor.dias_credito,
                    estado
                ))
        except Exception as e:
            messagebox.showerror("Error", f"Error al buscar:\n{str(e)}")
    
    def nuevo_proveedor(self):
        """Abre ventana para crear nuevo proveedor"""
        FormularioProveedorWindow(self.parent, self.repo, self.auth, 
                                 callback=self.cargar_proveedores)
    
    def editar_proveedor(self):
        """Abre ventana para editar proveedor seleccionado"""
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Advertencia", "Seleccione un proveedor")
            return
        
        proveedor_id = self.tree.item(selected[0])['values'][0]
        
        # [OK] CORREGIDO: obtener_por_id retorna objeto Proveedor
        proveedor = self.repo.obtener_por_id(proveedor_id)
        
        if proveedor:
            FormularioProveedorWindow(self.parent, self.repo, self.auth,
                                     proveedor=proveedor,
                                     callback=self.cargar_proveedores)
    
    def eliminar_proveedor(self):
        """Elimina (desactiva) el proveedor seleccionado"""
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Advertencia", "Seleccione un proveedor")
            return
        
        proveedor_id = self.tree.item(selected[0])['values'][0]
        nombre = self.tree.item(selected[0])['values'][2]
        
        respuesta = messagebox.askyesno(
            "Confirmar Eliminación",
            f"¿Está seguro de eliminar al proveedor:\n{nombre}?\n\n"
            "El proveedor se marcará como inactivo."
        )
        
        if respuesta:
            exito, mensaje = self.repo.eliminar_proveedor(proveedor_id)
            if exito:
                messagebox.showinfo("Éxito", mensaje)
                self.cargar_proveedores()
            else:
                messagebox.showerror("Error", mensaje)


class FormularioProveedorWindow:
    """Ventana de formulario para crear/editar proveedores"""
    
    def __init__(self, parent, repo, auth, proveedor=None, callback=None):
        self.repo = repo
        self.auth = auth
        self.proveedor = proveedor
        self.callback = callback
        
        self.window = tk.Toplevel(parent)
        self.window.title("Nuevo Proveedor" if not proveedor else "Editar Proveedor")
        self.window.geometry("600x750")
        self.window.configure(bg=COLORS['bg_secondary'])
        self.window.transient(parent)
        self.window.grab_set()
        
        # Centrar ventana
        self.centrar_ventana()
        
        self.crear_formulario()
        
        if proveedor:
            self.cargar_datos()
    
    def centrar_ventana(self):
        """Centra la ventana en la pantalla"""
        self.window.update_idletasks()
        width = self.window.winfo_width()
        height = self.window.winfo_height()
        x = (self.window.winfo_screenwidth() // 2) - (width // 2)
        y = (self.window.winfo_screenheight() // 2) - (height // 2)
        self.window.geometry(f'{width}x{height}+{x}+{y}')
    
    def crear_formulario(self):
        """Crea el formulario"""
        # Header
        header = tk.Frame(self.window, bg=COLORS['primary'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        
        titulo = "✏️ Editar Proveedor" if self.proveedor else "➕ Nuevo Proveedor"
        tk.Label(header, text=titulo, font=FONTS['large'],
                bg=COLORS['primary'], fg='white').pack(pady=15)
        
        # Contenedor con scroll
        canvas = tk.Canvas(self.window, bg=COLORS['bg_secondary'])
        scrollbar = ttk.Scrollbar(self.window, orient="vertical", command=canvas.yview)
        scrollable_frame = tk.Frame(canvas, bg=COLORS['bg_secondary'])
        
        scrollable_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        
        canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
        
        # Form
        form = tk.Frame(scrollable_frame, bg=COLORS['bg_secondary'])
        form.pack(fill='both', expand=True, padx=30, pady=20)
        
        # Campos
        campos = [
            ("NIT:", "nit_entry"),
            ("Nombre Comercial: *", "nombre_entry"),
            ("Teléfono:", "telefono_entry"),
            ("Correo Electrónico:", "correo_entry"),
            ("Dirección:", "direccion_entry"),
            ("Ciudad:", "ciudad_entry"),
            ("Nombre Contacto:", "contacto_nombre_entry"),
            ("Teléfono Contacto:", "contacto_telefono_entry"),
            ("Productos que Provee:", "productos_entry"),
        ]
        
        self.entries = {}
        
        for i, (label, var_name) in enumerate(campos):
            tk.Label(form, text=label, font=FONTS['body'],
                    bg=COLORS['bg_secondary'], fg=COLORS['text_secondary'],
                    anchor='w').grid(row=i, column=0, sticky='w', pady=5)
            
            entry = ttk.Entry(form, font=FONTS['body'], width=40)
            entry.grid(row=i, column=1, sticky='ew', pady=5, padx=(10, 0))
            self.entries[var_name] = entry
        
        # Configurar grid
        form.columnconfigure(1, weight=1)
        
        # Calificación
        tk.Label(form, text="Calificación (1-5):", font=FONTS['body'],
                bg=COLORS['bg_secondary'], fg=COLORS['text_secondary'],
                anchor='w').grid(row=len(campos), column=0, sticky='w', pady=5)
        
        self.calificacion_var = tk.DoubleVar(value=3.0)
        calificacion_frame = tk.Frame(form, bg=COLORS['bg_secondary'])
        calificacion_frame.grid(row=len(campos), column=1, sticky='w', pady=5, padx=(10, 0))
        
        ttk.Scale(calificacion_frame, from_=1, to=5, orient='horizontal',
                 variable=self.calificacion_var, length=200).pack(side='left')
        
        self.calificacion_label = tk.Label(calificacion_frame, text="3.0",
                                          font=FONTS['body'],
                                          bg=COLORS['bg_secondary'])
        self.calificacion_label.pack(side='left', padx=10)
        
        self.calificacion_var.trace('w', self.actualizar_calificacion)
        
        # Días de crédito
        tk.Label(form, text="Días de Crédito:", font=FONTS['body'],
                bg=COLORS['bg_secondary'], fg=COLORS['text_secondary'],
                anchor='w').grid(row=len(campos)+1, column=0, sticky='w', pady=5)
        
        self.dias_credito_var = tk.IntVar(value=0)
        ttk.Spinbox(form, from_=0, to=180, textvariable=self.dias_credito_var,
                   font=FONTS['body'], width=38).grid(row=len(campos)+1, column=1,
                                                      sticky='w', pady=5, padx=(10, 0))
        
        # Estado
        tk.Label(form, text="Estado:", font=FONTS['body'],
                bg=COLORS['bg_secondary'], fg=COLORS['text_secondary'],
                anchor='w').grid(row=len(campos)+2, column=0, sticky='w', pady=5)
        
        self.activo_var = tk.BooleanVar(value=True)
        ttk.Checkbutton(form, text="Proveedor Activo",
                       variable=self.activo_var).grid(row=len(campos)+2, column=1,
                                                      sticky='w', pady=5, padx=(10, 0))
        
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        
        # Botones
        btn_frame = tk.Frame(self.window, bg=COLORS['bg_secondary'])
        btn_frame.pack(fill='x', padx=30, pady=20)
        
        tk.Button(btn_frame, text="[GUARDAR] Guardar",
                 font=FONTS['body_bold'], bg=COLORS['success'],
                 fg='white', cursor='hand2', relief='flat',
                 command=self.guardar).pack(side='left', padx=5, expand=True, fill='x')
        
        tk.Button(btn_frame, text="[ERROR] Cancelar",
                 font=FONTS['body_bold'], bg=COLORS['danger'],
                 fg='white', cursor='hand2', relief='flat',
                 command=self.window.destroy).pack(side='left', padx=5, expand=True, fill='x')
    
    def actualizar_calificacion(self, *args):
        """Actualiza el label de calificación"""
        valor = self.calificacion_var.get()
        self.calificacion_label.config(text=f"{valor:.1f}")
    
    def cargar_datos(self):
        """Carga datos del proveedor en el formulario"""
        if not self.proveedor:
            return
        
        # [OK] CORREGIDO: Acceder a atributos del objeto Proveedor
        self.entries['nit_entry'].insert(0, self.proveedor.nit or '')
        self.entries['nombre_entry'].insert(0, self.proveedor.nombre)
        self.entries['telefono_entry'].insert(0, self.proveedor.telefono or '')
        self.entries['correo_entry'].insert(0, self.proveedor.correo or '')
        self.entries['direccion_entry'].insert(0, self.proveedor.direccion or '')
        self.entries['ciudad_entry'].insert(0, self.proveedor.ciudad or '')
        self.entries['contacto_nombre_entry'].insert(0, self.proveedor.contacto_nombre or '')
        self.entries['contacto_telefono_entry'].insert(0, self.proveedor.contacto_telefono or '')
        self.entries['productos_entry'].insert(0, self.proveedor.productos_provee or '')
        
        self.calificacion_var.set(self.proveedor.calificacion)
        self.dias_credito_var.set(self.proveedor.dias_credito)
        self.activo_var.set(self.proveedor.activo)
    
    def guardar(self):
        """Guarda el proveedor"""
        # Validar
        nombre = self.entries['nombre_entry'].get().strip()
        
        if not nombre:
            messagebox.showwarning("Advertencia", "El nombre es obligatorio")
            return
        
        # Crear objeto
        proveedor = Proveedor(
            id=self.proveedor.id if self.proveedor else None,
            nit=self.entries['nit_entry'].get().strip() or None,
            nombre=nombre,
            telefono=self.entries['telefono_entry'].get().strip() or None,
            correo=self.entries['correo_entry'].get().strip() or None,
            direccion=self.entries['direccion_entry'].get().strip() or None,
            ciudad=self.entries['ciudad_entry'].get().strip() or None,
            contacto_nombre=self.entries['contacto_nombre_entry'].get().strip() or None,
            contacto_telefono=self.entries['contacto_telefono_entry'].get().strip() or None,
            productos_provee=self.entries['productos_entry'].get().strip() or None,
            calificacion=self.calificacion_var.get(),
            dias_credito=self.dias_credito_var.get(),
            activo=self.activo_var.get()
        )
        
        # Guardar
        if self.proveedor:
            exito, mensaje = self.repo.actualizar_proveedor(proveedor)
        else:
            exito, mensaje, _ = self.repo.crear_proveedor(proveedor)
        
        if exito:
            messagebox.showinfo("Éxito", mensaje)
            if self.callback:
                self.callback()
            self.window.destroy()
        else:
            messagebox.showerror("Error", mensaje)