# -*- coding: utf-8 -*-
"""
Diálogo para buscar y seleccionar proveedores
"""
import tkinter as tk
from tkinter import ttk
from ui_config import COLORS, FONTS

class BuscarProveedorDialog:
    """Diálogo de búsqueda de proveedores"""
    
    def __init__(self, parent, proveedores_repo):
        self.parent = parent
        self.proveedores_repo = proveedores_repo
        self.proveedor_seleccionado = None
        
        self.crear_ventana()
        self.cargar_proveedores()
    
    def crear_ventana(self):
        """Crea la ventana de búsqueda"""
        self.ventana = tk.Toplevel(self.parent)
        self.ventana.title("Buscar Proveedor")
        self.ventana.geometry("700x500")
        self.ventana.resizable(False, False)
        self.ventana.configure(bg='white')
        self.ventana.transient(self.parent)
        self.ventana.grab_set()
        
        # Centrar ventana
        self.ventana.update_idletasks()
        x = (self.ventana.winfo_screenwidth() // 2) - 350
        y = (self.ventana.winfo_screenheight() // 2) - 250
        self.ventana.geometry(f'700x500+{x}+{y}')
        
        # Header
        header = tk.Frame(self.ventana, bg=COLORS['info'], height=60)
        header.pack(fill='x')
        header.pack_propagate(False)
        
        tk.Label(header, text="🔍 Buscar Proveedor",
                font=FONTS['large'],
                bg=COLORS['info'], fg='white').pack(expand=True)
        
        # Búsqueda
        search_frame = tk.Frame(self.ventana, bg='white', padx=20, pady=15)
        search_frame.pack(fill='x')
        
        tk.Label(search_frame, text="Buscar:",
                font=FONTS['body'], bg='white').pack(side='left', padx=(0,10))
        
        self.search_var = tk.StringVar()
        self.search_var.trace('w', lambda *args: self.cargar_proveedores())
        
        search_entry = ttk.Entry(search_frame, textvariable=self.search_var,
                                font=FONTS['body'], width=50)
        search_entry.pack(side='left', fill='x', expand=True)
        search_entry.focus()
        
        # Tabla
        table_frame = tk.Frame(self.ventana, bg='white', padx=20)
        table_frame.pack(fill='both', expand=True)
        
        scroll_y = ttk.Scrollbar(table_frame, orient='vertical')
        scroll_y.pack(side='right', fill='y')
        
        columnas = ('ID', 'Nombre', 'Teléfono', 'Email', 'Ciudad')
        
        self.tree = ttk.Treeview(table_frame,
                                columns=columnas,
                                show='headings',
                                yscrollcommand=scroll_y.set)
        
        scroll_y.config(command=self.tree.yview)
        
        # Configurar columnas
        anchos = {'ID': 50, 'Nombre': 200, 'Teléfono': 120, 
                 'Email': 180, 'Ciudad': 120}
        
        for col in columnas:
            self.tree.heading(col, text=col)
            self.tree.column(col, width=anchos.get(col, 100), anchor='center')
        
        self.tree.pack(fill='both', expand=True)
        
        # Doble clic para seleccionar
        self.tree.bind('<Double-Button-1>', lambda e: self.seleccionar_proveedor())
        
        # Botones
        btn_frame = tk.Frame(self.ventana, bg='white', padx=20, pady=15)
        btn_frame.pack(fill='x')
        
        tk.Button(btn_frame, text="[OK] Seleccionar",
                 font=FONTS['body_bold'],
                 bg=COLORS['success'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.seleccionar_proveedor).pack(side='left', padx=5, ipadx=20, ipady=8)
        
        tk.Button(btn_frame, text="[ERROR] Cancelar",
                 font=FONTS['body'],
                 bg=COLORS['secondary'], fg='white',
                 cursor='hand2', relief='flat',
                 command=self.ventana.destroy).pack(side='left', padx=5, ipadx=20, ipady=8)
    
    def cargar_proveedores(self):
        """Carga los proveedores en la tabla"""
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        try:
            termino = self.search_var.get().strip()
            proveedores = self.proveedores_repo.listar_proveedores(solo_activos=True)
            
            # Filtrar por término de búsqueda
            if termino:
                proveedores = [p for p in proveedores 
                             if termino.lower() in p.nombre.lower() 
                             or (p.correo and termino.lower() in p.correo.lower())]
            
            for p in proveedores:
                self.tree.insert('', 'end', values=(
                    p.id,
                    p.nombre,
                    p.telefono or '',
                    p.correo or '',
                    p.ciudad or ''
                ))
        except Exception as e:
            print(f"Error cargando proveedores: {e}")
            import traceback
            traceback.print_exc()
    
    def seleccionar_proveedor(self):
        """Selecciona el proveedor y cierra la ventana"""
        seleccion = self.tree.selection()
        if not seleccion:
            return
        
        item = self.tree.item(seleccion[0])
        proveedor_id = item['values'][0]
        
        # Obtener el proveedor completo
        proveedores = self.proveedores_repo.listar_proveedores(solo_activos=True)
        proveedor = next((p for p in proveedores if p.id == proveedor_id), None)
        
        if proveedor:
            # Convertir a diccionario para compatibilidad con el resto del código
            self.proveedor_seleccionado = {
                'id': proveedor.id,
                'nombre': proveedor.nombre,
                'nit': proveedor.nit,
                'telefono': proveedor.telefono,
                'correo': proveedor.correo,
                'direccion': proveedor.direccion,
                'ciudad': proveedor.ciudad,
                'contacto_nombre': proveedor.contacto_nombre,
                'contacto_telefono': proveedor.contacto_telefono,
                'productos_provee': proveedor.productos_provee,
                'calificacion': proveedor.calificacion,
                'dias_credito': proveedor.dias_credito,
                'activo': proveedor.activo
            }
            self.ventana.destroy()