{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Local Server (API)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["local_server.py", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "Admin App",
      "runtimeExecutable": "python",
      "runtimeArgs": ["main.py"],
      "port": 8000
    },
    {
      "name": "Client App",
      "runtimeExecutable": "python",
      "runtimeArgs": ["client_app.py"],
      "port": 8000
    }
  ]
}
